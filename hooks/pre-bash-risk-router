#!/usr/bin/env bash
# pre-bash-risk-router — the FAST PreToolUse router for every Bash tool call (preflight P0 fix).
#
# WHY THIS EXISTS (the P0 incident it closes): the monolithic pre-push-gate-check ran its heavyweight
# body (dozens of git/jq/grep spawns) — and a self-watchdog around it — for EVERY Bash command, because
# it was the registered Bash hook. On Windows/Git-Bash the per-spawn scan-on-exec tax made an ORDINARY
# command's run exceed the 8–9s watchdog deadline, so the gate returned exit 2 (block) for EVERY Bash
# command, disabling autonomous coding. This router fixes that by being the only thing on the ordinary
# fast path: it does ZERO external process spawns, decides risk with bash builtins alone, and ALLOWS the
# overwhelming majority of commands instantly. It invokes the heavy engine ONLY for candidate-risk
# commands. A push-engine problem can therefore never disable unrelated Bash.
#
# CONTRACT (PreToolUse): stdin = the tool JSON {"tool_name":"Bash","tool_input":{"command":"..."}}.
#   exit 0          = allow the tool call (the fast-path verdict for ordinary commands).
#   exit 2          = block (only ever for a CANDIDATE that the engine blocked, or a candidate the engine
#                     could not adjudicate — never for an ordinary command).
#   The engine's stdout (a permissionDecision JSON for CONFIRM/allow tiers) is relayed verbatim.
#
# FAIL CONTAINMENT (the core guarantee):
#   ordinary cmd + engine healthy/missing/broken -> ALLOW (engine never invoked on the ordinary path)
#   candidate    + engine healthy                -> engine's decision (0 allow / 2 block / JSON ask)
#   candidate    + engine timeout/missing/abnormal-> BLOCK that candidate only (fail closed, scoped)
#   candidate    + malformed-with-risk-signal     -> engine (which fails closed)
#
# This file performs NO repository discovery, config resolution, evidence validation, heartbeat, manifest
# work, or git inspection. It is deliberately small enough for complete line-by-line review.

# ── Fast path: read stdin ONCE, preserve it byte-for-byte for the engine ──────────────────────────────
# `read -r -d ''` consumes the WHOLE stdin (NUL delimiter never appears in tool JSON) into BLOB without
# spawning anything. The trailing `|| true` keeps the non-zero EOF return from aborting us.
IFS= read -r -d '' BLOB || true

# ── Candidate-risk classification — CONSERVATIVE BUILTINS-ONLY STRUCTURAL RECOGNIZER (BLOCKER 3) ──────
# THE DEFECT this replaces: the old classifier matched the raw substrings `*push*` / `*gh*pr*create*` /
# `*.preflight/gate/*` on the JSON blob, so it routed PLAIN DATA into the ~13s heavy engine — `echo "push"`,
# `grep push file`, `ls docs/push-notes`, `printf '.preflight/gate/'`, a commit message containing the word
# "push", a filename containing "push". Each cost one engine invocation (~13s on this slow-spawn host) even
# though it could never be a governed op. That is friction the product must not impose on ordinary work.
#
# THE FIX: STRUCTURALLY recognize the actual governed SHAPES, with bash builtins only (ZERO external spawns —
# the fast-path latency SLO is unchanged). We (1) extract the command string from the tool JSON with pure
# parameter expansion, (2) segment it on the shell separators the router can see, and (3) for each segment,
# strip env-assignment / `command` prefixes and inspect the PROGRAM token + its argument STRUCTURE:
#   • a git program (git, */git, \git, git.exe) whose first non-global-option subcommand is `push`     → candidate
#   • `gh … pr … (create|merge)`                                                                       → candidate
#   • a script-wrapper exec — bash/sh/dash/zsh[.exe] with a script-path arg or `-c`, or `source`/`.` … → candidate
#   • an indirection program — `eval` / `xargs`                                                        → candidate
#   • a protected-sentinel WRITE — write-gate-evidence parity-clean, or a redirection / write-verb into a
#     parity-clean / bootstrap-write-approved path (read-shaped references stay on the fast path)       → candidate
# A plain-data occurrence of "push" / a gate path is NOT a command token in any of these positions, so it
# is NOT a candidate and stays on the zero-spawn fast path. Detection of REAL governed ops is NOT weakened:
# every spelling the engine parses (global options before push, env/`command`/path prefixes, LF/CRLF
# continuations, indirection) is recognized here, and an UNEXTRACTABLE/genuinely-ambiguous blob falls back
# to the conservative coarse net so a malformed-but-governed command still reaches the (fail-closed) engine.
CANDIDATE=0

# (1) Extract tool_input.command from the JSON blob with PURE PARAMETER EXPANSION (no jq/grep spawn). We
# take everything after the first `"command":"` (or `"command": "`) and strip from the LAST `"` (the closer)
# — last-quote (not first-quote) truncation can only drop TRAILING bytes, never an early governed token, so
# it can never turn a real `git push …` into a non-candidate (the fail-OPEN direction). _RTR_EXTRACTED=1
# when we found the marker; 0 means malformed/absent → coarse-net fallback below.
_RTR_CMD=""; _RTR_EXTRACTED=0
case "$BLOB" in
  *'"command":"'*)  _RTR_CMD="${BLOB#*'"command":"'}";  _RTR_CMD="${_RTR_CMD%\"*}";  _RTR_EXTRACTED=1 ;;
  *'"command": "'*) _RTR_CMD="${BLOB#*'"command": "'}"; _RTR_CMD="${_RTR_CMD%\"*}";  _RTR_EXTRACTED=1 ;;
esac

# (2) Structural recognizer over the extracted command. Builtins only. Sets CANDIDATE=1 on the first
# governed shape found.
_rtr_structural() {  # $1 = command string (raw, JSON-escaped — we operate ZERO-SPAWN, so no jq unescape)
  local cmd="$1" seg prog tok itp_prog
  # ── Minimal builtins-only JSON UNESCAPE (BLOCKER 3 robustness) ──────────────────────────────────────────
  # The router parses the RAW JSON string (it must spawn nothing, so it cannot use jq -r to unescape). On the
  # wire a backslash in the command is `\\`, a newline is `\n`, a tab `\t`, a quote `\"`. WITHOUT unescaping,
  # `\git push` (wire `\\git push`) and a `\`+LF shell continuation (wire `\\` + `\n`) word-split wrongly and
  # a real governed push went UNDETECTED (fail-OPEN). Unescape the common forms with the SENTINEL technique
  # (protect `\\` first so an escaped backslash before `n` is not mis-read as a newline). Imperfect unescape
  # can only OVER-route (the SAFE direction); it can never hide a governed op.
  local _sx=$'\x1c'                                  # an unlikely byte, never present in a shell command
  cmd="${cmd//\\\\/$_sx}"                              # \\  → SENTINEL (escaped backslash, protected)
  cmd="${cmd//\\n/$'\n'}"                              # \n  → newline
  cmd="${cmd//\\r/$'\r'}"                              # \r  → CR
  cmd="${cmd//\\t/$'\t'}"                              # \t  → tab
  cmd="${cmd//\\\"/\"}"                                # \"  → "
  cmd="${cmd//$_sx/\\}"                                # SENTINEL → single backslash
  # Join shell line-continuations (\+CRLF, \+LF) so a continuation-split `git … push` is seen as one segment.
  local _cr=$'\r' _lf=$'\n'
  cmd="${cmd//$'\\'"$_cr$_lf"/ }"
  cmd="${cmd//$'\\'"$_lf"/ }"
  # Sentinel WRITE detection (mirrors the engine's tripwire SHAPES — write-shaped only; reads stay fast).
  #   • write-gate-evidence + parity-clean  (the human-only evidence mint, any path form)
  #   • a redirection ( > / >> ) into a protected-sentinel path (slash OR backslash separators)
  #   • a write-verb token followed (later in the command) by a protected-sentinel path
  case "$cmd" in
    *write-gate-evidence*parity-clean*)                          CANDIDATE=1; return ;;
    *'>'*parity-clean*|*'>'*bootstrap-write-approved*)           CANDIDATE=1; return ;;
  esac
  case "$cmd" in
    *parity-clean*|*bootstrap-write-approved*)
      case "$cmd" in
        *tee\ *|*touch\ *|*'cp '*|*'mv '*|*install\ *|*' dd '*|*truncate\ *|*'sed '*)  CANDIDATE=1; return ;;
      esac ;;
  esac
  # Segment on the shell separators the router can see (&& || | ; & ( ) { } ` and newlines) via parameter
  # expansion, then iterate each segment as its own logical command. Splitting on ( and ) exposes a
  # subshell `( gh pr … )` and a command-substitution `$( gh pr … )` body as its own segment (the leading
  # `$` stays on the prior segment), so the gh-pr arm below classifies the inner op. Splitting on the
  # backtick exposes a `` `gh pr …` `` substitution body likewise — without it, a backtick-wrapped gh-pr
  # op would never be classified a candidate and would reach the tool ungated (the router half of the
  # subshell/cmd-subst bypass). This is COARSE on purpose: it can only OVER-route (route a benign backtick
  # like `echo \`date\`` to the engine, which then ALLOWs it) — never hide a governed op. The engine's
  # quote-aware grouping scanner is the AUTHORITATIVE decision; this split only ensures the engine is asked.
  local _seg="$cmd"
  _seg="${_seg//&&/$_lf}"; _seg="${_seg//||/$_lf}"; _seg="${_seg//|/$_lf}"
  _seg="${_seg//;/$_lf}";  _seg="${_seg//&/$_lf}"
  _seg="${_seg//(/$_lf}";  _seg="${_seg//)/$_lf}"; _seg="${_seg//\{/$_lf}"; _seg="${_seg//\}/$_lf}"
  _seg="${_seg//\`/$_lf}"
  local _oldifs="$IFS"
  while IFS= read -r seg; do
    [ -n "$seg" ] || continue
    set -f
    # shellcheck disable=SC2086
    set -- $seg
    set +f
    [ "$#" -gt 0 ] || continue
    # UNQUOTE every token: bash strips shell quotes at runtime, so `"git"`, `git "push"`, `p"ush"`,
    # `git""` all execute a real `git push`. The word-split above keeps the quote BYTES in the tokens, so
    # a literal `case "$1" in git)` / `[ "$1" = push ]` would MISS them → the recognizer would not flag the
    # candidate → the engine never runs → a governed push silently allowed (the router-quoting bypass).
    # Removing quote characters can only ever expose MORE candidates (the engine then makes the real,
    # quote-aware decision), never hide one — the fail-safe direction. Strip " and ' from all positional
    # params up front so every match below sees the executed token.
    { local _uq _ua=(); for _uq in "$@"; do _uq="${_uq//\"/}"; _uq="${_uq//\'/}"; _ua+=("$_uq"); done; set -- "${_ua[@]}"; }
    # Strip leading env-assignments (VAR=val) and COMMAND-WRAPPER prefixes so the real program token is
    # reached. WITHOUT this, `env git push`, `exec git push`, `builtin git push`, `nice git push`,
    # `nohup git push`, `time git push`, `stdbuf -oL git push`, `setsid git push`, `command git push` all
    # word-split with prog=env/exec/… (a non-candidate) → the engine never runs → a governed push silently
    # allowed (a FAIL-OPEN). We consume each recognized wrapper AND its own options/args, then re-derive prog.
    # Fail-safe by construction: if a wrapper's argument structure is ambiguous (an unknown option, or a
    # value-consuming option with no following token), we CANDIDATE-route (the engine then makes the real
    # decision) rather than guess — over-routing is safe, under-routing is the bug. Repeatable (wrappers nest:
    # `env exec git push`). Bounded to 12 iterations so a pathological prefix cannot loop unboundedly.
    local _wrap_iter=0
    while [ "$#" -gt 0 ] && [ "$_wrap_iter" -lt 12 ]; do
      _wrap_iter=$((_wrap_iter+1))
      case "${1#\\}" in
        [A-Za-z_]*=*) shift ;;                     # leading VAR=val environment assignment
        command) shift ;;                          # `command git push` — plain prefix, no options we honor here
        builtin) shift ;;                          # `builtin git push` — bash builtin dispatcher, no options
        nohup)   shift ;;                          # `nohup git push` — no option before the command
        setsid)  shift; case "${1:-}" in -f|--fork) shift ;; esac ;;   # `setsid [-f] git push`
        time)    shift; case "${1:-}" in -p) shift ;; esac ;;          # `time [-p] git push` — keyword/coreutil
        exec)    shift
                 # `exec [-cl] [-a name] cmd` — consume exec's own options (and -a's value) before the program.
                 while [ "$#" -gt 0 ]; do
                   case "$1" in
                     -a) shift; [ "$#" -gt 0 ] && shift || { IFS="$_oldifs"; CANDIDATE=1; return; } ;;
                     -a*) shift ;;
                     -cl|-lc|-c|-l) shift ;;
                     --) shift; break ;;
                     -*) IFS="$_oldifs"; CANDIDATE=1; return ;;   # unknown exec option → route conservatively
                     *) break ;;
                   esac
                 done ;;
        env)     shift
                 # `env [-i] [-u NAME]... [-C DIR] [-S str] [--] [VAR=val]... cmd` — consume env's options,
                 # separate-value options (-u/-C/-S take the next token), and VAR=val pairs, up to the program.
                 while [ "$#" -gt 0 ]; do
                   case "$1" in
                     -S|--split-string|-S*|--split-string=*)
                       # env -S '<cmdline>' RE-SPLITS its argument into a fresh argv and execs it — the wrapped
                       # PROGRAM lives inside that argument. The router already word-split the segment, so the
                       # program is smeared across later tokens; rather than guess, ROUTE conservatively and let
                       # the engine's wrapper taxonomy re-split + classify. (Closes the env -S router bypass.)
                       IFS="$_oldifs"; CANDIDATE=1; return ;;
                     -u|-C|--unset|--chdir|--block-signal|--default-signal|--ignore-signal)
                       shift; [ "$#" -gt 0 ] && shift || { IFS="$_oldifs"; CANDIDATE=1; return; } ;;
                     -u*|-C*|--unset=*|--chdir=*) shift ;;
                     -i|--ignore-environment|-0|--null|-v|--debug|-P*|--argv0*) shift ;;
                     --) shift; break ;;
                     [A-Za-z_]*=*) shift ;;                       # VAR=val
                     -*) IFS="$_oldifs"; CANDIDATE=1; return ;;   # unknown env option → route conservatively
                     *) break ;;
                   esac
                 done ;;
        nice)    shift
                 # `nice [-n N] [-N] cmd`
                 while [ "$#" -gt 0 ]; do
                   case "$1" in
                     -n) shift; [ "$#" -gt 0 ] && shift || { IFS="$_oldifs"; CANDIDATE=1; return; } ;;
                     -n*|--adjustment=*|-[0-9]*|--[0-9]*) shift ;;
                     --) shift; break ;;
                     -*) IFS="$_oldifs"; CANDIDATE=1; return ;;
                     *) break ;;
                   esac
                 done ;;
        stdbuf)  shift
                 # `stdbuf -oL -eL -i MODE cmd`
                 while [ "$#" -gt 0 ]; do
                   case "$1" in
                     -i|-o|-e) shift; [ "$#" -gt 0 ] && shift || { IFS="$_oldifs"; CANDIDATE=1; return; } ;;
                     -i*|-o*|-e*|--input=*|--output=*|--error=*) shift ;;
                     --) shift; break ;;
                     -*) IFS="$_oldifs"; CANDIDATE=1; return ;;
                     *) break ;;
                   esac
                 done ;;
        timeout) shift
                 # `timeout [-k DUR] [-s SIG] [--preserve-status] [--foreground] DURATION cmd` — consume its
                 # options AND the mandatory DURATION positional, then the program follows.
                 while [ "$#" -gt 0 ]; do
                   case "$1" in
                     -k|-s|--kill-after|--signal) shift; [ "$#" -gt 0 ] && shift || { IFS="$_oldifs"; CANDIDATE=1; return; } ;;
                     -k*|-s*|--kill-after=*|--signal=*) shift ;;
                     --preserve-status|--foreground|-v|--verbose) shift ;;
                     --) shift; break ;;
                     -*) IFS="$_oldifs"; CANDIDATE=1; return ;;
                     *) break ;;   # this positional is the DURATION
                   esac
                 done
                 [ "$#" -gt 0 ] && shift || { IFS="$_oldifs"; CANDIDATE=1; return; } ;;  # consume DURATION
        *) break ;;                                # not a wrapper → $1 is the real program
      esac
    done
    [ "$#" -gt 0 ] || continue
    # A prefix that nested past the iteration bound is pathological → route conservatively rather than miss it.
    [ "$_wrap_iter" -ge 12 ] && { IFS="$_oldifs"; CANDIDATE=1; return; }
    prog="$1"
    case "${prog#\\}" in
      git|git.exe|*/git|*/git.exe)
        shift
        # Skip the git global-option run (mirrors the engine's option grammar); the first non-option token is
        # the subcommand. Separate-value opts consume the NEXT token; an UNKNOWN global option → route
        # conservatively (we cannot know if it consumes the subcommand token).
        while [ "$#" -gt 0 ]; do
          case "$1" in
            -C|--git-dir|--work-tree|--namespace|--super-prefix|--exec-path|-c|--config-env)
              shift; [ "$#" -gt 0 ] && shift || break ;;
            --git-dir=*|--work-tree=*|--namespace=*|--super-prefix=*|--exec-path=*|--config-env=*|-c=*)
              shift ;;
            -p|--paginate|-P|--no-pager|--bare|--no-replace-objects|--no-lazy-fetch|--no-optional-locks|--no-advice|--literal-pathspecs|--glob-pathspecs|--noglob-pathspecs|--icase-pathspecs|--html-path|--man-path|--info-path|--no-renames)
              shift ;;
            -[A-Za-z]*|--*) IFS="$_oldifs"; CANDIDATE=1; return ;;   # unknown global option → conservative route
            *) break ;;
          esac
        done
        if [ "$#" -gt 0 ] && [ "$1" = push ]; then IFS="$_oldifs"; CANDIDATE=1; return; fi
        ;;
      gh|gh.exe)
        shift
        # gh … pr … (create|merge). `gh pr view`/`status`/`list` are read-only → NOT candidates.
        local _saw_pr=0
        for tok in "$@"; do
          case "$tok" in
            pr) _saw_pr=1 ;;
            create|merge) [ "$_saw_pr" = 1 ] && { IFS="$_oldifs"; CANDIDATE=1; return; } ;;
          esac
        done
        ;;
      bash|bash.exe|sh|sh.exe|dash|dash.exe|zsh|zsh.exe)
        shift
        # script-wrapper exec: a script-path argument, or `-c`/`-o` inline code (indirection). A bare
        # interpreter with only flags (`bash --version`, `bash -x`) executes NO script → NOT a candidate.
        while [ "$#" -gt 0 ]; do
          case "$1" in
            -c|-o) IFS="$_oldifs"; CANDIDATE=1; return ;;   # inline code / indirection → engine inspects
            --) shift; break ;;
            -*) shift ;;
            *) break ;;
          esac
        done
        [ "$#" -gt 0 ] && { IFS="$_oldifs"; CANDIDATE=1; return; }   # a script-path arg → wrapper
        ;;
      source|.)
        shift; [ "$#" -gt 0 ] && { IFS="$_oldifs"; CANDIDATE=1; return; } ;;   # source/dot inclusion of a path
      eval|xargs)
        IFS="$_oldifs"; CANDIDATE=1; return ;;   # indirection — a push/sentinel may be assembled at runtime
      *)
        # ── STRUCTURAL WRAPPER CATCH-ALL (closes the wrapper-enumeration class) ──────────────────────────────
        # The named-wrapper peel above is a FAST PATH for the common wrappers, but enumerating every command
        # wrapper is unwinnable: ionice/chrt/taskset/flock/faketime/catchsegv/unbuffer/torsocks/sudo/doas/…,
        # `env -S 'git push'`, and future wrappers all take the shape `<wrapper> [opts/args] git|gh …`. If the
        # leading program is UNRECOGNIZED (not git/gh/a shell/source/eval/xargs and not a peeled wrapper), it
        # MIGHT be an unknown wrapper — so if a bare `git` or `gh` program token appears LATER in this segment,
        # route to the engine. The engine is authoritative and fail-closed; the router only decides whether to
        # ASK it. Over-routing is SAFE (a benign `echo git push` / `grep gh file` reaches the engine, which
        # then ALLOWs it — costing only latency); UNDER-routing is the fail-open we must never do. We match a
        # STANDALONE git/gh token (a whole word), not a substring, so `legit`/`ghost`/`--gh-token` do not trip
        # it — over-routing is bounded to segments that literally contain the governed program as a word.
        for tok in "$@"; do
          case "${tok#\\}" in
            git|git.exe|*/git|*/git.exe|gh|gh.exe|*/gh|*/gh.exe)
              IFS="$_oldifs"; CANDIDATE=1; return ;;
          esac
        done
        ;;
    esac
  done <<< "$_seg"
  IFS="$_oldifs"
}

if [ "$_RTR_EXTRACTED" -eq 1 ]; then
  _rtr_structural "$_RTR_CMD"
else
  # (3) COARSE-NET FALLBACK — only when the command could NOT be extracted (malformed/absent JSON). Here we
  # cannot structurally parse, so we fail SAFE with the old over-approximation: any governed token in the
  # raw blob routes to the (fail-closed) engine. This preserves the security net for the rare malformed case
  # without imposing its over-routing on the common, cleanly-extractable path.
  case "$BLOB" in
    *push*|*gh*pr*create*|*gh*pr*merge*|*parity-clean*|*bootstrap-write-approved*|*write-gate-evidence*|*.preflight/gate/*|*.preflight\\\\gate\\\\*)
      CANDIDATE=1 ;;
  esac
fi

# Ordinary command → ALLOW immediately. Nothing else runs; no spawn, no engine. This is the fast path
# that the p95 SLO (Part C) measures.
if [ "$CANDIDATE" -eq 0 ]; then
  exit 0
fi

# ── Candidate path: hand the ORIGINAL stdin to the heavy engine, bounded, fail-closed ────────────────
# Resolve the engine next to this router (both ship together; the router never inspects the repo to find
# it). The engine receives the byte-for-byte original BLOB on stdin.
_RTR_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENGINE="$_RTR_DIR/pre-push-gate-engine"

# Engine missing → a candidate (push/pr/sentinel) cannot be adjudicated → BLOCK that candidate (scoped).
if [ ! -f "$ENGINE" ]; then
  echo "BLOCKED: pre-push-gate-engine not found at $ENGINE — a candidate push/PR/sentinel command cannot be" >&2
  echo "  adjudicated, so it is failed CLOSED (blocked). Ordinary commands are unaffected. Reinstall preflight" >&2
  echo "  (tools/preflight-install.sh) to restore the engine." >&2
  exit 2
fi

# Run the engine under a candidate-path deadline (Part C). The deadline bounds only the CANDIDATE path
# (rare), never the ordinary path, so a slow host pays the latency only on a real push/PR. `timeout`
# absent → run inline (degrade gracefully, no worse than pre-split). Capture stdout/stderr to files so an
# orphaned grandchild (credential helper, ssh-askpass) can't hold the platform's stdout pipe open.
#
# ── LOAD-BEARING TIMEOUT-BUDGET INVARIANT (the P0-fix RED this re-establishes) ────────────────────────────
# The PreToolUse protocol blocks ONLY on exit 2; any OTHER exit (incl. 137 = the platform's own SIGKILL when
# the hook overruns its registered `timeout`) is NON-blocking → the tool proceeds UNGATED. So the router's
# clean fail-closed `exit 2` MUST always fire BEFORE the platform can SIGKILL the router. The pre-split
# monolith held this by clamping its self-watchdog UNDER the platform kill; the split first shipped only a
# FLOOR on the deadline and NO ceiling, so at the old 30s default the router's full wall (engine bounded to
# deadline+kill-grace, PLUS the router's own startup + post-engine teardown spawns on a slow host) reached
# ~37s and overran the 35s platform timeout → SIGKILL → rc=137 → fail-OPEN on a protected-branch push. We
# re-derive the deadline FROM the platform timeout so the invariant holds by construction:
#     engine_deadline + KILL_GRACE + ROUTER_OVERHEAD_MARGIN  <  platform_timeout
# SINGLE SOURCE OF TRUTH: the platform timeout's real home is hooks.json (what Claude Code reads). The
# constant below is a DERIVED copy; tests/behavioral/router-timeout-budget-test.sh asserts it equals the
# hooks.json Bash-hook `timeout` (×1000) and that the derived ceiling clears the platform kill — if either
# the registration or this constant changes without the other, that coupling test FAILS (the dead-gate /
# dual-source bug class CLAUDE.md rule 5 names).
_RTR_PLATFORM_TIMEOUT_S=60     # MUST equal hooks.json PreToolUse Bash hook "timeout" (60000ms) — see coupling test
_RTR_KILL_GRACE_S=2            # `timeout -k 2`: SIGKILL the engine 2s after SIGTERM if it ignores SIGTERM
_RTR_OVERHEAD_MARGIN_S=10      # headroom for the router's OWN startup + post-engine teardown spawns (slow-spawn host)
# Ceiling: the largest engine deadline that still lets the router's exit 2 beat the platform SIGKILL.
_RTR_DEADLINE_CEILING=$(( _RTR_PLATFORM_TIMEOUT_S - _RTR_KILL_GRACE_S - _RTR_OVERHEAD_MARGIN_S ))   # 60-2-10 = 48
[ "$_RTR_DEADLINE_CEILING" -lt 10 ] && _RTR_DEADLINE_CEILING=10   # never let the derivation invert below the floor
# Default deadline = the safe ceiling. On a normal host the engine decides in <1s, so 48s is far more than
# ample; the wider budget exists for heavy endpoint-security (scan-on-exec) hosts where each git/jq/awk spawn
# costs seconds — there the engine reaches its CORRECT verdict (measured worst-case ~26s) and must not be
# killed mid-decision (that swallowed a legitimate CONFIRM into a spurious fail-closed BLOCK). On a
# pathologically slow host NO sub-platform deadline can let the engine finish, so the candidate STILL fails
# CLOSED (block) — the SAFE direction — instead of fail-OPEN via rc=137. The ceiling stays strictly under
# the platform kill so the router's clean exit 2 always wins the race.
_eng_deadline="${PREFLIGHT_ENGINE_DEADLINE:-$_RTR_DEADLINE_CEILING}"
case "$_eng_deadline" in (*[!0-9]*|'') _eng_deadline=$_RTR_DEADLINE_CEILING ;; esac   # non-numeric/empty → safe default
# OVERFLOW-SAFE clamp. A huge env value (e.g. 22 digits) overflows bash's `test` int64, so a NAIVE
# `[ "$v" -gt CEIL ]` ERRORS ("integer expression expected") and the clamp silently no-ops — leaving the
# huge value to hit GNU `timeout`, which treats an out-of-range duration as already-elapsed (rc 124). So we
# clamp by STRING LENGTH first: any value with more digits than the ceiling cannot be <= the ceiling, so it
# is clamped BEFORE any arithmetic compare can overflow. Only then is the (now bounded) value safe for `-lt`
# / `-gt`. `10#` strips leading zeros without octal surprises.
if [ "${#_eng_deadline}" -gt "${#_RTR_DEADLINE_CEILING}" ]; then
  _eng_deadline=$_RTR_DEADLINE_CEILING                                            # too many digits → clamp pre-arithmetic
fi
_eng_deadline=$(( 10#$_eng_deadline ))                                            # normalize (strip leading zeros)
[ "$_eng_deadline" -lt 10 ] && _eng_deadline=10                                   # floor (sane minimum)
[ "$_eng_deadline" -gt "$_RTR_DEADLINE_CEILING" ] && _eng_deadline=$_RTR_DEADLINE_CEILING   # CEILING: a too-large env
# override can never push the deadline past the platform kill and reopen the fail-OPEN. The knob can only make
# the candidate path STRICTER, never unsafe. (Closes both the lost-invariant RED and the no-upper-clamp gap.)
_eng_out="$(mktemp 2>/dev/null)" || _eng_out="${TMPDIR:-/tmp}/.pfg-eng-o.$$"
_eng_err="$(mktemp 2>/dev/null)" || _eng_err="${TMPDIR:-/tmp}/.pfg-eng-e.$$"

if command -v timeout >/dev/null 2>&1; then
  printf '%s' "$BLOB" | timeout -k "$_RTR_KILL_GRACE_S" "$_eng_deadline" bash "$ENGINE" >"$_eng_out" 2>"$_eng_err"
  _eng_rc=$?
else
  printf '%s' "$BLOB" | bash "$ENGINE" >"$_eng_out" 2>"$_eng_err"
  _eng_rc=$?
fi

if [ "$_eng_rc" -eq 0 ] || [ "$_eng_rc" -eq 2 ]; then
  # Real engine decision — relay its stdout (permissionDecision JSON, if any) + stderr + EXACT exit code.
  cat "$_eng_out" 2>/dev/null; cat "$_eng_err" >&2 2>/dev/null
  rm -f "$_eng_out" "$_eng_err" 2>/dev/null
  exit "$_eng_rc"
fi

# 124 (timeout), 137 (SIGKILL), or any other abnormal code: the engine did not reach a decision in time
# for THIS candidate → BLOCK this candidate only. Unrelated Bash is unaffected (it never reaches here).
cat "$_eng_err" >&2 2>/dev/null
rm -f "$_eng_out" "$_eng_err" 2>/dev/null
echo "BLOCKED: the preflight decision engine FAILED to reach a policy decision within its ${_eng_deadline}s" >&2
echo "  candidate deadline (rc=${_eng_rc}) for this push/PR/sentinel command. This is an ENGINE FAILURE, not a" >&2
echo "  policy approval: NO represented command executed, and the operation remains BLOCKED (fail-closed for" >&2
echo "  THIS candidate only — ordinary Bash is unaffected). A timeout is NOT a substitute for a policy decision." >&2
echo "  To proceed under governance: re-run the command (the engine may decide in time), or express it as a" >&2
echo "  plain, directly-inspectable 'git push <remote> <refspec>' so the gate can adjudicate it quickly." >&2
echo "  (Candidate-path fail-closed; see docs/parity-gate-limitations.md.)" >&2
exit 2
