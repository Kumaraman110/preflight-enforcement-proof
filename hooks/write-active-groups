#!/usr/bin/env bash
# Write the active coupling groups file. Called by the orchestrator after
# Stage 1 returns NEEDS_FIXES and the findings have been grouped by coupling.
#
# Usage: write-active-groups '<json-array>'
#   json-array: JSON string of groups, e.g.:
#   [{"files":["A.cs","B.cs"],"findings":["§4.2 on A:15","§4.3 on B:22"],"acknowledged":false}]
#
# The coupled-edit-gate reads this file to enforce group acknowledgment before edits.
# When all groups are acknowledged and fixes are applied, clear with: write-active-groups '[]'

set -euo pipefail

GROUPS_JSON="${1:-[]}"
GATE_DIR=".preflight/gate"
GROUPS_FILE="$GATE_DIR/active-groups.json"

# Validate JSON well-formedness AND the group SCHEMA, then NORMALIZE before writing (H4 — canonicalize at
# the chokepoint). The input must be a JSON ARRAY of group objects, each with a non-empty `files` array of
# strings. CRITICAL (H4): a group's `acknowledged` field is DEFAULTED to boolean false when missing or
# non-boolean — so the stored state always carries an explicit boolean, and the coupled-edit-gate consumer
# (which clears a group ONLY on `acknowledged == true`) can never be fooled by a missing/null/string value
# into a silent allow. Validating ONLY JSON well-formedness (the old behavior) let a schema-malformed group
# through verbatim; this validates the shape and writes the normalized array.
NORMALIZED=""
if command -v jq &>/dev/null; then
  if ! echo "$GROUPS_JSON" | jq empty 2>/dev/null; then
    echo "ERROR: Input is not valid JSON. Gate file not written." >&2
    echo "Input was: ${GROUPS_JSON:0:200}" >&2
    exit 1
  fi
  # Shape check: top-level array; every element an object with a non-empty files[] of strings.
  if ! echo "$GROUPS_JSON" | jq -e '
        (type == "array") and
        (all(.[]?;
           (type == "object")
           and (has("files")) and (.files | type == "array") and ((.files | length) > 0)
           and (all(.files[]?; type == "string"))))
      ' >/dev/null 2>&1; then
    echo "ERROR: Input is not a valid coupling-groups array (each element needs a non-empty \"files\" array of strings). Gate file not written." >&2
    echo "Input was: ${GROUPS_JSON:0:200}" >&2
    exit 1
  fi
  # Normalize: default a missing/non-boolean `acknowledged` to boolean false (fail-closed canonicalization).
  NORMALIZED=$(echo "$GROUPS_JSON" | jq '[ .[] | .acknowledged = ((.acknowledged) as $a | if ($a | type) == "boolean" then $a else false end) ]' 2>/dev/null) || {
    echo "ERROR: Failed to normalize coupling-groups. Gate file not written." >&2; exit 1; }
elif python3 -c "pass" &>/dev/null || python -c "pass" &>/dev/null; then
  PY=$(python3 -c "pass" 2>/dev/null && echo "python3" || echo "python")
  NORMALIZED=$(GROUPS_JSON="$GROUPS_JSON" $PY -c "
import json,os,sys
try:
    g=json.loads(os.environ['GROUPS_JSON'])
except Exception:
    sys.stderr.write('ERROR: Input is not valid JSON. Gate file not written.\n'); sys.exit(1)
if not isinstance(g,list):
    sys.stderr.write('ERROR: Input is not a coupling-groups ARRAY. Gate file not written.\n'); sys.exit(1)
for el in g:
    if not (isinstance(el,dict) and isinstance(el.get('files'),list) and len(el['files'])>0
            and all(isinstance(f,str) for f in el['files'])):
        sys.stderr.write('ERROR: Each group needs a non-empty \"files\" array of strings. Gate file not written.\n'); sys.exit(1)
    # Normalize acknowledged -> boolean (default false on missing/non-boolean): fail-closed canonicalization.
    el['acknowledged'] = el['acknowledged'] if isinstance(el.get('acknowledged'),bool) else False
sys.stdout.write(json.dumps(g))
") || { echo "Input was: ${GROUPS_JSON:0:200}" >&2; exit 1; }
else
  echo "WARNING: Cannot validate JSON (no jq or python). Writing unvalidated." >&2
  NORMALIZED="$GROUPS_JSON"
fi

mkdir -p "$GATE_DIR"
printf '%s\n' "$NORMALIZED" > "$GROUPS_FILE"
