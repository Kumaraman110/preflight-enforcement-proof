#!/usr/bin/env bash
# pre-push-gate-engine — the HEAVY push/PR/sentinel enforcement engine (preflight P0 split).
#
# Invoked ONLY by hooks/pre-bash-risk-router, and ONLY for candidate-risk commands (git push, gh pr
# create, protected-sentinel mints). It is NEVER on the ordinary-Bash fast path, so its many git/jq/grep
# spawns cannot delay or block an ordinary command.
#
# THE LAYER-1 SELF-WATCHDOG WAS REMOVED HERE (P0): the router now owns the deadline, scoped to the
# candidate path only (PREFLIGHT_ENGINE_DEADLINE, default 30s with a 2s kill-grace). Putting the deadline
# in the router means a slow engine fails CLOSED for the offending candidate alone — it can never again
# turn into "every Bash command times out and blocks". The Layer-2 per-subprocess wedge-bounding below is
# RETAINED (it gives precise, fast fail-closed on a single stalled git/jq without waiting for the outer
# deadline). The behavioral tests still drive this body directly (it reads stdin + emits 0/2/JSON).
#
# CONTRACT: stdin = the original tool JSON (relayed byte-for-byte by the router). exit 0 = allow,
# exit 2 = block, exit 0 + permissionDecision JSON on stdout = CONFIRM/allow tier. Same as before.
set -euo pipefail

# ── Stage-timing instrumentation (DIAGNOSIS ONLY — disabled by default) ───────────────────────────────────
# When PREFLIGHT_ENGINE_TIMING=1, _pfg_stage <label> appends "<ms-since-start> <label>" to
# $PREFLIGHT_ENGINE_TIMING_FILE (default stderr). Used to diagnose the live Gate-4 23s timeout (which engine
# stage consumes the slow-host spawn tax). NOT shipped enabled: with the var unset, _pfg_stage is a no-op
# that does ZERO work (no date/EPOCHREALTIME read), so it cannot perturb normal latency or behavior.
if [ "${PREFLIGHT_ENGINE_TIMING:-0}" = "1" ]; then
  _PFG_T0="${EPOCHREALTIME:-0}"
  _PFG_TIMING_OUT="${PREFLIGHT_ENGINE_TIMING_FILE:-/dev/stderr}"
  _pfg_stage() {
    local now="${EPOCHREALTIME:-0}"
    awk -v s="$_PFG_T0" -v n="$now" -v l="$1" 'BEGIN{printf "PFG_STAGE %8.1fms  %s\n",(n-s)*1000,l}' >> "$_PFG_TIMING_OUT" 2>/dev/null || true
  }
else
  _pfg_stage() { :; }
fi
_pfg_stage "engine-start"

# --- Heartbeat (passive liveness self-evidencing) — BUILTINS-ONLY candidate variant (Gate-4 latency) ---
# The engine is the HEAVY candidate path. The shared lib's _write_heartbeat (lib/heartbeat.sh) spawns
# `date` + `git rev-parse HEAD` — measured ~1.45s on this slow-spawn Windows/Git-Bash host — at the very
# top, BEFORE the forbidden-remote decision, and was a top contributor to the live Gate-4 23s timeout.
# This engine-local writer appends the SAME 3-field heartbeat record (`<ts> <head-field> <gate-name>`)
# that the lib's freshness checker (_check_heartbeat_fresh — which reads ONLY field 1, the timestamp)
# consumes, but using bash BUILTINS ONLY: no git/date/jq/node/awk/sed/grep/cat — zero external process.
#   • timestamp: `printf -v now '%(%s)T' -1` (bash >= 4.2 builtin), validated digits-only, with a no-spawn
#     fallback to the EPOCHSECONDS builtin (bash >= 5.0), then to `0` (exactly the lib's own fallback
#     value, which _check_heartbeat_fresh already treats as "missing/unparseable" — fail-safe, never fatal).
#   • HEAD field: the literal placeholder `candidate` — the candidate path deliberately spends NO
#     `git rev-parse HEAD` spawn. No consumer reads the heartbeat HEAD column (audited: only field 1 / ts
#     is read, by session-start's freshness probe); the placeholder keeps the 3-field format parseable and
#     is documented here so it is never mistaken for a real SHA.
#   • non-fatal: the whole write is guarded (dir-exists check mirrors the lib; redirect errors swallowed)
#     so a missing/unwritable .preflight/gate can never crash this blocking gate (which under `set -e`
#     would otherwise fail the gate OPEN). We do NOT source lib/heartbeat.sh here — dropping that source
#     also removes its `dirname`+subshell self-dir spawns from the candidate path.
_pfg_heartbeat_builtin() {  # $1 = gate name. Appends one builtins-only liveness record. Always returns 0.
  local gate="${1:-unknown}" hb_dir=".preflight/gate" now=""
  [ -d "$hb_dir" ] || return 0
  printf -v now '%(%s)T' -1 2>/dev/null || now=""
  case "$now" in ''|*[!0-9]*) now="${EPOCHSECONDS:-0}" ;; esac   # builtin %(...)T unsupported → EPOCHSECONDS
  case "$now" in ''|*[!0-9]*) now=0 ;; esac                       # neither builtin available → lib's fallback
  printf '%s %s %s\n' "$now" "candidate" "$gate" >> "$hb_dir/heartbeat-${gate}" 2>/dev/null || true
  return 0
}
_pfg_heartbeat_builtin "pre-push-gate-check"
# NOTE on wedge coverage (post-P0-split): the BUILTINS-ONLY heartbeat above now makes NO subprocess call
# at all (the prior git/date spawns are gone). The config-overlay lib sourced below is pure function
# definitions at source time (zero spawns); its git/jq calls happen only LATER, inside _pfg_branch_field
# on the full policy path, which the Layer-2 `_pfg_git`/`_pfg_jq` wrappers do not intercept — those are
# local-repo reads (`git rev-parse HEAD`, a config-file `jq`), the LEAST wedge-prone (no network/credential
# round-trip). The COMPREHENSIVE backstop is no longer an in-body self-watchdog (removed in the P0 split —
# it was the architecture that blocked every Bash command on a slow-spawn host); it is now the ROUTER's
# candidate-scoped deadline (`PREFLIGHT_ENGINE_DEADLINE`, default 30s + 2s kill-grace), which wraps this
# ENTIRE engine process and fails CLOSED for the offending candidate ALONE if a wedge ANYWHERE runs past
# it. Layer 2 here is the FAST in-engine fail-closed for the network-facing push-target resolution
# (`git remote get-url`), the call that actually wedges in practice: it trips in ~3s with a precise
# diagnostic without waiting for the router's outer deadline.

# Per-clone topology overlay (issue #6): source the shared resolver so branch.base /
# branch.remote honor a gitignored .preflight/config.local.json. Best-effort — if the
# lib is missing (older install), _pfg_branch_field falls back to committed config.
_PFG_SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
for _pfg_overlay_lib in "$_PFG_SELF_DIR/../lib/config-overlay.sh" "$_PFG_SELF_DIR/../.claude/lib/config-overlay.sh"; do
  if [ -f "$_pfg_overlay_lib" ]; then
    # shellcheck source=/dev/null
    source "$_pfg_overlay_lib" 2>/dev/null || true
    break
  fi
done

# ── Subprocess wedge-bounding (Layer 2 of the fail-closed conversion) ─────────
# Each wedge-prone external call (git remote get-url, git rev-parse, jq config read) is run
# under a SHORT per-call timeout, so a SINGLE stalled subprocess fails closed in ~3s with a
# precise diagnostic instead of riding the 8s self-watchdog backstop. Fail direction CLOSED:
# a TIMED-OUT call (124) or signal-kill (137) sets a FILESYSTEM wedge flag — a shell variable
# would not survive the `$(...)` subshells these calls run inside, but a file write does — and
# the main shell checks the flag at each allow/ask decision point and BLOCKS (exit 2). A NORMAL
# non-zero (e.g. `git remote get-url` exit 2 for an absent remote) is NOT a wedge: it is a
# legitimate empty result, left to the existing `|| true` fail-open-by-design resolution paths.
_PFG_SUBPROC_TIMEOUT=3
_PFG_WEDGE_FLAG="${TMPDIR:-/tmp}/.pfg-wedge.$$"
rm -f "$_PFG_WEDGE_FLAG" 2>/dev/null || true
trap 'rm -f "$_PFG_WEDGE_FLAG" 2>/dev/null || true' EXIT
_pfg_have_timeout() { command -v timeout >/dev/null 2>&1; }
# Bounded subprocess runner. CRITICAL: the timed call writes to a TEMP FILE, never a
# command-substitution pipe. A wedged subprocess can spawn a child (credential helper, the
# git-stub's `sleep`) that INHERITS the capture fd; with `$(timeout 3 cmd)` the outer pipe
# then stays open until that orphaned grandchild dies, so the substitution HANGS for the full
# wedge despite `timeout` having already reaped the direct child. Writing to a file and reading
# it AFTER timeout returns waits only on the direct child timeout manages — the orphan lingers
# harmlessly. `-k 1`: a subprocess that ignores SIGTERM is SIGKILLed 1s later. stdin from
# /dev/null so a read-blocked subprocess can't stall either.
_pfg_bounded() {  # $1 = binary (git|jq) ; $@ = its args. Echoes stdout; ALWAYS returns 0.
  # SHORT-CIRCUIT: once anything has wedged, the decision is already going to BLOCK at the next
  # checkpoint — don't pay another timeout per remaining call (6+ git/jq lookups would otherwise
  # stack to >18s and blow the watchdog/platform budget). Return empty instantly.
  [ -f "$_PFG_WEDGE_FLAG" ] && return 0
  local bin="$1"; shift
  local tmp rc; tmp="$(mktemp 2>/dev/null)" || tmp="${TMPDIR:-/tmp}/.pfg-out.$$.$RANDOM"
  if _pfg_have_timeout; then timeout -k 1 "$_PFG_SUBPROC_TIMEOUT" "$bin" "$@" >"$tmp" 2>/dev/null </dev/null; rc=$?
  else                       "$bin" "$@" >"$tmp" 2>/dev/null </dev/null; rc=$?; fi
  if [ "$rc" -eq 124 ] || [ "$rc" -eq 137 ] || [ "$rc" -eq 125 ]; then
    : > "$_PFG_WEDGE_FLAG" 2>/dev/null || true   # 124=timed out, 137=SIGKILLed, 125=timeout internal error
  fi
  cat "$tmp" 2>/dev/null || true
  rm -f "$tmp" 2>/dev/null || true
  return 0
}
_pfg_git() { _pfg_bounded git "$@"; }   # bounded git (remote get-url / rev-parse) — wedge-prone
_pfg_jq()  { _pfg_bounded jq  "$@"; }   # bounded jq (config-file reads) — wedge-prone on stalled FS
# Checkpoint: call immediately before ANY allow/ask emission. If a bounded subprocess wedged,
# the push target could not be fully verified → fail CLOSED (block), never allow/ask on it.
_pfg_wedge_block_if_flagged() {
  if [ -f "$_PFG_WEDGE_FLAG" ]; then
    echo "BLOCKED: a push-safety subprocess (git/jq) timed out (~${_PFG_SUBPROC_TIMEOUT}s) while resolving the" >&2
    echo "  push target — the destination could not be fully verified. This is an ENGINE/subprocess FAILURE, not" >&2
    echo "  a policy approval: the push remains BLOCKED (fail-closed), NOT allowed on an unresolved target, and no" >&2
    echo "  represented command executed. Re-run the command, or express it as a plain, directly-inspectable" >&2
    echo "  'git push <remote> <refspec>' so the gate can resolve and adjudicate the target. (Subprocess" >&2
    echo "  wedge-bound; see docs/parity-gate-limitations.md.)" >&2
    exit 2
  fi
}

_pfg_stage "heartbeat+overlay-sourced"
STDIN_JSON="$(cat)"
_pfg_stage "stdin-read"

# Primary: extract the command field via jq (bounded — a wedge here falls to the raw-blob
# fallback below, which fail-safely greps for 'git push'; no flag needed on this path).
if _pfg_have_timeout; then
  COMMAND="$(printf '%s' "$STDIN_JSON" | timeout "$_PFG_SUBPROC_TIMEOUT" jq -r '.tool_input.command // empty' 2>/dev/null || true)"
else
  COMMAND="$(printf '%s' "$STDIN_JSON" | jq -r '.tool_input.command // empty' 2>/dev/null || true)"
fi

# Fallback: if extraction yielded nothing, use the raw blob so a push
# is still detected (fail-safe for the push case; non-pushes still pass).
if [ -z "$COMMAND" ]; then
  COMMAND="$STDIN_JSON"
fi
_pfg_stage "command-extracted"

# ── (FAST-0) BUILTINS-ONLY EXPLICIT-REMOTE FORBIDDEN FAST PATH (live Gate-4 23s-timeout fix) ──────────────
# THE PROBLEM: the existing early forbidden-remote block (B-EARLY, below) already decides the cheapest case
# — an explicit push to a forbiddenRemotes NAME — but only AFTER the sentinel-tripwire greps, the
# `_pfg_target_cwd` grep, the awk continuation-join, the structural parser's greps/seds, and one jq read of
# forbiddenRemotes. On this slow-spawn Windows/Git-Bash host those ~5-6 external spawns (~1.0-1.5s EACH,
# jittery) stacked the decision to ~13-15s engine-internal — close enough to the router's 23s candidate
# deadline that wall-time variance produced live timeouts (Phase-0: p95/max ~25.5s).
#
# THE FIX: make the SAME forbidden-NAME decision HERE, immediately after command extraction, using BASH
# BUILTINS ONLY — zero external process. If a high-confidence parse resolves an EXPLICIT remote name and that
# name is on the committed branch.forbiddenRemotes, emit the identical forbidden-destination diagnostic and
# exit 2 — BEFORE the tripwire greps, the target-cwd grep, the continuation-join, the structural parser, and
# the jq config read. This is purely an EARLIER, CHEAPER exit for the most-certain block; it adds NO new
# block and changes NO other path.
#
# CONFIDENCE GATE (the shortcut may ONLY fire when ALL hold — otherwise it falls through 100% unchanged to
# the full structural parser + B-EARLY + full policy path, which remain authoritative):
#   • the command parses cleanly as: [env-assignments…] [command] <git-program> [global-opts…] push <args…>
#   • git-program ∈ { git, git.exe, \git, */git, */git.exe }; backslash+LF and backslash+CRLF continuations
#     are joined with PURE PARAMETER EXPANSION (no awk/sed); any UNKNOWN global option → bail (we cannot know
#     if it consumes the next token, so we cannot safely locate the subcommand);
#   • the first positional after `push` is a SIMPLE remote name (allowlist [A-Za-z0-9._-] only). A URL, an
#     scp-form target, a path, a quoted/expanded/ambiguous token, '.' or '..', or NO positional (implicit
#     push) → bail. So URL pushes, implicit pushes, and indirection (eval/bash -c/xargs — first token is not
#     a git program) all fall through to the existing fail-closed handling unchanged.
# The shortcut NEVER allows: a non-forbidden name simply falls through to the full path (which may still
# CONFIRM/BLOCK it on protected-branch/evidence/forbiddenRepos grounds). It can ONLY turn a forbidden-name
# push into an earlier exit-2.
# COST CEILING (when it fires): pure parameter expansion + word-splitting + one `$(<config)` builtin read +
# one `[[ =~ ]]` match. NO git, date, jq, node, awk, sed, grep, cat — nothing spawns. cwd is $PWD (the
# shortcut only fires when the FIRST token is a git program, so there is no leading `cd` to honor — the
# git command would run in the engine's own cwd; the grep-based _pfg_target_cwd is therefore not needed here).
_fast_emit_forbidden() {  # $1 = remote name. Emit the shared forbidden-destination diagnostic + exit 2.
  echo "BLOCKED: push targets a FORBIDDEN destination '$1' (config.branch.forbiddenRemotes)." >&2
  echo "  This remote is explicitly off-limits (e.g. a legacy production repo). Do NOT retarget automatically —" >&2
  echo "  surface to a human; see docs/parity-gate-limitations.md. (Early forbidden-remote decision: no" >&2
  echo "  network, evidence gate, or remote-URL resolution was performed.)" >&2
  exit 2
}
# forbiddenRepos SLUG match → HARD BLOCK (exit 2). Same wording class as the heavy path's B0 block
# (a denylisted resolved slug is never merely-confirm — it is an explicit off-limits destination).
_fast_emit_forbidden_repo() {  # $1 = remote-or-target (display) ; $2 = resolved slug
  echo "BLOCKED: push targets a FORBIDDEN destination '$1' (config.branch.forbiddenRemotes/forbiddenRepos)." >&2
  echo "  This remote is explicitly off-limits (e.g. a legacy production repo). Do NOT retarget automatically —" >&2
  echo "  surface to a human; see docs/parity-gate-limitations.md." >&2
  echo "  (Agent Bash-tool guard only; not server-side protection.)" >&2
  exit 2
}
# Emit stdin as a JSON string LITERAL (surrounding quotes + escaped) for the permissionDecisionReason
# value. HOISTED here (above the fast-decision block, which calls it via _fast_emit_confirm). jq is
# UTF-8-safe; node is the fallback; a last-ditch sed escapes the JSON-critical chars so the stdout JSON
# never breaks (a malformed payload would be ignored by the platform → fail-open to normal permission
# flow, acceptable for a CONFIRM case, but we escape properly).
_pfg_json_string() {
  if command -v jq &>/dev/null; then
    jq -Rs . 2>/dev/null && return 0
  fi
  if command -v node &>/dev/null; then
    node -e "let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>process.stdout.write(JSON.stringify(d.replace(/\n+$/,''))))" 2>/dev/null && return 0
  fi
  printf '"%s"' "$(sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/\r//g' -e 's/\t/ /g' | tr '\n' ' ')"
}
# CONFIRM (ask) emitter for the fast-decision path — identical wire shape + wording class as the heavy
# path's CONFIRM tier (single source). Emits exit 0 + permissionDecision:ask, then exits 0.
_fast_emit_confirm() {  # $1 = reason (content-derived, no human-shell steering)
  _pfg_stage "fast-decision:CONFIRM"
  printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"ask","permissionDecisionReason":%s}}\n' \
    "$(printf '%s' "CONSEQUENTIAL PUSH — confirm to proceed. $1" | _pfg_json_string)"
  exit 0
}
# Builtins-only forbiddenRepos slug membership (mirrors _pfg_repo_forbidden, which normalizes each list
# entry via url_to_slug). Entries may be slugs OR URLs; compare normalized slugs.
_fast_repo_forbidden() {  # $1 = target slug ; $2 = forbiddenRepos newline list. 0 = forbidden.
  local slug="$1" line; [ -n "$slug" ] || return 1
  while IFS= read -r line; do [ -z "$line" ] && continue; [ "$(_fast_url_to_slug "$line")" = "$slug" ] && return 0; done <<< "$2"
  return 1
}
# Builtins-only safeRemotes slug membership (mirrors the slug arm of _pfg_remote_on_safelist).
_fast_slug_on_safelist() {  # $1 = slug ; $2 = safeRemotes newline list. 0 = on the list.
  local slug="$1" line; [ -n "$slug" ] || return 1
  while IFS= read -r line; do [ -z "$line" ] && continue; [ "$(_fast_url_to_slug "$line")" = "$slug" ] && return 0; done <<< "$2"
  return 1
}
# AUTO path: run the EXISTING evidence gate (bounded) and, only if evidence is fresh, emit the explicit
# AUTO allow. A stale/missing-evidence gate exits 2 (hard block) — that block stands. Any abnormal gate
# exit is normalized to a fail-CLOSED block (same discipline as the heavy path's evidence handling).
# This is the ONE place the fast path spawns the (bounded) evidence gate — the heavy path runs it too.
_fast_run_evidence_then_allow() {
  local _ppg_dir _rc
  _ppg_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  # The evidence gate resolves HEAD/diff itself; it is bounded by the router's candidate deadline (this
  # whole engine runs inside it). stdin from /dev/null (parent already consumed stdin).
  set +e
  bash "$_ppg_dir/pre-push-gate" </dev/null
  _rc=$?
  set -e
  if [ "$_rc" -eq 0 ]; then
    _pfg_stage "fast-decision:AUTO-allow"
    printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"allow","permissionDecisionReason":"Reversible push: unprotected branch to the configured safe remote, non-force, gate evidence fresh."}}\n'
    exit 0
  fi
  if [ "$_rc" -eq 2 ]; then exit 2; fi   # evidence gate hard-blocked (missing/stale) — stands.
  # Any other code (1/127/126/124/137/…) is NON-blocking under PreToolUse → normalize to a fail-CLOSED block.
  echo "BLOCKED: the pre-push evidence gate exited abnormally (rc=$_rc) — neither 0 (fresh) nor 2 (block)." >&2
  echo "  A non-0/2 code is NON-blocking under the PreToolUse protocol, so passing it through would let the" >&2
  echo "  push proceed UNGATED. Failing CLOSED: the push is BLOCKED. Re-run the gate at HEAD, then retry." >&2
  exit 2
}
# Confident builtins-only parse. Sets, for the cleanly-parsed-push case, ALL the decision inputs the
# fast-decision path needs — using bash builtins only (zero external process):
#   _FAST_PARSED   = 1 iff the command cleanly parsed as a single `git … push …` (no indirection/unknown-opt).
#   _FAST_OK       = 1 iff a SIMPLE explicit remote NAME was found (the original forbidden-name contract).
#   _FAST_REMOTE   = that simple explicit remote name (when _FAST_OK=1).
#   _FAST_KIND     = name | url | bare    (url = first positional is a URL/scp/path; bare = no positional).
#   _FAST_TARGET   = the first positional token (remote name OR url), '' for bare.
#   _FAST_REFSPEC  = the refspec positional (second positional), '' if none.
#   _FAST_FORCE    = 1 iff --force/-f/--force-with-lease[...]/--force-if-includes OR a leading '+' refspec.
# _FAST_OK is set ONLY for the simple-name case (so the existing forbidden-name block is unchanged). The
# fast-decision block keys on _FAST_PARSED + _FAST_KIND, and falls through to the heavy path whenever the
# command did NOT cleanly parse (_FAST_PARSED=0).
_FAST_OK=0; _FAST_REMOTE=""; _FAST_PARSED=0; _FAST_KIND=""; _FAST_TARGET=""; _FAST_REFSPEC=""; _FAST_FORCE=0
_pfg_fast_parse_remote() {  # $1 = the raw command string. Builtins only. Always returns 0.
  local cmd="$1" tok
  # (a) Join shell line-continuations with PARAMETER EXPANSION ONLY. Quoted search/replace patterns are
  #     LITERAL byte sequences (no glob). CRLF (\+CR+LF) first, then LF (\+LF). A backslash NOT followed by a
  #     newline (Windows path, escaped char) is untouched — narrow, exactly like the structural parser's join.
  local _cr=$'\r' _lf=$'\n'
  local _bs_crlf=$'\\'"$_cr$_lf" _bs_lf=$'\\'"$_lf"
  cmd="${cmd//"$_bs_crlf"/ }"
  cmd="${cmd//"$_bs_lf"/ }"
  # If any backslash-newline still remains (an exotic shape the two passes above didn't cover) → bail.
  case "$cmd" in *$'\\'$'\r'*|*$'\\'$'\n'*) return 0 ;; esac
  # (b) Word-split with globbing OFF (set -f). Default IFS splits on space/tab/newline. NO quote removal and
  #     NO parameter expansion of token contents happens here — a literal `$PATH` inside a token stays inert.
  local _oldifs="$IFS"; set -f
  # shellcheck disable=SC2086
  set -- $cmd
  set +f; IFS="$_oldifs"
  # (c) Strip env-assignment prefixes (VAR=val) and a `command` prefix (repeatable).
  while [ "$#" -gt 0 ]; do
    case "$1" in
      [A-Za-z_]*=*) shift ;;
      command) shift ;;
      *) break ;;
    esac
  done
  [ "$#" -gt 0 ] || return 0
  # (d) Program token must be a git program form (optional one leading backslash for `\git`).
  case "${1#\\}" in
    git|git.exe|*/git|*/git.exe) ;;
    *) return 0 ;;
  esac
  shift
  # (e) Skip the global-option run (mirrors _pfg_seg_push_args' table). Separate-value opts consume the NEXT
  #     token; =-joined and bare flags are single tokens; an UNKNOWN global option → bail (fail to full parser).
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -C|--git-dir|--work-tree|--namespace|--super-prefix|--exec-path|-c|--config-env)
        shift; [ "$#" -gt 0 ] && shift || return 0 ;;
      --git-dir=*|--work-tree=*|--namespace=*|--super-prefix=*|--exec-path=*|--config-env=*|-c=*)
        shift ;;
      -p|--paginate|-P|--no-pager|--bare|--no-replace-objects|--no-lazy-fetch|--no-optional-locks|--no-advice|--literal-pathspecs|--glob-pathspecs|--noglob-pathspecs|--icase-pathspecs|--html-path|--man-path|--info-path|--no-renames)
        shift ;;
      -[A-Za-z]*|--*) return 0 ;;
      *) break ;;
    esac
  done
  [ "$#" -gt 0 ] || return 0
  [ "$1" = "push" ] || return 0
  shift
  # The command cleanly parsed as a `git … push …` invocation (no indirection, no unknown global option).
  _FAST_PARSED=1
  # (f) Walk the push args: detect force flags, then the FIRST positional (= remote: name or URL) and the
  #     SECOND positional (= refspec). A leading '+' on a refspec positional is a force update (git shorthand).
  local _seen_pos=0
  for tok in "$@"; do
    case "$tok" in
      --force|-f|--force-with-lease|--force-with-lease=*|--force-if-includes)
        _FAST_FORCE=1 ;;
      -*) ;;                                  # other push flags (-u/--tags/--set-upstream/…)
      +*)
        # '+'-prefixed positional = forced refspec. Record the stripped value as a positional.
        _FAST_FORCE=1
        tok="${tok#+}"
        if [ "$_seen_pos" -eq 0 ]; then _FAST_TARGET="$tok"; _seen_pos=1
        elif [ -z "$_FAST_REFSPEC" ]; then _FAST_REFSPEC="$tok"; fi ;;
      *)
        if [ "$_seen_pos" -eq 0 ]; then _FAST_TARGET="$tok"; _seen_pos=1
        elif [ -z "$_FAST_REFSPEC" ]; then _FAST_REFSPEC="$tok"; fi ;;
    esac
  done
  # Classify the first positional (the push TARGET).
  if [ "$_seen_pos" -eq 0 ]; then
    _FAST_KIND="bare"                         # no positional remote = implicit/bare push
  else
    case "$_FAST_TARGET" in
      ''|.|..)              _FAST_KIND="url" ;;   # ambiguous → treat as non-simple (URL bucket)
      *[!A-Za-z0-9._-]*)    _FAST_KIND="url" ;;   # contains / : @ etc → URL / scp-form / path
      *)                    _FAST_KIND="name"; _FAST_REMOTE="$_FAST_TARGET"; _FAST_OK=1 ;;
    esac
  fi
  return 0
}
# ── Builtins-only committed-config readers (no jq/grep/tr/node/sed — zero external process) ───────────────
# These let the fast-decision path (below) read branch.* WITHOUT the heavy _pfg_branch_field/_pfg_branch_array
# spawns. They operate on the config JSON TEXT already read via `$(<config)`. The committed forbidden/safe
# lists are NOT overlayable (see config-overlay allowlist), so reading committed text directly is correct
# for those; branch.remote/base ARE overlayable, so the fast path reads them with the builtin AND verifies
# no config.local.json overlay is present (if one exists, it falls through to the heavy overlay-aware path).
# `_fast_json_array <json> <key>` echoes newline-separated string elements of a top-level-ish "key":[ ... ].
_fast_json_array() {  # $1 = json text ; $2 = key
  local json="$1" key="$2" body item out="" _cr=$'\r'
  local _re="\"$key\"[[:space:]]*:[[:space:]]*\\[([^]]*)\\]"
  [[ "$json" =~ $_re ]] || { return 0; }
  body="${BASH_REMATCH[1]}"
  local _oldifs="$IFS"; IFS=','; set -f
  # shellcheck disable=SC2086
  set -- $body
  set +f; IFS="$_oldifs"
  for item in "$@"; do
    item="${item#"${item%%[![:space:]]*}"}"; item="${item%"${item##*[![:space:]]}"}"
    item="${item%$_cr}"; item="${item#\"}"; item="${item%\"}"
    [ -n "$item" ] && out="${out}${item}"$'\n'
  done
  printf '%s' "$out"
}
# `_fast_json_scalar <json> <key>` echoes a top-level-ish "key":"value" string scalar (no nesting parse).
_fast_json_scalar() {  # $1 = json text ; $2 = key
  local json="$1" key="$2" _cr=$'\r' v
  local _re="\"$key\"[[:space:]]*:[[:space:]]*\"([^\"]*)\""
  [[ "$json" =~ $_re ]] || { return 0; }
  v="${BASH_REMATCH[1]}"; v="${v%$_cr}"; printf '%s' "$v"
}
# `_fast_in_list <needle> <newline-list>` — exact-match membership (no regex specials).
_fast_in_list() {  # $1 = needle ; $2 = newline-separated list
  local needle="$1" line; [ -n "$needle" ] || return 1
  while IFS= read -r line; do [ -z "$line" ] && continue; [ "$line" = "$needle" ] && return 0; done <<< "$2"
  return 1
}
# `_fast_url_to_slug <url-or-name>` — builtins-only owner/repo extraction (mirrors _pfg_url_to_slug's sed).
_fast_url_to_slug() {  # $1 = url or scp-form or path
  local s="$1"
  case "$s" in
    git@*:*) s="${s#git@}"; s="${s#*:}" ;;          # git@host:owner/repo(.git) → owner/repo(.git)
    *://*)   s="${s#*://}"; s="${s#*/}" ;;          # scheme://host/owner/repo(.git) → owner/repo(.git)
  esac
  s="${s%.git}"
  while [ "${s#/}" != "$s" ]; do s="${s#/}"; done    # strip leading slashes
  printf '%s' "$s"
}
# `_fast_looks_prod <slug-or-url> <extra-newline-patterns>` — builtins-only segment-boundary prod match.
# Mirrors _pfg_remote_looks_prod EXACTLY: same built-in token set, same segment rule (a token must appear
# bounded by start-of-string / end-of-string / one of  / . - _ :  ), case-insensitive. Implemented with
# bash's own `[[ =~ ]]` regex engine (NO grep spawn) using the identical ERE the heavy path feeds to grep.
_FAST_PROD_TOKENS="prod production prd release live legacy"
_fast_looks_prod() {  # $1 = haystack ; $2 = extra patterns (newline)
  local hay="$1" extra="${2:-}" tok lc
  [ -n "$hay" ] || return 1
  lc="${hay,,}"   # bash builtin lowercase (>=4.0); no tr spawn
  for tok in $_FAST_PROD_TOKENS; do
    [[ "$lc" =~ (^|[/._:-])${tok}([/._:-]|$) ]] && return 0
  done
  if [ -n "$extra" ]; then
    while IFS= read -r tok; do
      [ -z "$tok" ] && continue
      tok="${tok,,}"
      [[ "$lc" =~ (^|[/._:-])${tok}([/._:-]|$) ]] && return 0
    done <<< "$extra"
  fi
  return 1
}
# Builtins-only committed-config forbiddenRemotes membership test (no jq/grep/tr/node).
_pfg_fast_remote_forbidden() {  # $1 = remote name ; $2 = config JSON text. return 0 = forbidden.
  local name="$1" json="$2"
  [ -n "$name" ] || return 1
  _fast_in_list "$name" "$(_fast_json_array "$json" forbiddenRemotes)" && return 0
  return 1
}
_pfg_fast_parse_remote "$COMMAND"
# Resolve + read committed config ONCE (builtins; reused by the forbidden-name block AND the full
# fast-decision block below). Pure-shell upward FS walk from $PWD — NO git rev-parse. Bounded <=64.
_FAST_CFG=""; _FAST_CFG_TEXT=""; _FAST_CFG_DIR=""
if [ "$_FAST_PARSED" = 1 ]; then
  _fast_dir="$PWD"; _fast_n=0
  while [ -n "$_fast_dir" ] && [ "$_fast_n" -lt 64 ]; do
    if [ -f "$_fast_dir/.preflight/config.json" ]; then _FAST_CFG="$_fast_dir/.preflight/config.json"; _FAST_CFG_DIR="$_fast_dir"; break; fi
    case "$_fast_dir" in */*) _fast_dir="${_fast_dir%/*}"; [ -z "$_fast_dir" ] && _fast_dir="/" ;; *) break ;; esac
    [ "$_fast_dir" = "/" ] && { [ -f "/.preflight/config.json" ] && { _FAST_CFG="/.preflight/config.json"; _FAST_CFG_DIR="/"; }; break; }
    _fast_n=$((_fast_n+1))
  done
  if [ -n "$_FAST_CFG" ]; then
    # `$(<file)` is a BASH BUILTIN read (no `cat` spawn) — confirmed spawn-free on this host.
    _FAST_CFG_TEXT="$(<"$_FAST_CFG")" 2>/dev/null || _FAST_CFG_TEXT=""
  fi
fi
# ── forbidden-remote NAME fast block (the proven Part-1 path; unchanged behavior) ──
if [ "$_FAST_OK" = 1 ] && [ -n "$_FAST_REMOTE" ]; then
  _pfg_stage "fast0:parsed-remote=$_FAST_REMOTE"
  _pfg_stage "fast0:config-resolved(no-git)"
  if [ -n "$_FAST_CFG_TEXT" ]; then
    _pfg_stage "fast0:config-read(no-spawn)"
    if _pfg_fast_remote_forbidden "$_FAST_REMOTE" "$_FAST_CFG_TEXT"; then
      _pfg_stage "fast0:FORBIDDEN-decision"
      _fast_emit_forbidden "$_FAST_REMOTE"
    fi
  fi
  # Not forbidden (or config unreadable) → continues to the FULL fast-decision block below.
fi

# ── (FAST-DECISION) builtins-first COMPLETE tier decision (Gate-4 spawn-budget fix) ──────────────────────
# THE PROBLEM (proven): the heavy structural+policy pipeline makes ~45 external spawns per push decision;
# on this slow-spawn host (~1s/spawn) that exceeds the router's 23s candidate deadline, so EVERY non-fast
# push (permitted/protected/bare/wrong-remote/URL) timed out — generic-timeout block, not a policy decision
# (mission principles 3, 5, 6). fast0 only short-circuited the FORBIDDEN-NAME case.
#
# THE FIX: render the SAME tier verdict the heavy path would (AUTO-allow / CONFIRM-ask / BLOCK), here,
# using bash BUILTINS + the already-read committed config + AT MOST one bounded `git remote get-url` (the
# configured-remote slug, only when needed) + the existing bounded evidence gate (AUTO path only). The
# verdict CLASSES and diagnostics are identical to the heavy path (oracle-matched test). It can ONLY
# block a forbidden op, ask a consequential op, or allow a fully-safe evidence-fresh op — NEVER turn a
# heavy BLOCK/ASK into a silent allow.
#
# CONSERVATISM — engages ONLY when ALL hold; otherwise falls through 100% to the UNCHANGED heavy pipeline:
#   • the command CLEANLY parsed as a single git…push (_FAST_PARSED=1; no indirection / unknown global opt),
#   • committed .preflight/config.json was found + read (_FAST_CFG_TEXT non-empty),
#   • NO config.local.json overlay sits beside it (branch.remote/base are overlayable — if an overlay file
#     exists, defer to the heavy overlay-aware path so a per-clone topology correction is honored),
#   • push-gating is opted in (committed branch.remote is set — matches the heavy path's `-n "$REMOTE"` gate;
#     absent → additive-guard INERT, fall through),
#   • the target's verdict does not require resolving a NAMED remote's URL beyond one bounded git call.
if [ "$_FAST_PARSED" = 1 ] && [ -n "$_FAST_CFG_TEXT" ] && [ -n "$_FAST_CFG_DIR" ] \
   && [ ! -f "$_FAST_CFG_DIR/.preflight/config.local.json" ]; then
  _FD_REMOTE_CFG="$(_fast_json_scalar "$_FAST_CFG_TEXT" remote)"
  _FD_BASE="$(_fast_json_scalar "$_FAST_CFG_TEXT" base)"
  if [ -n "$_FD_REMOTE_CFG" ]; then     # push-gating opted in (mirror heavy path's REMOTE gate)
    _FD_FREPOS="$(_fast_json_array "$_FAST_CFG_TEXT" forbiddenRepos)"
    _FD_PRODP="$(_fast_json_array "$_FAST_CFG_TEXT" prodPatterns)"
    _FD_SAFE="$(_fast_json_array "$_FAST_CFG_TEXT" safeRemotes)"
    _FD_PROTECTED="main master"; [ -n "$_FD_BASE" ] && _FD_PROTECTED="$_FD_PROTECTED $_FD_BASE"
    # target branch: refspec dest after ':', else NOT cheaply knowable with builtins for the bare case →
    # but bare has no refspec and is handled as its own class below. For name/url with a refspec we use it;
    # with NO refspec (e.g. `git push poc`) the dest is the current branch — resolve with builtins (HEAD).
    _FD_TGT=""
    if [ -n "$_FAST_REFSPEC" ]; then _FD_TGT="${_FAST_REFSPEC##*:}"; fi
    _pfg_stage "fast-decision:enter(kind=$_FAST_KIND force=$_FAST_FORCE)"

    # Resolve current branch (for protected-branch checks when no explicit refspec dest) using BUILTINS:
    # read .git (gitdir-file aware) → HEAD → branch. A single bounded `git` fallback only if ambiguous.
    _fd_cur_branch() {
      local gd="$PWD/.git" head ref
      # .git may be a gitdir-pointer FILE (linked worktree) — follow it.
      if [ -f "$gd" ]; then
        local p; p="$(<"$gd")" 2>/dev/null; p="${p#gitdir: }"; p="${p%$'\r'}"; gd="$p"
      elif [ ! -d "$gd" ]; then gd="" ; fi
      [ -n "$gd" ] && [ -f "$gd/HEAD" ] || { printf '%s' ""; return; }
      head="$(<"$gd/HEAD")" 2>/dev/null; head="${head%$'\r'}"
      case "$head" in
        "ref: refs/heads/"*) printf '%s' "${head#ref: refs/heads/}" ;;   # on a branch — name only
        *) printf '%s' "" ;;                                               # detached → unknown (defer)
      esac
    }
    # Resolve the current branch for the protected-branch checks when there is no explicit refspec dest.
    # Needed for: named/url pushes with no refspec (push lands on current branch), AND a BARE push that is
    # a FORCE (force-to-protected must hard-block even with no positional remote — git would push the
    # current branch to its upstream). A bare NON-force push doesn't need it (it CONFIRMs regardless).
    if [ -z "$_FD_TGT" ] && { [ "$_FAST_KIND" != "bare" ] || [ "$_FAST_FORCE" = 1 ]; }; then
      _FD_TGT="$(_fd_cur_branch)"
      # If builtin HEAD resolution failed (detached / packed / odd worktree), do ONE bounded git call.
      if [ -z "$_FD_TGT" ]; then
        _FD_TGT="$(_pfg_git -C "$PWD" rev-parse --abbrev-ref HEAD 2>/dev/null | tr -d '\r' || true)"
        [ "$_FD_TGT" = "HEAD" ] && _FD_TGT=""   # still detached → unknown; protected-check will be skipped
      fi
    fi
    _fd_is_protected() { local b="$1" pb; [ -n "$b" ] || return 1; for pb in $_FD_PROTECTED; do [ "$b" = "$pb" ] && return 0; done; return 1; }

    case "$_FAST_KIND" in
      # ── (1) FORCE-PUSH to a protected branch → HARD BLOCK (exit 2), identical to heavy path (A). ──
      *)
        if [ "$_FAST_FORCE" = 1 ] && _fd_is_protected "$_FD_TGT"; then
          _pfg_stage "fast-decision:BLOCK-force-protected"
          echo "BLOCKED: force-push (--force/-f/--force-with-lease) to protected branch '$_FD_TGT'." >&2
          echo "  Shared branches must never be force-pushed — even --force-with-lease rewrites shared history." >&2
          echo "  (Agent Bash-tool guard only; not server-side protection — see docs/parity-gate-limitations.md.)" >&2
          exit 2
        fi ;;
    esac

    if [ "$_FAST_KIND" = "name" ]; then
      if [ "$_FAST_REMOTE" != "$_FD_REMOTE_CFG" ]; then
        # ── (4) named remote ≠ configured remote → CONFIRM (wrong-remote). ──
        _fast_emit_confirm "Push targets remote '$_FAST_REMOTE', not the configured remote '$_FD_REMOTE_CFG' (config.branch.remote). On an inverted clone the named remote may be a legacy production repo. Confirm this is the intended target. (Agent Bash-tool guard only; not server-side protection.)"
      else
        # ── (5) named remote == configured remote: resolve its slug for forbiddenRepos/prod/safelist. ──
        # ONE bounded `git remote get-url` (the only spawn on this path). If it wedges → fall through to heavy.
        _FD_URL="$(_pfg_git -C "$PWD" remote get-url "$_FAST_REMOTE" 2>/dev/null | tr -d '\r' || true)"
        if [ -f "$_PFG_WEDGE_FLAG" ]; then : ;   # a wedge → do NOT decide here; fall to heavy path
        else
          _FD_SLUG=""; [ -n "$_FD_URL" ] && _FD_SLUG="$(_fast_url_to_slug "$_FD_URL")"
          _FD_PROBE="${_FD_SLUG:-${_FD_URL:-$_FAST_REMOTE}}"
          if [ -n "$_FD_SLUG" ] && _fast_repo_forbidden "$_FD_SLUG" "$_FD_FREPOS"; then
            # forbiddenRepos is an EXPLICIT denylist → HARD BLOCK (exit 2), matching the heavy path's B0
            # check (which fires before the GAP-A prod CONFIRM). A denylisted slug is never merely-confirm.
            _pfg_stage "fast-decision:BLOCK-forbiddenRepos-slug"
            _fast_emit_forbidden_repo "$_FAST_REMOTE" "$_FD_SLUG"
          elif _fast_looks_prod "$_FD_PROBE" "$_FD_PRODP"; then
            _fast_emit_confirm "Push targets '$_FAST_REMOTE' (→ ${_FD_PROBE}), which matches a PRODUCTION-name pattern (prod/production/release/live/legacy/…). Even though it is the configured remote, a push to a prod-looking target must be a deliberate human confirmation, never silent. If this remote is actually safe, add it to config.branch.safeRemotes (or confirm to proceed). (Heuristic name match — agent Bash-tool guard only; not server-side protection.)"
          elif [ -n "$_FD_SAFE" ] && ! { _fast_in_list "$_FAST_REMOTE" "$_FD_SAFE" || { [ -n "$_FD_SLUG" ] && _fast_slug_on_safelist "$_FD_SLUG" "$_FD_SAFE"; }; }; then
            _fast_emit_confirm "Push targets '$_FAST_REMOTE' (→ ${_FD_PROBE}), which is NOT on config.branch.safeRemotes (strict-mode allowlist is enabled). AUTO is restricted to explicitly-blessed remotes; confirm this push, or add the remote to safeRemotes. (Agent Bash-tool guard only; not server-side protection.)"
          elif _fd_is_protected "$_FD_TGT"; then
            # ── (7) configured safe remote but PROTECTED target branch → CONFIRM. ──
            _fast_emit_confirm "Push lands on PROTECTED branch '$_FD_TGT' (a shared/integration branch). Confirm this is intended — safe topic-branch pushes proceed automatically, but a push to a protected branch is consequential. (Agent Bash-tool guard only; not server-side protection.)"
          else
            # ── (8) AUTO candidate: configured safe remote, unprotected branch, non-force. Run the
            #        existing evidence gate (REQUIRED for AUTO; it is bounded). Fresh → allow; else its block.
            _pfg_stage "fast-decision:AUTO-evidence-gate"
            _fast_run_evidence_then_allow
          fi
        fi
      fi
    elif [ "$_FAST_KIND" = "bare" ]; then
      # ── (6) bare `git push` (no named remote) → CONFIRM (unvalidatable target). ──
      _fast_emit_confirm "Bare 'git push' with no named remote — the target is UNVALIDATABLE (git's default/upstream remote, which the guard cannot see, may be the legacy production repo). Name the remote explicitly so it is checked, or confirm this push is intended. (Agent Bash-tool guard only; not server-side protection.)"
    elif [ "$_FAST_KIND" = "url" ]; then
      # ── (3) URL/scp/path target → resolve slug with BUILTINS (no git). forbiddenRepos → BLOCK; else
      #        it is by definition NOT the configured NAMED remote → CONFIRM (wrong-remote). ──
      _FD_SLUG="$(_fast_url_to_slug "$_FAST_TARGET")"
      if [ -n "$_FD_SLUG" ] && _fast_repo_forbidden "$_FD_SLUG" "$_FD_FREPOS"; then
        _pfg_stage "fast-decision:BLOCK-url-forbiddenRepos"
        echo "BLOCKED: push targets a FORBIDDEN destination '$_FAST_TARGET' (config.branch.forbiddenRemotes/forbiddenRepos)." >&2
        echo "  This remote is explicitly off-limits (e.g. a legacy production repo). Do NOT retarget automatically —" >&2
        echo "  surface to a human; see docs/parity-gate-limitations.md." >&2
        echo "  (Agent Bash-tool guard only; not server-side protection.)" >&2
        exit 2
      else
        _fast_emit_confirm "Push targets remote '$_FAST_TARGET', not the configured remote '$_FD_REMOTE_CFG' (config.branch.remote). On an inverted clone the named remote may be a legacy production repo. Confirm this is the intended target. (Agent Bash-tool guard only; not server-side protection.)"
      fi
    fi
    # If we reach here, the fast-decision path declined (e.g. a wedge during get-url) → heavy path decides.
  fi
fi

# ── (FAST-PR) builtins-first `gh pr create` decision (spawn-budget fix) ──────────────────────────────────
# The heavy pr-create guard (#3a) runs AFTER the continuation-normalize + full structural parser + several
# config/git spawns — so on this host a `gh pr create` candidate timed out (~27s) exactly like pushes did.
# Render the SAME verdict here with builtins + AT MOST one bounded `git remote get-url` (canonical slug),
# only when needed. CONSERVATIVE: engages only for a clearly-shaped leading `gh pr create` with committed
# config + no overlay; anything else falls through to the unchanged heavy #3a guard.
# Verdict classes (identical to #3a): explicit/default target slug on forbiddenRepos → BLOCK; target slug
# != canonical slug → BLOCK (non-canonical); else → ALLOW (gh pr create is not a push; nothing more to gate).
if printf '%s' "$COMMAND" | grep -qE '(^|&&|\|\||;|")[[:space:]]*gh[[:space:]]+pr[[:space:]]+create'; then
  _pfg_stage "fast-pr:enter"
  # Resolve+read committed config with builtins (reuse the FS-walk result if the push parse already did it).
  if [ -z "$_FAST_CFG" ]; then
    _fast_dir="$PWD"; _fast_n=0
    while [ -n "$_fast_dir" ] && [ "$_fast_n" -lt 64 ]; do
      if [ -f "$_fast_dir/.preflight/config.json" ]; then _FAST_CFG="$_fast_dir/.preflight/config.json"; _FAST_CFG_DIR="$_fast_dir"; break; fi
      case "$_fast_dir" in */*) _fast_dir="${_fast_dir%/*}"; [ -z "$_fast_dir" ] && _fast_dir="/" ;; *) break ;; esac
      [ "$_fast_dir" = "/" ] && { [ -f "/.preflight/config.json" ] && { _FAST_CFG="/.preflight/config.json"; _FAST_CFG_DIR="/"; }; break; }
      _fast_n=$((_fast_n+1))
    done
    [ -n "$_FAST_CFG" ] && { _FAST_CFG_TEXT="$(<"$_FAST_CFG")" 2>/dev/null || _FAST_CFG_TEXT=""; }
  fi
  if [ -n "$_FAST_CFG_TEXT" ] && [ -n "$_FAST_CFG_DIR" ] && [ ! -f "$_FAST_CFG_DIR/.preflight/config.local.json" ]; then
    # Extract the pr-create segment + an explicit --repo (builtins-only token walk, no grep/sed spawn).
    _FP_REPO_ARG=""
    _fp_oldifs="$IFS"; set -f
    # shellcheck disable=SC2086
    set -- $COMMAND
    set +f; IFS="$_fp_oldifs"
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --repo=*) _FP_REPO_ARG="${1#--repo=}"; break ;;
        --repo)   shift; _FP_REPO_ARG="${1:-}"; break ;;
        *) shift ;;
      esac
    done
    _FP_FREPOS="$(_fast_json_array "$_FAST_CFG_TEXT" forbiddenRepos)"
    _FP_CANON_REMOTE="$(_fast_json_scalar "$_FAST_CFG_TEXT" remote)"
    _FP_TARGET_SLUG=""; _FP_RESOLVED=1
    if [ -n "$_FP_REPO_ARG" ]; then
      _FP_TARGET_SLUG="$(_fast_url_to_slug "$_FP_REPO_ARG")"     # explicit --repo → builtins, no git
    else
      # no --repo → gh resolves the cwd default remote (origin). ONE bounded git call.
      _FP_DEF_URL="$(_pfg_git -C "$PWD" remote get-url origin 2>/dev/null | tr -d '\r' || true)"
      if [ -f "$_PFG_WEDGE_FLAG" ]; then _FP_RESOLVED=0; fi
      [ -n "$_FP_DEF_URL" ] && _FP_TARGET_SLUG="$(_fast_url_to_slug "$_FP_DEF_URL")"
    fi
    # canonical slug from configured remote (ONE bounded git call; only if we have a configured remote).
    _FP_CANON_SLUG=""
    if [ "$_FP_RESOLVED" = 1 ] && [ -n "$_FP_CANON_REMOTE" ]; then
      _FP_CANON_URL="$(_pfg_git -C "$PWD" remote get-url "$_FP_CANON_REMOTE" 2>/dev/null | tr -d '\r' || true)"
      if [ -f "$_PFG_WEDGE_FLAG" ]; then _FP_RESOLVED=0; fi
      [ -n "$_FP_CANON_URL" ] && _FP_CANON_SLUG="$(_fast_url_to_slug "$_FP_CANON_URL")"
    fi
    if [ "$_FP_RESOLVED" = 1 ]; then
      # (0) forbiddenRepos → BLOCK
      if [ -n "$_FP_TARGET_SLUG" ] && _fast_repo_forbidden "$_FP_TARGET_SLUG" "$_FP_FREPOS"; then
        _pfg_stage "fast-pr:BLOCK-forbiddenRepos"
        echo "BLOCKED: 'gh pr create' targets a FORBIDDEN repo '$_FP_TARGET_SLUG' (config.branch.forbiddenRepos)." >&2
        echo "  This destination is explicitly off-limits (e.g. a legacy production repo). Do NOT retarget automatically —" >&2
        echo "  surface to a human; see docs/parity-gate-limitations.md." >&2
        echo "  (Agent Bash-tool guard only; not server-side protection.)" >&2
        exit 2
      fi
      # (1) non-canonical → BLOCK
      if [ -n "$_FP_CANON_SLUG" ] && [ -n "$_FP_TARGET_SLUG" ] && [ "$_FP_TARGET_SLUG" != "$_FP_CANON_SLUG" ]; then
        _pfg_stage "fast-pr:BLOCK-non-canonical"
        if [ -n "$_FP_REPO_ARG" ]; then
          echo "BLOCKED: 'gh pr create --repo $_FP_REPO_ARG' targets a non-canonical repo (expected the configured target from config.branch.remote)." >&2
          echo "  On migration clones the wrong repo is often the legacy production repo. Do NOT assume the configured remote is safe —" >&2
          echo "  if the configured remote is itself wrong, surface to a human; see docs/parity-gate-limitations.md." >&2
        else
          echo "BLOCKED: 'gh pr create' has no --repo; it would resolve to '$_FP_TARGET_SLUG' (cwd default remote), not the configured target." >&2
          echo "  On migration clones the default 'origin' is often the legacy production repo. Confirm the intended repo with a human" >&2
          echo "  before retrying; see docs/parity-gate-limitations.md." >&2
        fi
        echo "  (Agent Bash-tool guard only; not server-side protection — see docs/parity-gate-limitations.md.)" >&2
        exit 2
      fi
      # canonical / not-forbidden / fail-open → ALLOW (gh pr create is not a push; nothing more to gate).
      _pfg_stage "fast-pr:ALLOW"
      exit 0
    fi
    # _FP_RESOLVED=0 (a get-url wedge) → fall through to the heavy #3a guard (which fails closed on wedge).
  fi
fi
_pfg_stage "fast0-done"

# ── (SCRIPT-WRAPPER INSPECTION) governed ops hidden inside a local script (mission Phase 4) ──────────────
# SECURITY GAP this closes: `bash /tmp/x.sh` (or sh/dash/zsh/source/.) hides any governed operation —
# `git push origin …`, `gh pr create`, a sentinel mint — INSIDE the file, invisible to the raw-command
# globs. The router now routes such shapes here; this stage READS the script's contents (BUILTINS ONLY —
# never executes, sources, or evals it), runs each logical line through the SAME policy detectors used for
# direct commands, and decides:
#   FORBIDDEN  → exit 2, naming the underlying operation + target (e.g. forbidden `git push origin`).
#   SAFE       → emit an explicit allow (+ a TOCTOU snapshot via updatedInput where the platform honors it,
#                so the inspected bytes are what execute) ONLY when EVERY line is on the narrow read-only
#                allowlist. This keeps a genuinely-safe script frictionless in bypassPermissions.
#   ASK        → permissionDecision:ask with a content-derived reason (local mutation, or a consequential
#                governed op the heavy push path would itself CONFIRM).
#   OPAQUE     → fail-CLOSED ask: contents could not be safely resolved (eval / command-substitution /
#                heredoc / function / loop / conditional / subshell / variable-built command / decode-exec /
#                nested-beyond-bound / oversize / unreadable / binary). NEVER a silent allow; the reason
#                instructs expanding the wrapper into directly-inspectable commands (no human-shell steering).
# CONSERVATISM: engages only for a confidently-shaped leading local-script execution with a READABLE regular
# file under the byte/nesting bounds; anything else (no resolvable readable script, or a wedge) falls
# through to the normal non-push exit (the command was not a governed direct op). It can never wrongly BLOCK
# an ordinary command, and never silent-allows an unresolved/forbidden script.
# HONESTY (CLAUDE.md rule 3): this is a LEXICAL, agent-Bash-tool-only analyzer. Determined obfuscation hits
# the OPAQUE fail-closed path, not a precise block — it raises the bar; the mechanical ceiling is still
# server-side. The auto-allow SAFE path's TOCTOU protection depends on the platform honoring updatedInput;
# where that is unconfirmed, the snapshot is still emitted (no worse than today if ignored).
_SW_MAXBYTES="${PREFLIGHT_SCRIPT_MAX_BYTES:-65536}"
_SW_MAXDEPTH="${PREFLIGHT_SCRIPT_MAX_DEPTH:-2}"
# Detect + resolve the leading local-script path (builtins). Echoes the path, or '' if not a script-exec
# shape we can resolve. Honors: optional env-prefixes, optional `command`, interpreter (bash/sh/dash/zsh
# [.exe], or a path ending in one), OR a `source`/`.` inclusion; then the FIRST non-flag token = script path.
_sw_resolve_script() {  # $1 = command string. Echoes: <resolved path> | '' (NOT a script shape) |
                        # '__UNRESOLVED__' (IS a script-exec shape but the path could not be resolved →
                        # caller fails CLOSED to ASK, never silent-allow).
  local cmd="$1" tok prog
  # join continuations (builtins).
  local _cr=$'\r' _lf=$'\n'; cmd="${cmd//$'\\'"$_cr$_lf"/ }"; cmd="${cmd//$'\\'"$_lf"/ }"
  local _oldifs="$IFS"; set -f; set -- $cmd; set +f; IFS="$_oldifs"
  local cwd="$PWD"
  # peel a leading `cd DIR &&`/`;` (one level) so a relative script path resolves in the right dir.
  if [ "${1:-}" = "cd" ] && [ -n "${2:-}" ]; then
    local d="$2"; d="${d%[\"\']}"; d="${d#[\"\']}"; [ -d "$cwd/$d" ] && cwd="$cwd/$d"; [ -d "$d" ] && cwd="$d"
    shift 2; while [ "$#" -gt 0 ]; do case "$1" in '&&'|';'|'|') shift; break ;; *) shift ;; esac; done
  fi
  while [ "$#" -gt 0 ]; do
    case "$1" in [A-Za-z_]*=*) shift ;; command) shift ;; *) break ;; esac
  done
  [ "$#" -gt 0 ] || { printf ''; return; }
  prog="$1"
  case "${prog##*/}" in
    bash|bash.exe|sh|sh.exe|dash|dash.exe|zsh|zsh.exe) shift ;;   # interpreter → script is next non-flag
    *) case "$prog" in
         source|.) shift ;;                                       # source/dot inclusion
         *) printf ''; return ;;                                  # not a script-exec program → NOT our shape
       esac ;;
  esac
  # From here it is a script-exec shape. Find the first non-flag token after the interpreter = the script
  # path. `-c <code>` is inline code (not a file) → not our shape. NO positional at all (`bash`,
  # `bash --version`, `bash -x`) → runs no script file → NOT our shape (return '' → benign).
  local _had_flag=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -c|-o) printf ''; return ;;   # inline code, not a script file
      --) shift; break ;;
      -*) _had_flag=1; shift ;;
      *) break ;;
    esac
  done
  [ "$#" -gt 0 ] || { printf ''; return; }   # interpreter with only flags / nothing → not a script exec
  tok="$1"; tok="${tok%[\"\']}"; tok="${tok#[\"\']}"
  # (a) direct resolution of the (possibly-unquoted) token.
  if [ -f "$tok" ]; then printf '%s' "$tok"; return; fi
  if [ -f "$cwd/$tok" ]; then printf '%s' "$cwd/$tok"; return; fi
  # (b) QUOTED PATH WITH SPACES: the word-split broke `'with space/x.sh'` into pieces. Recover the quoted
  #     segment from the RAW command via builtin parameter expansion (no eval). If it resolves, use it; if a
  #     quoted run EXISTS but is unreadable, that is a script we cannot inspect → __UNRESOLVED__ (fail closed).
  local q=""
  case "$cmd" in
    *\'*\'*) q="${cmd#*\'}"; q="${q%%\'*}" ;;          # first single-quoted run
    *\"*\"*) q="${cmd#*\"}"; q="${q%%\"*}" ;;          # first double-quoted run
  esac
  if [ -n "$q" ]; then
    [ -f "$q" ] && { printf '%s' "$q"; return; }
    [ -f "$cwd/$q" ] && { printf '%s' "$cwd/$q"; return; }
    # a quoted path was present but unresolved (e.g. spaces + missing) → we cannot inspect a script that may
    # exist under odd quoting → fail closed.
    printf '__UNRESOLVED__'; return
  fi
  # An UNQUOTED path token that simply does not exist on disk: this command will fail at runtime with no
  # script to run — there is no hidden governed op to inspect, and it is not a bypass risk. Treat as benign
  # (return '') rather than nag. (A REAL hidden-op script must exist to be executed; a nonexistent path
  # executes nothing.)
  printf ''
}
# Classify ONE logical script line (builtins only). Echoes: SAFE | MUT:<verb> | GITPUSH:<args> |
# GHPR:<args> | SENTINEL | OPAQUE:<why>. Conservative: anything not understood → OPAQUE.
_sw_classify_line() {  # $1 = line
  local line="$1"
  line="${line#"${line%%[![:space:]]*}"}"           # ltrim
  case "$line" in ''|'#'*) echo SAFE; return ;; esac
  # ── dynamic / unresolved constructs → OPAQUE (never silent-allow) ──
  case "$line" in *'$('*|*'`'*) echo "OPAQUE:command-substitution"; return ;; esac
  case "$line" in 'eval '*|*' eval '*|*';eval '*) echo "OPAQUE:eval"; return ;; esac
  case "$line" in *'<<'*) echo "OPAQUE:heredoc"; return ;; esac
  case "$line" in *'() {'*|*'(){'*|'function '*) echo "OPAQUE:function-def"; return ;; esac
  case "$line" in 'for '*|'while '*|'until '*|'if '*|'elif '*|'case '*|*'; do'*|*'; then'*|*' do '*) echo "OPAQUE:control-flow"; return ;; esac
  case "$line" in '('*|*'&& ('*|*'|('*|*'| ('*) echo "OPAQUE:subshell"; return ;; esac
  case "$line" in *'base64'*'|'*|*'| base64'*|*'xxd '*|*'| bash'*|*'| sh'*|*'|bash'*|*'|sh'*) echo "OPAQUE:decode-or-pipe-to-shell"; return ;; esac
  # nested local-script execution → caller recurses (depth-bounded).
  case "$line" in
    bash\ [!-]*|sh\ [!-]*|dash\ [!-]*|zsh\ [!-]*|'source '[!-]*|'. '[!-]*) echo "NESTED:$line"; return ;;
  esac
  # word-split (no glob/expansion) to find the leading program after env/command prefixes.
  local _oldifs="$IFS"; set -f; set -- $line; set +f; IFS="$_oldifs"
  while [ "$#" -gt 0 ]; do case "$1" in [A-Za-z_]*=*) shift ;; command) shift ;; *) break ;; esac; done
  [ "$#" -gt 0 ] || { echo SAFE; return; }
  local p0="$1"
  # variable-built command name / governed-arg → OPAQUE.
  case "$line" in *'git '*'$'*|*'$'*' push'*|*'$'*' pr '*) echo "OPAQUE:variable-built"; return ;; esac
  # sentinel mint shapes (redirection/write into a protected sentinel path) → SENTINEL (delegates to the
  # existing tripwire wording downstream is complex; here we just flag it OPAQUE-style ASK via SENTINEL).
  case "$line" in *.preflight/gate/parity-clean*|*.preflight/gate/bootstrap-write-approved*) echo "SENTINEL"; return ;; esac
  # git push?
  case "${p0#\\}" in
    git|git.exe|*/git|*/git.exe)
      case " $line " in *' push '*|*' push') echo "GITPUSH:$line"; return ;; esac
      # non-push git: read-only subset SAFE, else OPAQUE
      case " $line " in *' status'*|*' diff'*|*' log'*|*' show'*|*' rev-parse'*|*' branch'*|*' remote '*|*' config '*|*' fetch'*) echo SAFE; return ;; esac
      echo "OPAQUE:git-subcommand"; return ;;
  esac
  # gh pr ...?
  case "$p0" in gh|gh.exe) case " $line " in *' pr '*) echo "GHPR:$line"; return ;; *) echo SAFE; return ;; esac ;; esac
  # read-only command allowlist → SAFE
  case "$p0" in echo|printf|true|false|:|ls|cat|head|tail|grep|egrep|fgrep|sort|uniq|wc|pwd|dirname|basename|test|'['|date|sleep|env|export|set|cd|which|type|id|whoami|hostname|uname) echo SAFE; return ;; esac
  # known LOCAL-MUTATION verbs (no remote) → MUT
  case "$p0" in rm|mv|cp|touch|mkdir|rmdir|sed|tee|chmod|chown|install|truncate|dd|ln|cat) echo "MUT:$p0"; return ;; esac
  case "$line" in *' > '*|*' >> '*|*'>'*) echo "MUT:redirect-write"; return ;; esac
  echo "OPAQUE:unknown-command-${p0}"
}
# Inspect a script FILE → echoes "VERDICT|detail". Bounded; never executes/sources. Recurses on NESTED.
_sw_inspect() {  # $1 = path ; $2 = depth
  local f="$1" depth="${2:-0}"
  [ -r "$f" ] || { echo "OPAQUE|unreadable-or-missing"; return; }
  [ -f "$f" ] || { echo "OPAQUE|not-a-regular-file"; return; }
  local bytes; bytes="$(wc -c < "$f" 2>/dev/null | tr -d ' ' || echo 999999999)"
  case "$bytes" in ''|*[!0-9]*) bytes=999999999 ;; esac
  [ "$bytes" -gt "$_SW_MAXBYTES" ] && { echo "OPAQUE|exceeds-byte-cap(${bytes}>${_SW_MAXBYTES})"; return; }
  [ "$depth" -gt "$_SW_MAXDEPTH" ] && { echo "OPAQUE|exceeds-nesting-depth"; return; }
  # binary content? a NUL byte → not a text script we can analyze → fail closed.
  # binary content? Detect a NUL byte. (Git-Bash `grep`'s NUL byte-class is unreliable, and `$(<f)` silently
  # truncates at a NUL — so we use a bounded `od` scan: any standalone `00` byte token → binary → fail closed.
  # Match `00` as a WHOLE space-delimited token (not a substring of e.g. `a0 0b`) to avoid false positives.)
  if command -v od >/dev/null 2>&1; then
    if od -An -tx1 "$f" 2>/dev/null | grep -qiwE '00'; then echo "OPAQUE|binary-content"; return; fi
  fi
  local content line v worst="SAFE" detail="" mut=0
  content="$(<"$f")" 2>/dev/null || { echo "OPAQUE|unreadable"; return; }
  content="${content//$'\\'$'\n'/ }"   # join line-continuations (builtins)
  while IFS= read -r line || [ -n "$line" ]; do
    v="$(_sw_classify_line "$line")"
    case "$v" in
      SAFE) ;;
      GITPUSH:*)
        # Re-use the push policy: a forbidden remote/repo → FORBIDDEN; otherwise a push is consequential → ASK.
        local pa="${v#GITPUSH:}" rem
        rem="$(_sw_push_remote "$pa")"
        if [ -n "$rem" ] && _sw_remote_or_repo_forbidden "$rem"; then
          echo "FORBIDDEN|script contains \`git push $rem …\`; destination '$rem' is forbidden by committed policy"; return
        fi
        worst="ASK"; detail="contains a 'git push' (consequential — target '${rem:-?}')" ;;
      GHPR:*)
        worst="ASK"; detail="contains a 'gh pr create' (consequential)" ;;
      SENTINEL)
        echo "FORBIDDEN|script mints a HUMAN-ONLY gate-clearance sentinel (parity-clean/bootstrap-write-approved)"; return ;;
      MUT:*) mut=$((mut+1)); [ "$worst" = SAFE ] && worst="ASK"; detail="local mutating operation(s) (e.g. ${v#MUT:})" ;;
      NESTED:*)
        local inner; inner="$(_sw_resolve_script "${v#NESTED:}")"
        if [ -n "$inner" ]; then
          local sub; sub="$(_sw_inspect "$inner" $((depth+1)))"
          case "$sub" in
            FORBIDDEN*) echo "$sub (via nested script)"; return ;;
            OPAQUE*)    worst="OPAQUE"; detail="nested: ${sub#OPAQUE|}" ;;
            ASK*)       [ "$worst" = SAFE ] && worst="ASK"; detail="nested consequential op" ;;
          esac
        else
          worst="OPAQUE"; detail="nested script path not resolvable"
        fi ;;
      OPAQUE:*) worst="OPAQUE"; detail="${v#OPAQUE:} (line: $(printf '%s' "$line" | cut -c1-40))" ;;
    esac
  done < "$f"
  case "$worst" in
    SAFE)   echo "SAFE|all lines on the read-only allowlist" ;;
    ASK)    echo "ASK|$detail" ;;
    OPAQUE) echo "OPAQUE|$detail" ;;
  esac
}
# Extract the push remote (first positional) from a 'git … push …' line (builtins).
_sw_push_remote() {  # $1 = line ; echoes remote token or ''
  local _oldifs="$IFS"; set -f; set -- $1; set +f; IFS="$_oldifs"
  local seen_push=0 tok
  for tok in "$@"; do
    if [ "$seen_push" = 1 ]; then
      case "$tok" in -*|+*) ;; *) printf '%s' "$tok"; return ;; esac
    fi
    [ "$tok" = push ] && seen_push=1
  done
  printf ''
}
# Is a push remote NAME forbidden, OR (for a URL) its slug on forbiddenRepos? (builtins; reuses fast readers)
_sw_remote_or_repo_forbidden() {  # $1 = remote name or URL
  local r="$1"
  [ -n "$_SW_CFG_TEXT" ] || return 1
  # name on forbiddenRemotes
  _fast_in_list "$r" "$(_fast_json_array "$_SW_CFG_TEXT" forbiddenRemotes)" && return 0
  # URL/scp/path → slug on forbiddenRepos
  case "$r" in *://*|*@*:*|*/*) local s; s="$(_fast_url_to_slug "$r")"; [ -n "$s" ] && _fast_repo_forbidden "$s" "$(_fast_json_array "$_SW_CFG_TEXT" forbiddenRepos)" && return 0 ;; esac
  return 1
}
_SW_PATH="$(_sw_resolve_script "$COMMAND")"
if [ "$_SW_PATH" = "__UNRESOLVED__" ]; then
  # A local-script execution shape was detected, but the script file could not be resolved/read (e.g. an
  # odd-quoted path, a missing file behind a wrapper, or a path the builtin resolver could not recover).
  # FAIL CLOSED to a human confirmation — never silent-allow a script we could not inspect.
  _pfg_stage "script-inspect:UNRESOLVED"
  printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"ask","permissionDecisionReason":%s}}\n' \
    "$(printf '%s' "CONFIRM (fail-closed): a local script is being executed but its contents could not be resolved for inspection. Rather than approve an opaque wrapper, run the underlying steps as explicit, directly-inspectable commands so the gate can adjudicate each one." | _pfg_json_string)"
  exit 0
fi
if [ -n "$_SW_PATH" ]; then
  _pfg_stage "script-inspect:resolved=$_SW_PATH"
  # committed config text for the in-script push policy (builtins; reuse fast walk result if present).
  _SW_CFG_TEXT="${_FAST_CFG_TEXT:-}"
  if [ -z "$_SW_CFG_TEXT" ]; then
    _sw_dir="$PWD"; _sw_n=0
    while [ -n "$_sw_dir" ] && [ "$_sw_n" -lt 64 ]; do
      [ -f "$_sw_dir/.preflight/config.json" ] && { _SW_CFG_TEXT="$(<"$_sw_dir/.preflight/config.json")" 2>/dev/null; break; }
      case "$_sw_dir" in */*) _sw_dir="${_sw_dir%/*}"; [ -z "$_sw_dir" ] && _sw_dir="/" ;; *) break ;; esac
      [ "$_sw_dir" = "/" ] && break; _sw_n=$((_sw_n+1))
    done
  fi
  _SW_VERDICT="$(_sw_inspect "$_SW_PATH" 0)"
  _pfg_stage "script-inspect:verdict=${_SW_VERDICT%%|*}"
  _sw_v="${_SW_VERDICT%%|*}"; _sw_d="${_SW_VERDICT#*|}"
  case "$_sw_v" in
    FORBIDDEN)
      echo "BLOCKED: $_sw_d." >&2
      echo "  The governed operation is hidden inside the script '$_SW_PATH' — inspected without executing it." >&2
      echo "  Surface to a human; do NOT retarget automatically. (Agent Bash-tool guard only; not server-side" >&2
      echo "  protection — see docs/parity-gate-limitations.md.)" >&2
      exit 2 ;;
    SAFE)
      # Emit a TOCTOU snapshot of the inspected bytes + allow. If the platform honors updatedInput, the
      # snapshot (immutable inspected bytes) is what executes; if not, normal flow applies (no worse than
      # today). Snapshot under TMPDIR, mode 0600.
      _SW_SNAP="$(mktemp 2>/dev/null).preflight-inspected.sh" || _SW_SNAP=""
      if [ -n "$_SW_SNAP" ] && cat "$_SW_PATH" > "$_SW_SNAP" 2>/dev/null; then
        chmod 0600 "$_SW_SNAP" 2>/dev/null || true
        printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"allow","permissionDecisionReason":%s,"updatedInput":{"command":%s}}}\n' \
          "$(printf '%s' "Inspected local script '$_SW_PATH': all operations are read-only/safe. Executing an inspected snapshot (TOCTOU-safe)." | _pfg_json_string)" \
          "$(printf '%s' "bash $_SW_SNAP" | _pfg_json_string)"
      else
        printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"allow","permissionDecisionReason":%s}}\n' \
          "$(printf '%s' "Inspected local script '$_SW_PATH': all operations are read-only/safe." | _pfg_json_string)"
      fi
      exit 0 ;;
    ASK)
      printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"ask","permissionDecisionReason":%s}}\n' \
        "$(printf '%s' "CONFIRM: local script '$_SW_PATH' performs $_sw_d. No forbidden destination was detected, but the action is consequential — confirm to proceed. (Inspected without executing the script.)" | _pfg_json_string)"
      exit 0 ;;
    OPAQUE)
      printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"ask","permissionDecisionReason":%s}}\n' \
        "$(printf '%s' "CONFIRM (fail-closed): local script '$_SW_PATH' could not be safely resolved by inspection ($_sw_d). Rather than approve an opaque wrapper, EXPAND the operation into directly-inspectable commands (run the underlying steps explicitly) so the gate can adjudicate each one. (Inspected without executing the script.)" | _pfg_json_string)"
      exit 0 ;;
  esac
  # No verdict matched (shouldn't happen) → fall through to normal handling.
fi

# ── SENTINEL-MINT TRIPWIRE (gap #5) ───────────────────────────────────────────
# Blocks, for the AGENT's Bash tool, shell commands that MINT the two protected
# gate-clearance sentinels:
#   .preflight/gate/bootstrap-write-approved  (human lead approval to overwrite
#                                              CLAUDE.md/.preflight/config.json)
#   .preflight/gate/parity-clean              (human-only parity clearance —
#                                              by convention, see
#                                              docs/parity-gate-limitations.md)
# Write-shaped references trip it: redirection into the sentinel path; a write
# verb (tee/touch/cp/mv/install/dd/truncate) taking the path as an argument;
# sed -i on the path; and ANY `write-gate-evidence parity-clean` invocation
# (parity-clean is the one evidence name an agent must never write — tests-pass/
# stage1-clean/map-validated remain legitimate agent evidence and pass).
# Read-shaped references (cat/ls/grep on the paths) pass.
#
# HONESTY LABEL: this is a HEURISTIC pattern tripwire on the agent Bash tool
# only — bypassable via obfuscation (variables, base64, python -c, etc.); it
# raises effort, not impossibility. The mechanical ceiling remains server-side
# (required reviewers / branch protection) — see docs/parity-gate-limitations.md.
# ADDITIVE + EARLY by design: runs before all push/pr-create routing and never
# touches the config-overlay/guard logic below.
_TRIP_SENT='\.preflight[/\\]+gate[/\\]+(bootstrap-write-approved|parity-clean)'
_TRIP_PRE='(^|[;&|([:space:]`])'
_trip_block() {
  echo "BLOCKED: agent must not mint gate-clearance evidence ($1)." >&2
  echo "  Bootstrap approval and parity-clean are HUMAN-ONLY governance evidence — by design they are created" >&2
  echo "  by a human reviewer performing the approval/clearance step, never synthesized by the agent. Surface" >&2
  echo "  the request to a human reviewer for that decision. (This is human-only CLEARANCE evidence, not an" >&2
  echo "  operation the agent may route around.) See docs/parity-gate-limitations.md." >&2
  echo "  (HEURISTIC agent Bash-tool tripwire only — not server-side protection.)" >&2
  exit 2
}
if printf '%s' "$COMMAND" | grep -qE "$_TRIP_SENT"; then
  # (a) redirection (> or >>) targeting a protected sentinel path
  if printf '%s' "$COMMAND" | grep -qE ">>?[[:space:]]*[\"']?[^[:space:]\"';|&]*${_TRIP_SENT}"; then
    _trip_block "shell redirection into a protected sentinel path"
  fi
  # (b) write verb taking the sentinel path as an argument
  if printf '%s' "$COMMAND" | grep -qE "${_TRIP_PRE}(tee|touch|cp|mv|install|dd|truncate)[[:space:]][^;|&]*${_TRIP_SENT}"; then
    _trip_block "write command targeting a protected sentinel path"
  fi
  # (c) in-place sed on the sentinel path
  if printf '%s' "$COMMAND" | grep -qE "${_TRIP_PRE}sed[[:space:]][^;|&]*${_TRIP_SENT}" \
     && printf '%s' "$COMMAND" | grep -qE "sed[[:space:]][^;|&]*(-[a-zA-Z]*i|--in-place)"; then
    _trip_block "in-place sed on a protected sentinel path"
  fi
fi
# (d) write-gate-evidence invoked with the human-only gate name, any path form
if printf '%s' "$COMMAND" | grep -qE "write-gate-evidence[\\\\\\\"]?[[:space:]]+[\\\\\\\"]?parity-clean"; then
  _trip_block "'write-gate-evidence parity-clean' — parity-clean is human-only"
fi
# (e) OBVIOUS OBFUSCATION PATTERNS targeting sentinel paths (raise-the-bar layer).
# An agent that already knows the sentinel format can still mint it via shell
# obfuscation; this catches the plain-shaped obfuscations without raising
# false positives on legitimate commands. HEURISTIC — bypassable by determined
# obfuscation; the mechanical ceiling remains server-side.
if printf '%s' "$COMMAND" | grep -qE "$_TRIP_SENT"; then
  # base64 decode into sentinel
  if printf '%s' "$COMMAND" | grep -qE "(base64[[:space:]]+(-d|--decode)|python[[:space:]]+-c[[:space:]]*[\\\\\\\"]*base64).*${_TRIP_SENT}"; then
    _trip_block "obfuscated base64 decode into protected sentinel path"
  fi
  # variable/parameter expansion writing sentinel. NB: the dollar is written as the regex char-class
  # [$], NOT a bare `\$[`. In a double-quoted string `"\$[..."` collapses to `$[...`, which bash parses
  # as LEGACY ARITHMETIC EXPANSION `$[expr]` — under `set -u` it then evaluates the first regex atom
  # (`A`) as an unbound variable (warning to stderr) AND corrupts the pattern so the variable-expansion
  # obfuscation branch NEVER MATCHED (a silent fail-open in this tripwire). `[$]` matches a literal `$`
  # and cannot start an arithmetic expansion, fixing both the noise and the missed match.
  if printf '%s' "$COMMAND" | grep -qE "([\$][A-Za-z_][A-Za-z0-9_]*|[\$]\\{[A-Za-z_][A-Za-z0-9_]*\\})[[:space:]]*>[[:space:]]*[\\\\\\\"]?[^[:space:]\\\\\\\"]*${_TRIP_SENT}"; then
    _trip_block "variable-expanded write into protected sentinel path"
  fi
  # python -c / eval with explicit sentinel path string
  if printf '%s' "$COMMAND" | grep -qE "(python[[:space:]]+-c|perl[[:space:]]+-e|node[[:space:]]+-e)[[:space:]]*[\\\\\\\"][^\\\\\\\"]*${_TRIP_SENT}"; then
    _trip_block "script-eval write into protected sentinel path"
  fi
  # command substitution writing sentinel
  if printf '%s' "$COMMAND" | grep -qE "(\\$\\([^)]*\\)|\\\`[^\\\`]*\\\`)[[:space:]]*>[[:space:]]*[\\\\\\\"]?[^[:space:]\\\\\\\"]*${_TRIP_SENT}"; then
    _trip_block "command-substitution write into protected sentinel path"
  fi
fi
# ── end sentinel-mint tripwire ────────────────────────────────────────────────

# ── REPO-AWARENESS (NEW-2 fix) ────────────────────────────────────────────────
# This guard must resolve config + canonical remote from the repo the push
# ACTUALLY targets, NOT the session root. A session rooted in repo A (e.g. a
# consumer with config.branch.remote=poc) that pushes repo B (e.g. the framework
# source repo, whose canonical origin differs) must read B's config — otherwise A's
# config false-blocks B's legitimate push (the observed NEW-2 over-block: it blocked
# a verified-safe `cd <framework-repo> && git push origin <branch>`).
#
# Signal: honor a leading `cd <dir>` in the command (the compound `cd X && git push`
# pattern the agent commonly emits — and exactly the shape that was false-blocked),
# else fall back to the hook's own cwd (= session root, which is correct for an
# in-repo push: a consumer pushing its own `origin`=legacy-prod SHOULD still block).
# A repo with no .preflight/config.json → fail-open (unchanged additive posture).
_pfg_target_cwd() {  # $1 = command string; echo the cwd the git command runs in. Always returns 0.
  local cmd="$1" cwd cd_dir
  cwd="$(pwd)"
  if printf '%s' "$cmd" | grep -qE '(^|;|&&|\|)[[:space:]]*cd[[:space:]]'; then
    cd_dir="$(printf '%s' "$cmd" | grep -oE '(^|;|&&|\|)[[:space:]]*cd[[:space:]]+[^&|;]+' | head -1 | sed -E 's/.*cd[[:space:]]+//; s/[[:space:]]+$//')"
    # strip one layer of surrounding quotes
    cd_dir="${cd_dir%[\"\']}"; cd_dir="${cd_dir#[\"\']}"
    if [ -n "$cd_dir" ] && [ -d "$cd_dir" ]; then cwd="$cd_dir"; fi
  fi
  printf '%s' "$cwd"
  return 0
}
# The cwd the push/pr-create command will execute in (repo-aware anchor for ALL
# config + git resolution below). Computed ONCE from the command string.
PFG_TARGET_CWD="$(_pfg_target_cwd "$COMMAND")"

# ── STRUCTURAL PUSH PARSER (H1+H2 fix) ─────────────────────────────────────────
# Replaces the old single-regex detector AND the old grep extractor, which BOTH required the literal
# adjacency `git\s+push` — so `git -C <dir> push`, `git -c k=v push`, `command git push`, `\git push`,
# `GIT_DIR=… git push`, `/usr/bin/git push`, a subshell `(git push …)`, etc. ALL evaded the gate (H2: 17
# of 21 forms bypassed; see .release-audit/H2-FIX-DESIGN.md). The fix PARSES the invocation structurally,
# mirroring git's own option grammar, instead of pattern-matching one surface spelling.
#
# It sets these globals (read by the classification body below):
#   _PFG_IS_PUSH        = 1 if a `git … push` invocation was found, else 0.
#   _PFG_PUSH_UNRESOLVED= 1 if a push is PRESENT but could not be cleanly parsed into an arg list
#                         (an indirection wrapper: eval/bash -c/sh -c/xargs git push) → FAIL CLOSED to
#                         CONFIRM downstream, never a silent allow. 0 when the args were parsed cleanly.
#   _PFG_PUSH_ARGS      = the parsed push arg list (tokens AFTER `push`), space-joined, when resolved.
#
# Method (per the design's Option B): segment the command on shell separators the hook can SEE
# (; && || | and a leading ( { and the if/then/while/do/else keywords), then for each segment:
#   strip leading VAR=val env-assignments and a `command`/`\` prefix → match the program token as
#   git | */git | */git.exe | \git → skip the global-option run via a small option table (separate-value
#   opts -C/-c/--git-dir/--work-tree/--namespace/--super-prefix consume the NEXT token; =-joined and bare
#   flags are single tokens) → if the next token is `push`, the rest are the push args.
# NOTE: this tokenizes by WORD-SPLITTING ONLY (set -f + IFS); it NEVER eval/executes the command.
_PFG_IS_PUSH=0
_PFG_PUSH_UNRESOLVED=0
_PFG_PUSH_ARGS=""
# Is $1 a git program token? (git, */git, */git.exe, with an optional leading backslash for `\git`.)
_pfg_is_git_prog() {
  case "${1#\\}" in
    git|git.exe) return 0 ;;
    */git|*/git.exe) return 0 ;;
    *) return 1 ;;
  esac
}
# Does the segment's git invocation reach a `push` subcommand? Parses ONE already-tokenized arg vector
# ("$@" = the segment's words). Echoes the push args (tokens after `push`) on success; return 0 = push
# found+parsed, 1 = not a push, 2 = git-push present but the program/subcommand could not be resolved.
_pfg_seg_push_args() {
  # Strip leading env-assignments (VAR=val) and a `command` prefix (repeatable).
  while [ "$#" -gt 0 ]; do
    case "$1" in
      [A-Za-z_]*=*) shift ;;       # env-assignment prefix → skip
      command)      shift ;;       # `command git …` → skip the `command` builtin
      *) break ;;
    esac
  done
  [ "$#" -gt 0 ] || return 1
  _pfg_is_git_prog "$1" || return 1
  shift                            # consume the git program token
  # Skip the global-option run (mirrors git's option grammar). Separate-value options consume the NEXT
  # token; =-joined and bare flags are single tokens; the subcommand is the first NON-option token.
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -C|--git-dir|--work-tree|--namespace|--super-prefix|--exec-path)
        # separate-value form: consume the option AND its value token (if present).
        shift; [ "$#" -gt 0 ] && shift ;;
      -c|--config-env)
        shift; [ "$#" -gt 0 ] && shift ;;
      --git-dir=*|--work-tree=*|--namespace=*|--super-prefix=*|--exec-path=*|--config-env=*|-c=*)
        shift ;;                   # =-joined value: single token
      -p|--paginate|-P|--no-pager|--bare|--no-replace-objects|--no-lazy-fetch|--no-optional-locks|--no-advice|--literal-pathspecs|--glob-pathspecs|--noglob-pathspecs|--icase-pathspecs|--html-path|--man-path|--info-path|--no-renames)
        shift ;;                   # bare global flags: single token
      -[A-Za-z]*|--*)
        # an UNKNOWN global option before the subcommand. We cannot know if it consumes the next token,
        # so we cannot safely locate the subcommand → treat as unresolved (fail-closed) rather than guess.
        return 2 ;;
      *) break ;;                  # first non-option token = the subcommand
    esac
  done
  [ "$#" -gt 0 ] || return 1       # no subcommand → not a push
  if [ "$1" = "push" ]; then
    shift                          # consume `push`; the rest are the push args
    _pfg_seg_push_out="$*"
    return 0
  fi
  return 1                         # some other subcommand (status/commit/log/…) → not a push
}
_pfg_parse_push() {  # $1 = the full command string. Sets the _PFG_* globals. Always returns 0.
  local cmd="$1"
  local _orig_cmd="$1"   # pre-normalization copy, for the fail-closed unresolved-continuation backstop
  # (0) SHELL LINE-CONTINUATION normalization (live Gate-4 incident fix). A backslash immediately before a
  # newline (`\`+LF, or `\`+CRLF on Windows) is a SHELL line-continuation: the shell joins the two physical
  # lines into ONE logical command. The structural parser below segments by reading $norm LINE BY LINE, so
  # WITHOUT this join a continuation splits e.g.
  #     git -c remote.origin.url=file:///probe \   (has `git`, NO `push`)
  #     push origin HEAD:refs/heads/x              (has `push`, NO `git`)
  # into two segments, neither a `git…push` → _PFG_IS_PUSH stayed 0 → ALLOW (the security-significant
  # fail-open that let a real push reach its configured remote). Join continuations FIRST so `git` and
  # `push` remain one logical command. NARROW by construction: this ONLY removes a backslash that is
  # immediately followed by an (optional CR +) LF — the exact shell continuation sequence; it touches no
  # other backslash. A backslash NOT followed by a newline (e.g. a Windows path, an escaped char) is left
  # untouched. After joining we collapse the run of whitespace the continuation leaves so the segment word-
  # splits cleanly. We do NOT attempt to honor continuations inside single/double quotes (where the shell
  # would NOT treat `\`+LF as a continuation) — joining there can only ever make detection MORE inclusive
  # (more likely to see a push), i.e. it can over-detect (→ CONFIRM/UNRESOLVED, fail-closed) but never
  # under-detect, so it cannot reintroduce a fail-open. The NFP tests confirm benign multiline commands are
  # not turned into spurious hard-blocks.
  # IMPLEMENTATION: slurp the WHOLE command into one awk record (RS set to the NUL-ish 0x1C separator, which
  # never appears in a shell command) and gsub every `\`+(optional CR)+LF + following horizontal whitespace
  # to a single space. awk (already a core engine dependency) avoids the backslash-quoting ambiguity that
  # makes a line-by-line sed for this fragile, and handles multi-line input in one pass. If awk is somehow
  # unavailable the value is unchanged — the existing eval/indirection check + per-segment parse still run,
  # and a continuation-split push that cannot be resolved falls to the UNRESOLVED/CONFIRM fail-closed path
  # below (never a silent allow): see the explicit unresolved-continuation guard after the segment loop.
  if command -v awk >/dev/null 2>&1; then
    cmd="$(printf '%s' "$cmd" | awk 'BEGIN{RS="\034"} { gsub(/\\\r?\n[ \t]*/," "); printf "%s", $0 }')"
  fi
  # (1) Indirection wrappers the static parser cannot see INTO: if the command invokes eval / bash -c /
  # sh -c / xargs AND the literal tokens `git` … `push` appear in order somewhere, a push may be assembled
  # at runtime → mark PRESENT-but-UNRESOLVED (fail-closed CONFIRM), do not try to parse it.
  if printf '%s' "$cmd" | grep -qE '(^|[^[:alnum:]_-])(eval|xargs)([^[:alnum:]_-]|$)' \
     || printf '%s' "$cmd" | grep -qE '(^|[^[:alnum:]_-])(bash|sh|zsh|dash)[[:space:]]+-[a-z]*c([[:space:]]|$)'; then
    # Ordered git…push token check (NOT mere co-occurrence — see the no-false-positive boundary): a git
    # program token, then a `push` token later. Word-bounded so `push-docs`/`git commit -m '…push…'` are
    # not mistaken for a push subcommand.
    if printf '%s' "$cmd" | grep -qE '(^|[^[:alnum:]/_.-])\\?([^[:space:]]*/)?git(\.exe)?([^[:alnum:]_-].*)?[[:space:]]push([[:space:]]|$)'; then
      _PFG_IS_PUSH=1; _PFG_PUSH_UNRESOLVED=1; _PFG_PUSH_ARGS=""
      return 0
    fi
  fi
  # (2) Structural parse: segment on shell separators the hook can see, parse each segment.
  # Replace separators (; && || | newline) and leading group/keyword tokens with a sentinel newline, then
  # iterate segments. set -f disables globbing during the deliberate word-split; IFS default splits words.
  local seg rc
  local _oldifs="$IFS"
  set -f
  # Normalize separators to newlines. Strip subshell/group punctuation and shell keywords so the inner
  # `git … push` is exposed as its own segment.
  local norm
  norm="$(printf '%s' "$cmd" \
    | sed -E 's/\|\||;|&&|&|\||\(|\)|\{|\}/\n/g' \
    | sed -E 's/(^|\n)[[:space:]]*(then|do|else|elif|if|while|until|fi|done)([[:space:]]|$)/\n/g')"
  while IFS= read -r seg; do
    [ -n "$seg" ] || continue
    # Word-split the segment into a positional vector (no glob, no eval).
    # shellcheck disable=SC2086
    set -- $seg
    [ "$#" -gt 0 ] || continue
    _pfg_seg_push_out=""
    # Tested context: a non-push segment returns 1 (and the unknown-option case returns 2). Capture the
    # status WITHOUT letting `set -e` abort on the expected non-zero return (`; rc=$?` would not be a tested
    # context — the function's rc=1 would kill the hook before the assignment, the git-status crash bug).
    rc=0; _pfg_seg_push_args "$@" || rc=$?
    if [ "$rc" -eq 0 ]; then
      _PFG_IS_PUSH=1; _PFG_PUSH_UNRESOLVED=0; _PFG_PUSH_ARGS="$_pfg_seg_push_out"
      break
    elif [ "$rc" -eq 2 ]; then
      # git-push present in this segment but an unknown global option blocked clean resolution.
      _PFG_IS_PUSH=1; _PFG_PUSH_UNRESOLVED=1; _PFG_PUSH_ARGS=""
      # keep scanning — a later segment might resolve cleanly, but do not downgrade an unresolved push.
    fi
  done <<EOF
$norm
EOF
  set +f
  IFS="$_oldifs"
  # (3) FAIL-CLOSED BACKSTOP for an unresolvable line-continuation (defense-in-depth for the Gate-4 fix).
  # If we did NOT detect a push, but the input carried a shell line-continuation (`\`+optional CR+LF) AND an
  # ordered `git…push` token sequence survives on the ALREADY-JOINED command, then a continuation-split push
  # slipped past segmentation (e.g. an exotic shape, or the raw-blob fallback path on malformed JSON where
  # `$cmd` is the whole JSON blob). Rather than fall open (the exact incident), classify it
  # PRESENT-but-UNRESOLVED → the downstream CONFIRM/fail-closed path. This can only ADD safety: a benign
  # multiline command with no real git…push ordering is untouched (see NFP tests), and UNRESOLVED escalates
  # to CONFIRM, never a hard BLOCK by itself.
  # NOTE: we test `$cmd` (the step-(0) JOINED form), NOT the un-joined original — step (0) already collapsed
  # `\`+newline to a single space via awk, so a continuation that survived as `git…push` is detectable here
  # with the same ordered-token regex used elsewhere. The `_orig_cmd` continuation marker only GATES whether
  # to bother (cheap short-circuit for the overwhelming non-continuation majority).
  if [ "$_PFG_IS_PUSH" != 1 ] && printf '%s' "$_orig_cmd" | grep -qE '\\'$'\r''?$' ; then
    # Ordered git→push token check on the JOINED command. Deliberately SIMPLE + robust (a git program token
    # — bare `git`, an abs/rel path ending `/git`, or `git.exe` — at a word boundary, then a `push` token
    # one-or-more whitespace later). This is a fail-closed defense-in-depth net (it escalates to
    # CONFIRM/UNRESOLVED, never a hard BLOCK by itself), so erring slightly broad is safe; it must not use
    # the more intricate `([^[:space:]]*/)?` form, whose greedy backtracking misses `git  push` (two spaces)
    # when the preceding boundary char is a quote (the malformed-JSON raw-blob-fallback case found in review).
    if printf '%s' "$cmd" | grep -qE '(^|[^[:alnum:]_.-])(([^[:space:]]*/)?git(\.exe)?)[[:space:]]+push([[:space:]]|$)'; then
      _PFG_IS_PUSH=1; _PFG_PUSH_UNRESOLVED=1; _PFG_PUSH_ARGS=""
    fi
  fi
  return 0
}
_pfg_stage "continuation-normalize+enter-parse"
_pfg_parse_push "$COMMAND"
_pfg_stage "structural-parse-done"

# ── Resolve canonical repo (owner/repo) from config.branch.remote. Fail-open. ─
# Shared by the #3a pr-create guard below and reused by the #6b push guard.
# REPO-AWARE: reads config from the PUSH-TARGET repo (PFG_TARGET_CWD), not the session root.
_pfg_config() {  # echo the resolved .preflight/config.json path, or nothing. Always returns 0.
  local top
  top="$(_pfg_git -C "$PFG_TARGET_CWD" rev-parse --show-toplevel 2>/dev/null || echo "")"
  [ -z "$top" ] && top="$PFG_TARGET_CWD"
  local c="$top/.preflight/config.json"
  if [ -f "$c" ]; then echo "$c"; fi
  return 0
}
_pfg_branch_field() {  # $1 = base|remote ; echo value or empty (overlay → jq → node → grep)
  local cfg="$1" field="$2"
  [ -z "$cfg" ] && return 0
  # Per-clone topology overlay (issue #6): branch.remote/base may be corrected by a
  # gitignored .preflight/config.local.json (the inverted-clone fix). The overlay lib
  # enforces the allowlist — gate thresholds and forbidden-lists are NOT overlayable
  # (and _pfg_branch_array below deliberately never consults the overlay at all).
  # Fail-open: lib missing or no jq/node → committed-config path below, unchanged.
  if declare -F overlay_resolve >/dev/null 2>&1 && { command -v jq &>/dev/null || command -v node &>/dev/null; }; then
    overlay_resolve "branch.$field" "$cfg" 2>/dev/null || true
    return 0
  fi
  if command -v jq &>/dev/null; then
    _pfg_jq -r ".branch.$field // empty" "$cfg" 2>/dev/null || true
  elif command -v node &>/dev/null; then
    node -e "try{const c=require('$cfg');process.stdout.write((c.branch&&c.branch.$field)||'')}catch(e){}" 2>/dev/null || true
  else
    grep -oE "\"$field\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" "$cfg" | head -1 | sed 's/.*"\([^"]*\)"$/\1/' || true
  fi
}
# Normalize a git remote URL (https or ssh) to "owner/repo" (strip .git).
_pfg_url_to_slug() {
  printf '%s' "$1" | sed -E 's#^git@[^:]+:#https://x/#; s#^https?://[^/]+/##; s#\.git$##' | sed -E 's#^/+##'
}

# (_pfg_json_string is defined earlier — hoisted above the fast-decision block, which uses it.)

# ── Forbidden-destination denylist (A1 fix) ───────────────────────────────────
# The two guards below historically derived their SINGLE notion of "safe target"
# from config.branch.remote ("anything != the configured remote is bad"). That is
# exactly backwards on an INVERTED clone where the configured remote IS the
# dangerous one (observed live: branch.remote=origin, but origin=legacy prod that
# must never be touched; the real target is a DIFFERENT remote). The guard then
# blocked the correct push AND recommended pushing to the legacy repo.
#
# Fix: an EXPLICIT denylist the guard checks the RESOLVED target against, REGARDLESS
# of branch.remote. branch.forbiddenRemotes = remote NAMES that must never be pushed
# to; branch.forbiddenRepos = owner/repo slugs (or URLs) that must never be targeted
# by push or `gh pr create`. Fail-open exactly like the rest of this guard: absent or
# unparseable config → empty lists → inert (never newly blocks an opted-out repo).
_pfg_branch_array() {  # $1 = cfg path ; $2 = field ; echo array values, one per line.
  local cfg="$1" field="$2"
  [ -z "$cfg" ] || [ ! -f "$cfg" ] && return 0
  # CRLF FAIL-OPEN FIX (G1): jq on Git-Bash emits CRLF line endings, so each emitted array element is
  # terminated `\r\n`. Command substitution `$(...)` at the call sites strips only the FINAL trailing
  # `\r\n`, leaving every element EXCEPT THE LAST carrying a trailing `\r`. The forbidden-list matchers
  # then compare `origin\r` != `origin` and SILENTLY MISS a denylisted destination listed anywhere but
  # last — a fail-OPEN on a push to a forbidden/prod remote. A safety check that cannot verify its input
  # must fail CLOSED, so we strip `\r` from EVERY element AT THE SINGLE PRODUCER SEAM here (one fix
  # covers all four consumers: forbiddenRemotes/forbiddenRepos/prodPatterns/safeRemotes). `tr -d '\r'`
  # deletes the CR from every line, not just the last. (Same CRLF class as the source-of-truth-check and
  # parity-check fixes this session — CRLF on Git-Bash is a systemic fragility; strip it at the boundary.)
  if command -v jq &>/dev/null; then
    _pfg_jq -r ".branch.${field}[]? // empty" "$cfg" 2>/dev/null | tr -d '\r' || true
  elif command -v node &>/dev/null; then
    node -e "try{const c=require('$cfg');const a=(c.branch&&c.branch.$field)||[];a.forEach(x=>console.log(x))}catch(e){}" 2>/dev/null | tr -d '\r' || true
  else
    # Best-effort grep fallback (labeled): pull quoted strings from the field's array,
    # dropping the first match (the field name itself). jq is the primary path.
    grep -oE "\"$field\"[[:space:]]*:[[:space:]]*\[[^]]*\]" "$cfg" 2>/dev/null \
      | grep -oE '"[^"]*"' | sed -n '2,$p' | sed 's/^"//; s/"$//' | tr -d '\r' || true
  fi
}
# Is $1 (a remote NAME) on the forbidden-remotes list $2 (newline-separated names)?
_pfg_remote_forbidden() {
  local name="$1" hay="$2" line
  [ -z "$name" ] && return 1
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    [ "$line" = "$name" ] && return 0
  done <<< "$hay"
  return 1
}
# Is $1 (an owner/repo slug) on the forbidden-repos list $2 (entries may be slugs OR URLs)?
_pfg_repo_forbidden() {
  local slug="$1" hay="$2" line
  [ -z "$slug" ] && return 1
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    [ "$(_pfg_url_to_slug "$line")" = "$slug" ] && return 0
  done <<< "$hay"
  return 1
}

# ── GAP-A hardening: conservative prod-PATTERN heuristic (no explicit denylist needed) ─────────
# GAP-A was: a configured remote that IS prod but is NOT on forbiddenRepos, on an unprotected
# branch, classified AUTO → the agent silently auto-pushed to prod. The denylist closed it only
# when the operator opted in. This adds an ALWAYS-ON conservative net: if the remote's URL/slug
# carries a HIGH-CONFIDENCE prod signal, flip AUTO → CONFIRM (never BLOCK — a human may still push
# to prod deliberately, just never SILENTLY). Conservative by design (false-positive here only
# adds ONE confirmation, never blocks; but a false-positive on a safe remote is still friction, so
# the patterns are deliberately narrow): a token must appear as a WHOLE path/name SEGMENT — bounded
# by start/end, '/', '.', '-', '_', or ':' — so 'reproduce'/'product-catalog'/'proddy' do NOT match
# 'prod', and 'reliable' does NOT match 'live'. Matches: prod, production, prd, release, live,
# legacy. Case-insensitive on the slug only (the
# owner/repo + host path), not on arbitrary URL noise.
# Override/extend via branch.prodPatterns (committed config only; NOT overlayable — same posture as
# the forbidden lists). HONESTY: this is a NAME heuristic — a prod remote named blandly (e.g.
# 'app-final') will NOT match; the explicit forbiddenRepos denylist remains the operator's
# precise tool. Raises the bar on the OBVIOUS case; does not claim completeness.
# NOTE on the pattern set: only TRULY GENERIC prod tokens are built in. A project-specific legacy-prod
# repo name (e.g. the migration program's 'CPSL') is DELIBERATELY NOT a built-in — it would false-positive
# on a safe sibling that merely shares the fragment (observed: 'cyf.cpsl_core', the real migration TARGET,
# vs 'CPSL', the legacy prod). Project-specific prod repos belong on the operator's explicit
# branch.forbiddenRepos denylist (precise, no collateral), or in branch.prodPatterns if wanted.
_PFG_PROD_PATTERNS_BUILTIN='prod production prd release live legacy'
_pfg_remote_looks_prod() {  # $1 = slug-or-url ; $2 = extra newline-separated patterns (optional). 0 = looks prod.
  local hay="$1" extra="${2:-}" tok
  [ -z "$hay" ] && return 1
  # Lowercase for case-insensitive segment matching.
  hay="$(printf '%s' "$hay" | tr '[:upper:]' '[:lower:]')"
  # A segment boundary is: start-of-string, end-of-string, or one of / . - _ :
  for tok in $_PFG_PROD_PATTERNS_BUILTIN; do
    printf '%s' "$hay" | grep -qE "(^|[/._:-])${tok}([/._:-]|\$)" && return 0
  done
  # Operator-supplied extra patterns (committed branch.prodPatterns), same segment-boundary rule.
  if [ -n "$extra" ]; then
    while IFS= read -r tok; do
      [ -z "$tok" ] && continue
      tok="$(printf '%s' "$tok" | tr '[:upper:]' '[:lower:]')"
      printf '%s' "$hay" | grep -qE "(^|[/._:-])${tok}([/._:-]|\$)" && return 0
    done <<< "$extra"
  fi
  return 1
}

# ── GAP-A hardening (opt-in strict mode): a SAFE-REMOTES allowlist ─────────────────────────────
# When the operator sets branch.safeRemotes (committed config; NOT overlayable), AUTO is restricted
# to remotes whose NAME or resolved SLUG is on that list — everything else (including the configured
# remote, if it isn't listed) → CONFIRM. This inverts the default to fail-SAFE for operators who want
# it: AUTO only for explicitly-blessed remotes. ABSENT (the default) → this is INERT (returns "on the
# list" for everything) so the AUTO tier is preserved unchanged for consumers who never opt in — no
# friction regression. The one cost when ENABLED: the first push to a new safe remote needs one
# confirmation until it is added to the list (the documented trade for fail-safe AUTO).
_pfg_remote_on_safelist() {  # $1 = remote name ; $2 = resolved slug ; $3 = safeRemotes (newline list). 0 = allowed/AUTO-ok.
  local name="$1" slug="$2" list="$3" line
  [ -z "$list" ] && return 0   # no allowlist configured → INERT (everything is AUTO-eligible)
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    [ "$line" = "$name" ] && return 0
    [ -n "$slug" ] && [ "$(_pfg_url_to_slug "$line")" = "$slug" ] && return 0
  done <<< "$list"
  return 1
}

# ── (B-EARLY) FORBIDDEN-REMOTE NAME fast block (live Gate-4 23s-timeout fix) ──────────────────────────────
# THE INCIDENT: on the real slow-spawn host the engine's pre-decision work (config resolution + several
# _pfg_branch_* jq/node reads + the B0 `git remote get-url` + the evidence gate) stacked past the router's
# 23s candidate deadline, so a forbidden push to 'origin' was BLOCKED only by the deadline (rc=124), never
# by the explicit forbidden-remote policy. The forbidden-NAME decision needs NOTHING expensive: just the
# parsed explicit remote name + the committed branch.forbiddenRemotes list. So we make that decision HERE,
# as early as possible — after parsing, before the gh-pr-create path, before B0's `git remote get-url`,
# before config-base/remote resolution, before protected-branch eval, before the evidence gate, and before
# any network-capable op. A name match → emit the explicit forbidden-destination diagnostic and exit 2.
#
# SCOPE (deliberately narrow — this ONLY adds an earlier exit for the cheapest, most-certain block; it
# changes NO other path):
#   • fires ONLY for an explicit named remote that is on branch.forbiddenRemotes (a pure config-data string
#     match — zero git/network). It does NOT resolve URLs/slugs (the later B0 forbiddenRepos check still
#     handles `git push <url>` / a forbidden remote reached under a different name, by slug).
#   • implicit `git push` (no positional remote) is NOT matched (no ARG_REMOTE) → falls through unchanged.
#   • a SAFE/unlisted remote is NOT matched → falls through to the full policy/evidence path unchanged.
#   • unresolved/indirection pushes (_PFG_PUSH_UNRESOLVED) have no clean ARG_REMOTE → fall through to the
#     existing fail-closed CONFIRM path unchanged.
# COST: one `_pfg_branch_array` config read (the same call the main block makes later; here it is the ONLY
# spawn on the fast path) + builtin word-splitting. No `git remote get-url`, no slug resolution, no gh.
_eb_remote=""
if [ "$_PFG_IS_PUSH" = 1 ] && [ -n "${_PFG_PUSH_ARGS:-}" ]; then
  _eb_oldifs="$IFS"; set -f
  # shellcheck disable=SC2086
  set -- $_PFG_PUSH_ARGS
  set +f; IFS="$_eb_oldifs"
  for _eb_tok in "$@"; do
    case "$_eb_tok" in
      -*) ;;                       # flags (-u/--tags/--force/…) — skip
      +*) ;;                       # a '+'-prefixed refspec is not a remote name
      *) _eb_remote="$_eb_tok"; break ;;   # first positional = the (possibly named) remote
    esac
  done
fi
if [ -n "$_eb_remote" ]; then
  _pfg_stage "early-block:parsed-remote=$_eb_remote"
  # Locate .preflight/config.json by a PURE-SHELL upward FS walk from PFG_TARGET_CWD — NO `git rev-parse`
  # spawn (the live-timeout fix: _pfg_config's git call cost ~2.5s on the slow host; this costs ~0). Bounded
  # to <=64 levels. This only finds the config FILE for the cheapest decision; the main block below still
  # uses _pfg_config (git-anchored) for the full policy path, unchanged.
  _EB_CFG=""
  _eb_dir="$PFG_TARGET_CWD"
  _eb_n=0
  while [ -n "$_eb_dir" ] && [ "$_eb_n" -lt 64 ]; do
    if [ -f "$_eb_dir/.preflight/config.json" ]; then _EB_CFG="$_eb_dir/.preflight/config.json"; break; fi
    case "$_eb_dir" in */*) _eb_dir="${_eb_dir%/*}"; [ -z "$_eb_dir" ] && _eb_dir="/" ;; *) break ;; esac
    [ "$_eb_dir" = "/" ] && { [ -f "/.preflight/config.json" ] && _EB_CFG="/.preflight/config.json"; break; }
    _eb_n=$((_eb_n+1))
  done
  _pfg_stage "early-block:config-resolved(no-git)"
  # one bounded jq read of the forbidden-remote NAME list (committed config; NOT overlayable). If jq is
  # absent, fall through to the main block (which has node/grep fallbacks) rather than risk a wrong empty.
  _EB_FORBIDDEN_REMOTES=""
  if [ -n "$_EB_CFG" ] && command -v jq >/dev/null 2>&1; then
    _EB_FORBIDDEN_REMOTES="$(_pfg_jq -r '.branch.forbiddenRemotes[]? // empty' "$_EB_CFG" 2>/dev/null | tr -d '\r' || true)"
  fi
  _pfg_stage "early-block:forbiddenRemotes-read"
  if _pfg_remote_forbidden "$_eb_remote" "$_EB_FORBIDDEN_REMOTES"; then
    _pfg_stage "early-block:FORBIDDEN-decision"
    # de-steered diagnostic — single source, shared with the FAST-0 builtins path above; never recommends
    # a remote. (This B-EARLY block remains as the structural-parser-backed fallback for any forbidden push
    # the builtins FAST-0 path conservatively declined to resolve — e.g. an exotic continuation/global-option
    # shape — so the forbidden decision is never lost just because the fast shortcut bailed.)
    _fast_emit_forbidden "$_eb_remote"
  fi
fi

# ── #3a: guard `gh pr create` against a FORBIDDEN or NON-CANONICAL repo ───────
# `gh pr create` with no --repo resolves the repo from the cwd's default remote,
# which on migration clones is often origin = the legacy production repo. Two
# layered checks, FORBIDDEN FIRST:
#   (0) FORBIDDEN-REPO denylist (A1): if the RESOLVED target slug is on
#       config.branch.forbiddenRepos, block — REGARDLESS of branch.remote. This is
#       the check that holds even when branch.remote itself points at the dangerous
#       repo (the inverted-clone case where the canonical comparison is backwards).
#   (1) NON-CANONICAL: target != slug(branch.remote) → block (the original guard).
# Block (exit 2), for the AGENT's Bash tool only. Buildable-LOCAL with a server-side
# CEILING (agent's Bash tool only). FAIL-OPEN: inert if config is absent/unparseable
# — see docs/parity-gate-limitations.md. Block messages DELIBERATELY do NOT recommend
# a specific remote/repo: on an inverted clone the "canonical" value is itself the
# dangerous one, so steering toward it is the original A1 defect. Surface to a human.
if printf '%s' "$COMMAND" | grep -qE '(^|&&|\|\||;|")\s*gh[[:space:]]+pr[[:space:]]+create'; then
  PR_CMD="$(printf '%s' "$COMMAND" | grep -oE 'gh[[:space:]]+pr[[:space:]]+create[^&|;]*' | head -1 || true)"
  CFG="$(_pfg_config)"
  CANON_REMOTE="$(_pfg_branch_field "$CFG" remote)"
  FORBIDDEN_REPOS="$(_pfg_branch_array "$CFG" forbiddenRepos)"
  # Resolve canonical slug from the configured remote's URL (fail-open if unresolvable).
  CANON_SLUG=""
  if [ -n "$CANON_REMOTE" ]; then
    CANON_URL="$(_pfg_git -C "$PFG_TARGET_CWD" remote get-url "$CANON_REMOTE" 2>/dev/null || true)"
    [ -n "$CANON_URL" ] && CANON_SLUG="$(_pfg_url_to_slug "$CANON_URL")"
  fi
  # Resolve the slug this pr-create would ACTUALLY target: explicit --repo if present,
  # else the cwd default remote (origin) — exactly what gh resolves with no --repo.
  REPO_ARG="$(printf '%s' "$PR_CMD" | grep -oE -- '--repo[=[:space:]]+[^[:space:]]+' | head -1 | sed -E 's/--repo[=[:space:]]+//' || true)"
  TARGET_SLUG=""
  if [ -n "$REPO_ARG" ]; then
    TARGET_SLUG="$(_pfg_url_to_slug "$REPO_ARG")"
  else
    DEFAULT_URL="$(_pfg_git -C "$PFG_TARGET_CWD" remote get-url origin 2>/dev/null || true)"
    [ -n "$DEFAULT_URL" ] && TARGET_SLUG="$(_pfg_url_to_slug "$DEFAULT_URL")"
  fi

  # (0) FORBIDDEN-REPO pre-check — fires regardless of branch.remote.
  if [ -n "$TARGET_SLUG" ] && _pfg_repo_forbidden "$TARGET_SLUG" "$FORBIDDEN_REPOS"; then
    echo "BLOCKED: 'gh pr create' targets a FORBIDDEN repo '$TARGET_SLUG' (config.branch.forbiddenRepos)." >&2
    echo "  This destination is explicitly off-limits (e.g. a legacy production repo). Do NOT retarget automatically —" >&2
    echo "  surface to a human; see docs/parity-gate-limitations.md." >&2
    echo "  (Agent Bash-tool guard only; not server-side protection.)" >&2
    exit 2
  fi

  # (1) NON-CANONICAL check (original behavior; messages de-steered).
  if [ -n "$CANON_SLUG" ]; then
    if [ -n "$REPO_ARG" ]; then
      # (a) explicit --repo present → must equal canonical.
      if [ "$TARGET_SLUG" != "$CANON_SLUG" ]; then
        echo "BLOCKED: 'gh pr create --repo $REPO_ARG' targets a non-canonical repo (expected the configured target from config.branch.remote)." >&2
        echo "  On migration clones the wrong repo is often the legacy production repo. Do NOT assume the configured remote is safe —" >&2
        echo "  if the configured remote is itself wrong, surface to a human; see docs/parity-gate-limitations.md." >&2
        echo "  (Agent Bash-tool guard only; not server-side protection — see docs/parity-gate-limitations.md.)" >&2
        exit 2
      fi
    else
      # (b) no --repo → gh would resolve from the cwd default remote. Compare that to canonical.
      if [ -n "$TARGET_SLUG" ] && [ "$TARGET_SLUG" != "$CANON_SLUG" ]; then
        echo "BLOCKED: 'gh pr create' has no --repo; it would resolve to '$TARGET_SLUG' (cwd default remote), not the configured target." >&2
        echo "  On migration clones the default 'origin' is often the legacy production repo. Confirm the intended repo with a human" >&2
        echo "  before retrying; see docs/parity-gate-limitations.md." >&2
        echo "  (Agent Bash-tool guard only; not server-side protection — see docs/parity-gate-limitations.md.)" >&2
        exit 2
      fi
    fi
  fi
  # Canonical / not-forbidden / fail-open → allow the pr-create. Not a push; nothing more to gate here.
  # FAIL-CLOSED checkpoint: if remote-slug resolution above wedged, the forbidden/non-canonical checks
  # ran on UNRESOLVED slugs (could not prove the target is safe) — block rather than allow a pr-create.
  _pfg_wedge_block_if_flagged
  exit 0
fi

# Only gate on git push commands. Detection is now STRUCTURAL (_pfg_parse_push above), not a regex on the
# raw string — so `git -C <dir> push`, `git -c k=v push`, `command git push`, `\git push`, `GIT_DIR=… git
# push`, `/usr/bin/git push`, and `(git push …)` are all detected (H2). A non-push command exits 0 here.
if [ "$_PFG_IS_PUSH" != 1 ]; then
  exit 0
fi

# ── #6b: force-push + wrong-remote guard (BEFORE the evidence gate) ───────────
# Block, for the AGENT's Bash tool, two irreversible mistakes prose alone forbids:
#   (A) force-push (--force / -f / --force-with-lease) to a PROTECTED branch
#       (config.branch.base, plus main/master always), and
#   (B) push to a NON-CANONICAL remote (anything other than config.branch.remote —
#       notably `origin`, which on these clones is the legacy CPSL prod repo).
#
# Scope/ceiling (see docs/parity-gate-limitations.md): this guards the agent's Bash
# tool ONLY — not a human shell, a CI token, or another machine. True protection is
# server-side branch protection. It is also FAIL-OPEN: if config is absent/unparseable
# it does NOT block (additive guard; never newly blocks a repo that didn't opt in).

# PUSH_CMD is retained only as a "a push was detected" flag for the bare-push CONFIRM check below
# (it tests [ -n "$PUSH_CMD" ]). The actual arg parsing comes from the structural parser (_PFG_PUSH_ARGS),
# NOT a re-grep of the raw command — closing the second-layer extractor bypass (the old grep returned
# empty on `git -C … push`, silently skipping the forbidden-remote check even when detection succeeded).
PUSH_CMD="git push"   # non-empty sentinel: _PFG_IS_PUSH==1 is the real signal we got here.

# Resolve config (fail-open on any miss). jq → node → grep fallback, same idiom as other hooks.
# REPO-AWARE (NEW-2): config comes from the PUSH-TARGET repo, not the session root — so a
# session rooted in repo A that pushes repo B reads B's config (B's canonical remote), which is
# what makes the wrong-remote comparison correct cross-repo. _pfg_config already anchors on
# PFG_TARGET_CWD; reuse it here so the #6b block and the #3a block resolve identically.
CONFIG="$(_pfg_config)"
BASE=""; REMOTE=""
if [ -f "$CONFIG" ]; then
  # Route through _pfg_branch_field (single source): committed config, with the
  # issue-#6 config.local.json topology overlay applied when the lib is present.
  BASE="$(_pfg_branch_field "$CONFIG" base)"
  REMOTE="$(_pfg_branch_field "$CONFIG" remote)"
fi

# Forbidden destinations (A1): remote NAMES and repo SLUGS that must never be pushed
# to, REGARDLESS of branch.remote. Read via the shared helpers (jq → node → grep, fail-open).
FORBIDDEN_REMOTES="$(_pfg_branch_array "$CONFIG" forbiddenRemotes)"
FORBIDDEN_REPOS="$(_pfg_branch_array "$CONFIG" forbiddenRepos)"
# GAP-A hardening (committed config only; NOT overlayable — same posture as the forbidden lists):
#   prodPatterns  — extra segment-tokens that flag a remote as prod (extends the built-in net).
#   safeRemotes   — opt-in allowlist; when set, AUTO is restricted to listed remotes (fail-safe).
PROD_PATTERNS="$(_pfg_branch_array "$CONFIG" prodPatterns)"
SAFE_REMOTES="$(_pfg_branch_array "$CONFIG" safeRemotes)"

# Protected branch names: config base (if any) + main/master always.
PROTECTED_BRANCHES="main master"
[ -n "$BASE" ] && PROTECTED_BRANCHES="$PROTECTED_BRANCHES $BASE"

# Parse the push args from the STRUCTURAL parser's token list (_PFG_PUSH_ARGS = everything after `push`),
# NOT a re-grep/sed of the raw command. This is the single source for HAS_FORCE / ARG_REMOTE / ARG_REFSPEC,
# so detection and extraction can never diverge (the old two-layer bug). Word-split the parsed args.
HAS_FORCE=false
ARG_REMOTE=""
ARG_REFSPEC=""
_pfg_oldifs="$IFS"
set -f
# shellcheck disable=SC2086
set -- $_PFG_PUSH_ARGS
set +f
IFS="$_pfg_oldifs"
POSITIONAL=""
for tok in "$@"; do
  case "$tok" in
    # (A) explicit force flags.
    --force|-f|--force-with-lease|--force-with-lease=*|--force-if-includes)
      HAS_FORCE=true ;;
    -*) ;;                       # other flags (-u, --tags, --set-upstream, …) — skip.
    # (H1) a refspec whose SOURCE side begins with '+' is a forced (non-fast-forward) update — git's
    # documented shorthand (`+main` == `+main:main`, `+src:dst` forces dst). Recognize it as FORCE, and
    # record the '+'-STRIPPED positional so TARGET_BRANCH derivation below sees the real ref, not '+main'.
    +*)
      HAS_FORCE=true
      POSITIONAL="$POSITIONAL ${tok#+}" ;;   # strip exactly one leading '+'
    *)  POSITIONAL="$POSITIONAL $tok" ;;     # positional (remote / refspec)
  esac
done
set -f
# shellcheck disable=SC2086
set -- $POSITIONAL
set +f
ARG_REMOTE="${1:-}"             # first positional = remote (if named)
ARG_REFSPEC="${2:-}"           # second positional = refspec ('+' already stripped above if present)

# (B0) FORBIDDEN-DESTINATION pre-check (A1) — fires REGARDLESS of branch.remote.
# This is the check that holds on an INVERTED clone where branch.remote itself names
# the dangerous remote. Match the named push remote against forbiddenRemotes, AND its
# resolved URL slug against forbiddenRepos (covers `git push <url> …` and a forbidden
# remote reached under a different name). De-steered: never recommends a remote.
if [ -n "$ARG_REMOTE" ]; then
  ARG_REMOTE_SLUG=""
  ARG_REMOTE_URL="$(_pfg_git -C "$PFG_TARGET_CWD" remote get-url "$ARG_REMOTE" 2>/dev/null || true)"
  if [ -n "$ARG_REMOTE_URL" ]; then
    ARG_REMOTE_SLUG="$(_pfg_url_to_slug "$ARG_REMOTE_URL")"
  else
    # Not a known remote name — it may be an inline URL positional. Normalize it directly.
    case "$ARG_REMOTE" in *://*|*@*:*|*/*) ARG_REMOTE_SLUG="$(_pfg_url_to_slug "$ARG_REMOTE")" ;; esac
  fi
  if _pfg_remote_forbidden "$ARG_REMOTE" "$FORBIDDEN_REMOTES" \
     || { [ -n "$ARG_REMOTE_SLUG" ] && _pfg_repo_forbidden "$ARG_REMOTE_SLUG" "$FORBIDDEN_REPOS"; }; then
    echo "BLOCKED: push targets a FORBIDDEN destination '$ARG_REMOTE' (config.branch.forbiddenRemotes/forbiddenRepos)." >&2
    echo "  This remote is explicitly off-limits (e.g. a legacy production repo). Do NOT retarget automatically —" >&2
    echo "  surface to a human; see docs/parity-gate-limitations.md." >&2
    echo "  (Agent Bash-tool guard only; not server-side protection.)" >&2
    exit 2
  fi
fi

# (B-bare) UNVALIDATABLE BARE PUSH: a `git push` with NO named remote (e.g. bare `git push`,
# `git push -u`, `git push --force`) resolves to git's DEFAULT remote (the branch's upstream, or
# `origin`) — a target this guard NEVER SEES, so the forbidden-destination (B0) and wrong-remote (B)
# checks above are SILENTLY SKIPPED and the push sails through unvalidated. On an inverted clone where
# the default/upstream remote is legacy PROD, that is an ungated push-to-prod. You cannot confirm a
# remote you did not name. So: when this repo has OPTED IN to preflight push-gating (a config with
# branch.remote is present), REQUIRE the remote be named explicitly so it becomes validatable — then
# the B0/B checks run on it. FAIL-OPEN otherwise: no config / no configured remote → not opted in →
# do NOT newly block (same additive-guard posture as the rest of this file).
#
# ── THREE-TIER REVERSIBILITY POLICY (AUTO / CONFIRM / BLOCK) ──────────────────────────────────────
# The push-safety tiers below are computed MECHANICALLY from the signals already resolved above
# (PROTECTED_BRANCHES, REMOTE, FORBIDDEN_*, HAS_FORCE, ARG_REMOTE) — never the agent's judgement.
#   BLOCK   (exit 2)                : irreversible-and-never-OK → force-push to a protected branch, and
#                                     the explicit forbidden-destination block (B0, above).
#   CONFIRM (exit 0 + permissionDecision:ask) : consequential/high-blast-radius but a human MAY choose
#                                     to proceed → push to a PROTECTED branch, to a PROD/non-canonical
#                                     remote (closes GAP A — a configured-remote push to a prod-looking
#                                     target is now ASK, not silent allow), or a BARE push (unvalidatable
#                                     target). The platform prompts the user; the agent cannot self-approve.
#   AUTO    (exit 0, fall through to the evidence gate) : reversible/low-blast-radius → named SAFE remote,
#                                     UNPROTECTED branch, non-force. The friction being removed: the agent
#                                     just pushes (after the evidence gate), no human copy-paste handoff.
# PROTOCOL NOTE (Claude Code PreToolUse): exit 0 + JSON on stdout XOR exit 2 — they cannot be combined
# (JSON is ignored on exit 2). So the HARD BLOCK (force-to-protected) exits 2 here; the CONFIRM tier is
# deferred until AFTER the evidence gate (a missing/stale-evidence exit 2 is itself a hard block that must
# win over a CONFIRM). We set CONFIRM_REASON now, run the evidence gate, then emit the tier decision.
CONFIRM_REASON=""

# Resolve the would-be target branch (refspec dest after ':', else named ref, else current branch).
TARGET_BRANCH="${ARG_REFSPEC##*:}"
if [ -z "$TARGET_BRANCH" ]; then
  TARGET_BRANCH="$(_pfg_git -C "$PFG_TARGET_CWD" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
fi

# (A) HARD BLOCK — force-push to a protected branch (irreversible history rewrite; never auto, never
# merely-confirm). Preserved exactly as before: exit 2.
if [ "$HAS_FORCE" = true ]; then
  for pb in $PROTECTED_BRANCHES; do
    if [ "$TARGET_BRANCH" = "$pb" ]; then
      echo "BLOCKED: force-push (--force/-f/--force-with-lease) to protected branch '$pb'." >&2
      echo "  Shared branches must never be force-pushed — even --force-with-lease rewrites shared history." >&2
      echo "  (Agent Bash-tool guard only; not server-side protection — see docs/parity-gate-limitations.md.)" >&2
      exit 2
    fi
  done
fi

# (B-unresolved) FAIL-CLOSED CONFIRM — a push is PRESENT but the parser could NOT cleanly resolve its arg
# list (an indirection wrapper: eval / bash -c / sh -c / xargs git push; or an unknown global option before
# the subcommand). The target therefore cannot be validated against the forbidden/wrong-remote checks — so
# rather than silently allow (the old fail-OPEN), escalate to a human. CONFIRM (not exit 2): a benign
# false-positive only costs one confirmation, and the actual harm (a SILENT bypass) is removed. Gated on
# push-gating being opted in (REMOTE set) to preserve the additive-guard posture (no config → inert).
# This is the H2 design's fail-closed fallback: an unparseable-but-plausibly-a-push command needs the guard.
if [ -z "$CONFIRM_REASON" ] && [ "$_PFG_PUSH_UNRESOLVED" = 1 ] && [ -n "$REMOTE" ]; then
  CONFIRM_REASON="A 'git … push' was detected but its target could NOT be parsed — the push is wrapped in an indirection (eval / bash -c / sh -c / xargs) or uses an unrecognized git global option, so the forbidden-remote and protected-branch checks cannot run on it. Failing CLOSED to a human confirmation rather than a silent allow: run the push as a plain 'git push <remote> <refspec>' so it is validatable, or confirm this is intended. (Agent Bash-tool guard only; not server-side protection.)"
fi

# (B-bare) CONFIRM — bare 'git push' (no named remote): the target is unvalidatable (default/upstream
# remote this guard cannot see → could be prod). Was a hard BLOCK; now CONFIRM so a human can proceed
# deliberately, never silently. Only when push-gating is opted in (REMOTE set); fail-open otherwise.
if [ -z "$CONFIRM_REASON" ] && [ -n "$PUSH_CMD" ] && [ -z "$ARG_REMOTE" ] && [ -n "$REMOTE" ]; then
  CONFIRM_REASON="Bare 'git push' with no named remote — the target is UNVALIDATABLE (git's default/upstream remote, which the guard cannot see, may be the legacy production repo). Name the remote explicitly so it is checked, or confirm this push is intended. (Agent Bash-tool guard only; not server-side protection.)"
fi

# (B) CONFIRM — push to a PROD/non-canonical remote. A NAMED remote that isn't the configured one, OR
# (GAP A close) the configured remote itself resolving to a FORBIDDEN/prod slug. Was: wrong-remote → BLOCK,
# configured-prod → silent ALLOW. Now both → CONFIRM (the human may push to prod deliberately, not silently).
if [ -z "$CONFIRM_REASON" ] && [ -n "$ARG_REMOTE" ]; then
  if [ -n "$REMOTE" ] && [ "$ARG_REMOTE" != "$REMOTE" ]; then
    CONFIRM_REASON="Push targets remote '$ARG_REMOTE', not the configured remote '$REMOTE' (config.branch.remote). On an inverted clone the named remote may be a legacy production repo. Confirm this is the intended target. (Agent Bash-tool guard only; not server-side protection.)"
  else
    # GAP A: the configured remote could itself be prod. Resolve its slug ONCE and run three checks,
    # each of which flips the otherwise-AUTO configured-remote push to CONFIRM (never silent prod push):
    #   (1) EXPLICIT denylist — the slug is on config.branch.forbiddenRepos (operator's precise tool).
    #   (2) PROD-PATTERN heuristic (GAP-A hardening) — the slug/URL carries a high-confidence prod
    #       signal (prod/production/prd/release/live/legacy as a whole segment, + branch.prodPatterns).
    #       This is the ALWAYS-ON net that closes the silent-auto-push-to-prod hole with NO opt-in.
    #   (3) SAFE-REMOTES allowlist (GAP-A opt-in strict mode) — if branch.safeRemotes is set and this
    #       remote/slug is NOT on it → CONFIRM. Inert (no flip) when safeRemotes is absent, so the AUTO
    #       tier is preserved by default for consumers who never opt in.
    _AR_URL="$(_pfg_git -C "$PFG_TARGET_CWD" remote get-url "$ARG_REMOTE" 2>/dev/null || true)"
    _AR_SLUG=""
    if [ -n "$_AR_URL" ]; then _AR_SLUG="$(_pfg_url_to_slug "$_AR_URL")"
    else case "$ARG_REMOTE" in *://*|*@*:*|*/*) _AR_SLUG="$(_pfg_url_to_slug "$ARG_REMOTE")" ;; esac; fi
    # The signal the heuristic inspects: the resolved slug if we have one, else the raw remote URL,
    # else the remote name itself (covers a remote named e.g. 'prod' with no resolvable URL).
    _AR_PROBE="${_AR_SLUG:-${_AR_URL:-$ARG_REMOTE}}"
    if [ -n "$_AR_SLUG" ] && _pfg_repo_forbidden "$_AR_SLUG" "$FORBIDDEN_REPOS"; then
      CONFIRM_REASON="Push targets '$ARG_REMOTE' (→ $_AR_SLUG), which is on the forbidden/prod denylist (config.branch.forbiddenRepos) — even though it is the configured remote. A push to prod must be a deliberate human confirmation, never silent. (Agent Bash-tool guard only; not server-side protection.)"
    elif _pfg_remote_looks_prod "$_AR_PROBE" "$PROD_PATTERNS"; then
      CONFIRM_REASON="Push targets '$ARG_REMOTE' (→ ${_AR_PROBE}), which matches a PRODUCTION-name pattern (prod/production/release/live/legacy/…). Even though it is the configured remote, a push to a prod-looking target must be a deliberate human confirmation, never silent. If this remote is actually safe, add it to config.branch.safeRemotes (or confirm to proceed). (Heuristic name match — agent Bash-tool guard only; not server-side protection.)"
    elif ! _pfg_remote_on_safelist "$ARG_REMOTE" "$_AR_SLUG" "$SAFE_REMOTES"; then
      CONFIRM_REASON="Push targets '$ARG_REMOTE' (→ ${_AR_PROBE}), which is NOT on config.branch.safeRemotes (strict-mode allowlist is enabled). AUTO is restricted to explicitly-blessed remotes; confirm this push, or add the remote to safeRemotes. (Agent Bash-tool guard only; not server-side protection.)"
    fi
  fi
fi

# (C) CONFIRM — push to a PROTECTED branch (main/master/config.base), even on the safe remote, non-force.
# Landing on a protected/shared branch is consequential; the human confirms. (Force-to-protected already
# hard-blocked above.)
if [ -z "$CONFIRM_REASON" ] && [ -n "$TARGET_BRANCH" ]; then
  for pb in $PROTECTED_BRANCHES; do
    if [ "$TARGET_BRANCH" = "$pb" ]; then
      CONFIRM_REASON="Push lands on PROTECTED branch '$pb' (a shared/integration branch). Confirm this is intended — safe topic-branch pushes proceed automatically, but a push to a protected branch is consequential. (Agent Bash-tool guard only; not server-side protection.)"
      break
    fi
  done
fi

# Not a hard-blocked operation — run the evidence gate FIRST (a missing/stale-evidence exit 2 is a hard
# block that must win over CONFIRM). pre-push-gate exits 2 to block, or returns 0 when evidence is fresh.
# A wedge during the tier-signal resolution above (remote slugs / target branch) means the CONFIRM/AUTO
# classification was computed on an unresolved target — block before even running the evidence gate.
_pfg_wedge_block_if_flagged

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
set +e
# Redirect stdin from /dev/null: the parent already consumed its stdin (STDIN_JSON="$(cat)" at the top),
# so the inherited fd is an exhausted pipe. Detaching the child's stdin avoids any downstream git/jq op
# blocking on it, and matches the original `exec` form's effective behavior without replacing the process.
# NO separate timeout here: this whole engine process already runs INSIDE the ROUTER's candidate-scoped
# deadline (PREFLIGHT_ENGINE_DEADLINE), which bounds the evidence gate's git rev-parse/diff along with
# everything else (a wedged evidence gate is caught by that outer deadline → the router fails CLOSED with
# exit 2 for this candidate alone). A redundant tight sub-timeout was tried and REMOVED — on a slow-spawn
# host it false-blocked a LEGITIMATE fresh-evidence run (the gate's own spawn tax, not a wedge, exceeded
# the cap), which is a fail-CLOSED-the-wrong-way regression. The 124/137 remap below stays as
# defence-in-depth in case a future caller runs this body unwrapped (no router/outer deadline at all).
bash "$SCRIPT_DIR/pre-push-gate" </dev/null
EVIDENCE_RC=$?
set -e
if [ "$EVIDENCE_RC" -eq 124 ] || [ "$EVIDENCE_RC" -eq 137 ] || [ "$EVIDENCE_RC" -gt 128 ]; then
  echo "BLOCKED: the pre-push evidence gate wedged (rc=$EVIDENCE_RC) resolving HEAD/diff — failing CLOSED." >&2
  echo "  Could not verify gate evidence is fresh for the pushed code; the push is BLOCKED, not allowed." >&2
  exit 2
fi
# Evidence-gate result handling — FAIL CLOSED on ANY unexpected code (G6). The PreToolUse protocol blocks
# ONLY on exit 2; every other code (0 allows, and 1/127/126/… are NON-blocking errors). So the evidence
# gate's exit must be normalized to {0=fresh, 2=block} and NOTHING else may reach the tool as a verdict.
# The OLD code passed any non-zero VERBATIM via `exit "$EVIDENCE_RC"` on the assumption it is always 2 —
# but a missing/non-executable sibling pre-push-gate exits 127, and a `set -e` abort exits 1; both are
# NON-blocking, so the push would proceed UNGATED past a broken evidence gate (fail-OPEN). Mirror the
# parity-check 0/1/2/3 discipline: an unexpected code FAILS LOUDLY (block), never passes through as a
# non-blocking verdict. So: 0 -> proceed; 2 -> hard block (relay); ANY other non-zero -> normalize to 2.
if [ "$EVIDENCE_RC" -eq 2 ]; then
  exit 2   # evidence gate blocked (the expected hard-block code) — JSON would be ignored on exit 2 anyway.
fi
if [ "$EVIDENCE_RC" -ne 0 ]; then
  echo "BLOCKED: the pre-push evidence gate exited abnormally (rc=$EVIDENCE_RC) — neither 0 (fresh) nor 2" >&2
  echo "  (block). A non-0/2 code (e.g. 127 = sibling pre-push-gate missing/non-executable, or 1 = a" >&2
  echo "  set -e abort) is NON-blocking under the PreToolUse protocol, so passing it through would let the" >&2
  echo "  push proceed UNGATED. Failing CLOSED: the push is BLOCKED. Fix/restore the evidence gate, then retry." >&2
  exit 2
fi

# Evidence is fresh. Now emit the tier decision (exit 0 + JSON, per the PreToolUse protocol).
# FINAL fail-closed checkpoint: a CONFIRM (ask) or AUTO (allow) must only be emitted on a FULLY
# resolved target. If any bounded git/jq call wedged while computing the remote slug / target branch,
# the tier could be wrong (e.g. a forbidden-prod remote whose slug never resolved) → BLOCK instead.
_pfg_wedge_block_if_flagged
if [ -n "$CONFIRM_REASON" ]; then
  # CONFIRM tier: ask the user. permissionDecision:ask escalates to a human confirmation prompt; the
  # agent CANNOT self-approve (the accountability property — the consequential push is gated to a human).
  printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"ask","permissionDecisionReason":%s}}\n' \
    "$(printf '%s' "CONSEQUENTIAL PUSH — confirm to proceed. $CONFIRM_REASON" | _pfg_json_string)"
  exit 0
fi
# AUTO tier: reversible/low-blast-radius (named safe remote, unprotected branch, non-force, evidence
# fresh). Fall through with exit 0 + explicit allow so the safe push proceeds with NO human handoff —
# the friction being removed.
printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"allow","permissionDecisionReason":"Reversible push: unprotected branch to the configured safe remote, non-force, gate evidence fresh."}}\n'
exit 0
