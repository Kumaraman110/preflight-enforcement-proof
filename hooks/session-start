#!/usr/bin/env bash
# Session bootstrap hook. Injects behavioral routing into the session context
# so the LLM knows WHEN to use each skill without being told.
#
# Two responsibilities:
# 1. Detect project config (mode, rubric, captures)
# 2. Inject the routing skill content as additionalContext
#
# The routing document is the decision tree the agent follows before every action.
# Without it, skills exist but the agent doesn't know when to activate them.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

CONFIG_FILE=""
MODE="generic"
RUBRIC=""
CAPTURES=""

# Search order for project config
for candidate in ".preflight/config.json" ".cpsl/config.json" ".forge.json"; do
  if [ -f "$candidate" ]; then
    CONFIG_FILE="$candidate"
    break
  fi
done

if [ -n "$CONFIG_FILE" ]; then
  PYTHON=""
  if python3 -c "pass" &>/dev/null; then
    PYTHON="python3"
  elif python -c "pass" &>/dev/null; then
    PYTHON="python"
  fi

  if command -v jq &>/dev/null; then
    MODE=$(jq -r '.mode // "generic"' "$CONFIG_FILE" 2>/dev/null || echo "generic")
    RUBRIC=$(jq -r '.rubric // ""' "$CONFIG_FILE" 2>/dev/null || echo "")
  elif [ -n "$PYTHON" ]; then
    MODE=$($PYTHON -c "import json; d=json.load(open('$CONFIG_FILE')); print(d.get('mode','generic'))" 2>/dev/null || echo "generic")
    RUBRIC=$($PYTHON -c "import json; d=json.load(open('$CONFIG_FILE')); print(d.get('rubric','') or '')" 2>/dev/null || echo "")
  fi

  CAPTURE_COUNT=0
  for cap in "calibrationLog" "checklistAdditions" "falsePositives"; do
    CAP_PATH=""
    if command -v jq &>/dev/null; then
      CAP_PATH=$(jq -r ".capture.$cap // \"\"" "$CONFIG_FILE" 2>/dev/null || echo "")
    elif [ -n "$PYTHON" ]; then
      CAP_PATH=$($PYTHON -c "import json; d=json.load(open('$CONFIG_FILE')); print(d.get('capture',{}).get('$cap',''))" 2>/dev/null || echo "")
    fi
    [ -n "$CAP_PATH" ] && [ -f "$CAP_PATH" ] && CAPTURE_COUNT=$((CAPTURE_COUNT + 1))
  done
  CAPTURES="$CAPTURE_COUNT capture files active"
fi

# Build status line (short metadata)
if [ "$MODE" = "generic" ] && [ -z "$CONFIG_FILE" ]; then
  STATUS="preflight active | mode=generic (no project config) | default rubric"
elif [ "$MODE" = "migration" ]; then
  STATUS="preflight active | mode=migration | config=$CONFIG_FILE | rubric=$RUBRIC | $CAPTURES"
elif [ "$MODE" = "api-new" ]; then
  STATUS="preflight active | mode=api-new | config=$CONFIG_FILE | rubric=$RUBRIC | $CAPTURES"
else
  STATUS="preflight active | mode=$MODE | config=$CONFIG_FILE | rubric=$RUBRIC | $CAPTURES"
fi

# Load the routing skill content — this is the behavioral decision tree
ROUTING_FILE="$PLUGIN_ROOT/skills/routing/SKILL.md"
ROUTING_CONTENT=""
if [ -f "$ROUTING_FILE" ]; then
  # Strip YAML frontmatter (everything between first --- and second ---)
  ROUTING_CONTENT=$(sed -n '/^---$/,/^---$/!p' "$ROUTING_FILE" | sed '/^$/N;/^\n$/d')
fi

# ── E2 silent-load probe: run file-level registration check at session-start ─────
# This runs the file-level check (tools/preflight-registration-check.sh) which
# proves the consumer's .claude/settings.json carries every hooks.json registration
# and every hook file exists. Silent registration rot (merge skipped, settings
# clobbered, hook file pruned with registration left) degrades the framework to
# plain-agent behavior with NO error. This probe surfaces it immediately at
# session-start without blocking (the runtime-invocation slice — settings parse,
# shim, $TOOL_INPUT plumbing — needs a live Claude Code session and is NOT
# code-closable here).
REG_WARN=""
if [ -n "$CONFIG_FILE" ]; then
  REG_TOOL="$PLUGIN_ROOT/tools/preflight-registration-check.sh"
  if [ -f "$REG_TOOL" ] && command -v jq >/dev/null 2>&1; then
    # Run in the repo root (where CONFIG_FILE lives)
    REPO_ROOT="$(dirname "$CONFIG_FILE")"
    REG_OUT=$(bash "$REG_TOOL" "$REPO_ROOT" 2>&1) || REG_RC=$?
    if [ "${REG_RC:-0}" -ne 0 ]; then
      REG_WARN="⚠ REGISTRATION ISSUES DETECTED (silent-load risk):\\n$REG_OUT"
    fi
  fi
fi

# Combine status + routing into additionalContext
# The status line gives metadata. The routing content gives behavioral rules.
FULL_CONTEXT="$STATUS"
if [ -n "$REG_WARN" ]; then
  FULL_CONTEXT="$FULL_CONTEXT\\n\\n$REG_WARN"
fi
if [ -n "$ROUTING_CONTENT" ]; then
  # Escape for JSON: newlines, quotes, backslashes
  ESCAPED_ROUTING=$(echo "$ROUTING_CONTENT" | sed 's/\\\\/\\\\\\\\/g' | sed 's/\"/\\\\\"/g' | sed ':a;N;$!ba;s/\\n/\\\\n/g')
  FULL_CONTEXT="$FULL_CONTEXT\\n\\n$ESCAPED_ROUTING"
fi

# Output in Claude Code hook format
cat <<EOF
{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"$FULL_CONTEXT"}}
EOF
