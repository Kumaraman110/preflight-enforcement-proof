#!/usr/bin/env bash
# Session bootstrap hook. Injects behavioral routing into the session context
# so the LLM knows WHEN to use each skill without being told.
#
# Two responsibilities:
# 1. Detect project config (mode, rubric, captures)
# 2. Inject the routing skill content as additionalContext
#
# The routing document is the decision tree the agent follows before every action.
# Without it, skills exist but the agent doesn't know when to activate them.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

CONFIG_FILE=""
MODE="generic"
RUBRIC=""
CAPTURES=""

# Search order for project config
for candidate in ".preflight/config.json" ".cpsl/config.json" ".forge.json"; do
  if [ -f "$candidate" ]; then
    CONFIG_FILE="$candidate"
    break
  fi
done

if [ -n "$CONFIG_FILE" ]; then
  PYTHON=""
  if python3 -c "pass" &>/dev/null; then
    PYTHON="python3"
  elif python -c "pass" &>/dev/null; then
    PYTHON="python"
  fi

  if command -v jq &>/dev/null; then
    MODE=$(jq -r '.mode // "generic"' "$CONFIG_FILE" 2>/dev/null || echo "generic")
    RUBRIC=$(jq -r '.rubric // ""' "$CONFIG_FILE" 2>/dev/null || echo "")
  elif [ -n "$PYTHON" ]; then
    MODE=$($PYTHON -c "import json; d=json.load(open('$CONFIG_FILE')); print(d.get('mode','generic'))" 2>/dev/null || echo "generic")
    RUBRIC=$($PYTHON -c "import json; d=json.load(open('$CONFIG_FILE')); print(d.get('rubric','') or '')" 2>/dev/null || echo "")
  fi

  CAPTURE_COUNT=0
  for cap in "calibrationLog" "checklistAdditions" "falsePositives"; do
    CAP_PATH=""
    if command -v jq &>/dev/null; then
      CAP_PATH=$(jq -r ".capture.$cap // \"\"" "$CONFIG_FILE" 2>/dev/null || echo "")
    elif [ -n "$PYTHON" ]; then
      CAP_PATH=$($PYTHON -c "import json; d=json.load(open('$CONFIG_FILE')); print(d.get('capture',{}).get('$cap',''))" 2>/dev/null || echo "")
    fi
    [ -n "$CAP_PATH" ] && [ -f "$CAP_PATH" ] && CAPTURE_COUNT=$((CAPTURE_COUNT + 1))
  done
  CAPTURES="$CAPTURE_COUNT capture files active"
fi

# Build status line (short metadata)
if [ "$MODE" = "generic" ] && [ -z "$CONFIG_FILE" ]; then
  STATUS="preflight active | mode=generic (no project config) | default rubric"
elif [ "$MODE" = "migration" ]; then
  STATUS="preflight active | mode=migration | config=$CONFIG_FILE | rubric=$RUBRIC | $CAPTURES"
elif [ "$MODE" = "api-new" ]; then
  STATUS="preflight active | mode=api-new | config=$CONFIG_FILE | rubric=$RUBRIC | $CAPTURES"
else
  STATUS="preflight active | mode=$MODE | config=$CONFIG_FILE | rubric=$RUBRIC | $CAPTURES"
fi

# Load the routing skill content — this is the behavioral decision tree
ROUTING_FILE="$PLUGIN_ROOT/skills/routing/SKILL.md"
ROUTING_CONTENT=""
if [ -f "$ROUTING_FILE" ]; then
  # Strip YAML frontmatter (everything between first --- and second ---)
  ROUTING_CONTENT=$(sed -n '/^---$/,/^---$/!p' "$ROUTING_FILE" | sed '/^$/N;/^\n$/d')
fi

# ── E2 silent-load probe: run file-level registration check at session-start ─────
# This runs the file-level check (tools/preflight-registration-check.sh) which
# proves the consumer's .claude/settings.json carries every hooks.json registration
# and every hook file exists. Silent registration rot (merge skipped, settings
# clobbered, hook file pruned with registration left) degrades the framework to
# plain-agent behavior with NO error. This probe surfaces it immediately at
# session-start without blocking (the runtime-invocation slice — settings parse,
# shim, $TOOL_INPUT plumbing — needs a live Claude Code session and is NOT
# code-closable here).
REG_WARN=""
if [ -n "$CONFIG_FILE" ]; then
  REG_TOOL="$PLUGIN_ROOT/tools/preflight-registration-check.sh"
  if [ -f "$REG_TOOL" ] && command -v jq >/dev/null 2>&1; then
    # Run in the repo root (where CONFIG_FILE lives)
    REPO_ROOT="$(dirname "$CONFIG_FILE")"
    REG_OUT=$(bash "$REG_TOOL" "$REPO_ROOT" 2>&1) || REG_RC=$?
    if [ "${REG_RC:-0}" -ne 0 ]; then
      REG_WARN="⚠ REGISTRATION ISSUES DETECTED (silent-load risk):\\n$REG_OUT"
    fi
  fi
fi

# ── E3 heartbeat freshness probe: check that every registered PreToolUse gate ──
# has fired recently (recorded via passive heartbeat side-effect). A gate with
# no heartbeat or a stale one is flagged — it may be registered-but-dead.
# This is PASSIVE: the heartbeat is written as a side-effect of the gate doing
# its normal job; this check reads those files. ZERO user action.
HB_WARN=""
HB_LIB="$PLUGIN_ROOT/lib/heartbeat.sh"
if [ -f "$HB_LIB" ] && [ -f "$PLUGIN_ROOT/hooks/hooks.json" ]; then
  source "$HB_LIB"
  HB_DEAD=""
  if command -v jq >/dev/null 2>&1; then
    GATE_NAMES=$(jq -r '.hooks.PreToolUse[]?.hooks[]?.command // empty' "$PLUGIN_ROOT/hooks/hooks.json" 2>/dev/null \
      | sed 's/.*run-hook.cmd" //' | sed 's/ .*//' | sort -u)
    for gn in $GATE_NAMES; do
      [ -z "$gn" ] && continue
      if ! _check_heartbeat_fresh "$gn" 86400 2>/dev/null; then
        HB_DEAD="$HB_DEAD $gn"
      fi
    done
  fi
  if [ -n "$HB_DEAD" ]; then
    HB_WARN="⚠ GATE LIVENESS: no recent heartbeat for:$HB_DEAD\\\\nThese gates may be registered-but-dead. Run 'bash tools/preflight-selftest.sh' to diagnose.\\\\nHeartbeats are passive — no action needed if gates have not yet fired in this session."
  fi
fi

# ── Branch-stable runtime report (P0 Part B) ──────────────────────────────────
# Report the ACTIVE enforcement-runtime SHA so a human can SEE which control plane is live, and surface the
# two failure modes the branch-stable model must not hide: (a) the active runtime dir is missing/incomplete
# (a deleted or never-installed pinned runtime → the gate cannot spawn), and (b) the TRACKED project layer
# still registers a Bash PreToolUse hook, which — because Claude Code runs hooks ADDITIVELY — would fire
# ALONGSIDE the pinned runtime and remains branch-swappable (defeating the relocation). Both are reported,
# never silently swapped. See docs/branch-stable-runtime.md.
RUNTIME_WARN=""
RUNTIME_REPORT=""
if command -v git >/dev/null 2>&1; then
  _ss_top="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  if [ -n "$_ss_top" ]; then
    _ss_common="$(git -C "$_ss_top" rev-parse --git-common-dir 2>/dev/null || true)"
    case "$_ss_common" in /*|[A-Za-z]:*) : ;; *) [ -n "$_ss_common" ] && _ss_common="$_ss_top/$_ss_common" ;; esac
    _ss_common="$( [ -n "$_ss_common" ] && cd "$_ss_common" 2>/dev/null && pwd || true )"
    if [ -n "$_ss_common" ]; then
      _ss_active_marker="$_ss_common/preflight/runtime/ACTIVE"
      if [ -f "$_ss_active_marker" ]; then
        _ss_sha="$(cat "$_ss_active_marker" 2>/dev/null || true)"
        _ss_rt_dir="$_ss_common/preflight/runtime/$_ss_sha"
        if [ -n "$_ss_sha" ] && [ -f "$_ss_rt_dir/hooks/pre-bash-risk-router" ] && [ -f "$_ss_rt_dir/hooks/pre-push-gate-engine" ]; then
          RUNTIME_REPORT="active runtime=${_ss_sha:0:12} (branch-stable, under git-common-dir)"
          # Warn if the branch's desired version (installed.lock) differs from the active runtime — do NOT swap.
          _ss_lock=".preflight/installed.lock"
          if [ -f "$_ss_lock" ] && command -v jq >/dev/null 2>&1; then
            _ss_want="$(jq -r '.resolvedSha // ""' "$_ss_lock" 2>/dev/null || echo "")"
            if [ -n "$_ss_want" ] && [ "$_ss_want" != "$_ss_sha" ]; then
              RUNTIME_WARN="⚠ RUNTIME VERSION SKEW: this branch's installed.lock wants ${_ss_want:0:12} but the ACTIVE runtime is ${_ss_sha:0:12}. The runtime is NOT auto-swapped (branch checkout must never change the live control plane). Run tools/preflight-runtime-install.sh to upgrade deliberately."
            fi
          fi
        else
          RUNTIME_WARN="⚠ ACTIVE runtime ${_ss_sha:0:12} is recorded but its dir is missing/incomplete ($_ss_rt_dir). The pinned Bash gate cannot spawn — reinstall with tools/preflight-runtime-install.sh."
        fi
      fi
      # else: no branch-stable runtime installed (legacy in-tree .claude/hooks model) — silent, not an error.
    fi
  fi
fi
# Additive-hooks check: is a Bash PreToolUse hook registered in the TRACKED project layer?
if [ -f ".claude/settings.json" ] && command -v jq >/dev/null 2>&1 && [ -n "$RUNTIME_REPORT" ]; then
  _ss_proj_bash="$(jq -r '[(.hooks.PreToolUse // [])[] | select(.matcher=="Bash")] | length' ".claude/settings.json" 2>/dev/null || echo 0)"
  if [ "${_ss_proj_bash:-0}" -ge 1 ]; then
    RUNTIME_WARN="${RUNTIME_WARN}${RUNTIME_WARN:+\\\\n}⚠ BRANCH-STABILITY INCOMPLETE: .claude/settings.json (tracked) still registers a Bash PreToolUse hook that runs ALONGSIDE the pinned runtime and remains branch-swappable. Remove it so the only Bash gate is the local-layer pin."
  fi
fi

# Combine status + routing into additionalContext
# The status line gives metadata. The routing content gives behavioral rules.
FULL_CONTEXT="$STATUS"
if [ -n "$RUNTIME_REPORT" ]; then
  FULL_CONTEXT="$FULL_CONTEXT | $RUNTIME_REPORT"
fi
if [ -n "$RUNTIME_WARN" ]; then
  FULL_CONTEXT="$FULL_CONTEXT\\\\n\\\\n$RUNTIME_WARN"
fi
if [ -n "$REG_WARN" ]; then
  FULL_CONTEXT="$FULL_CONTEXT\\\\n\\\\n$REG_WARN"
fi
if [ -n "$HB_WARN" ]; then
  FULL_CONTEXT="$FULL_CONTEXT\\\\n\\\\n$HB_WARN"
fi
if [ -n "$ROUTING_CONTENT" ]; then
  # Escape for JSON: newlines, quotes, backslashes
  ESCAPED_ROUTING=$(echo "$ROUTING_CONTENT" | sed 's/\\\\/\\\\\\\\/g' | sed 's/\"/\\\\\"/g' | sed ':a;N;$!ba;s/\\n/\\\\n/g')
  FULL_CONTEXT="$FULL_CONTEXT\\n\\n$ESCAPED_ROUTING"
fi

# Output in Claude Code hook format
cat <<EOF
{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"$FULL_CONTEXT"}}
EOF
