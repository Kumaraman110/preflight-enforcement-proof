#!/usr/bin/env bash
# PreToolUse hook for Edit commands. Blocks edits to files that belong to
# an active coupling group when other files in that group have unresolved findings.
#
# This prevents the #1 cascade cause: fixing coupled findings independently.
# The LLM must acknowledge the full group (by writing a .preflight/gate/group-ack file)
# before editing any member of the group.
#
# INPUT CONTRACT:
#   Claude Code pipes a JSON object to stdin: {"tool_name":"Edit",
#   "tool_input":{"file_path":"...", "old_string":"...", "new_string":"..."}}.
#   We read stdin and extract tool_input.file_path via jq (or node/grep fallback).
#
# FAIL BEHAVIOR:
#   On well-formed JSON (the only input Claude Code produces), the gate
#   blocks edits to files in unacknowledged coupling groups. On malformed

# --- Heartbeat (passive liveness self-evidencing) ---
_hb_self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_hb_plugin_root="$(cd "$_hb_self_dir/.." && pwd)"
[ -f "$_hb_plugin_root/lib/heartbeat.sh" ] && source "$_hb_plugin_root/lib/heartbeat.sh"
# Fail-SAFE: undefined function under `set -e` would exit 127 before gate logic
# (a blocking gate would fail OPEN). No-op fallback so heartbeat can't crash the gate.
type _write_heartbeat &>/dev/null || _write_heartbeat() { :; }
_write_heartbeat "coupled-edit-gate"

#   JSON (which Claude Code does not produce), extraction yields empty,
#   and the gate passes through. A grep-blob fallback was deliberately
#   rejected because file_path appears in EVERY Edit tool call — grepping
#   raw stdin would always match, causing false blocks that deadlock the
#   session. The fail-open on malformed JSON is safe because the gate only
#   matters when active-groups.json exists (transient orchestrator state).
#
# Evidence:
#   .preflight/gate/active-groups.json — written by the orchestrator when Stage 1
#     returns NEEDS_FIXES with grouped findings. Contains:
#     [{"files": ["A.cs", "B.cs"], "findings": [...], "acknowledged": false}, ...]
#
#   When the orchestrator reads ALL findings in a group and designs a coherent fix,
#   it sets "acknowledged": true for that group. Only then can edits proceed.
#
# Exit 0 = allow the edit
# Exit 2 = block the edit (outputs reason to stderr; Claude Code blocks on exit 2)

set -euo pipefail

STDIN_JSON="$(cat)"
GATE_DIR=".preflight/gate"
GROUPS_FILE="$GATE_DIR/active-groups.json"

# Resolve the framework root for the BLOCKED help-text path below. Use the same idiom every
# other component uses — NEVER the empty CLAUDE_PLUGIN_ROOT (empty off-plugin, which is the live
# install path; the old message printed a broken "/hooks/write-group-ack"). CLAUDE_PROJECT_DIR
# is unset in some hook contexts, so the git/pwd fallback is what resolves there.
FRAMEWORK_ROOT="${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}/.claude"

# ─── Extract file_path from stdin JSON ───────────────────────
FILE_PATH=""
if command -v jq &>/dev/null; then
  FILE_PATH=$(printf '%s' "$STDIN_JSON" | jq -r '.tool_input.file_path // empty' 2>/dev/null || echo "")
elif command -v node &>/dev/null; then
  FILE_PATH=$(printf '%s' "$STDIN_JSON" | node -e "let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{try{const j=JSON.parse(d);process.stdout.write((j.tool_input&&j.tool_input.file_path)||'')}catch(e){}})" 2>/dev/null || echo "")
else
  FILE_PATH=$(printf '%s' "$STDIN_JSON" | grep -o '"file_path"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 | sed 's/.*"file_path"[[:space:]]*:[[:space:]]*"//;s/"$//' || echo "")
fi

# If extraction yielded nothing (malformed JSON), pass through.
# See FAIL BEHAVIOR in header: file_path is too common to grep-fallback safely.
if [ -z "$FILE_PATH" ]; then
  exit 0
fi

# If no active groups file exists, no coupling enforcement is active
if [ ! -f "$GROUPS_FILE" ]; then
  exit 0
fi

# ─── H3: canonicalize the incoming path to repo-relative form ─────────────────
# The real Edit/Write tool sends an ABSOLUTE file_path (e.g. /repo/Services/Token.cs), but
# active-groups.json stores repo-RELATIVE paths (Services/Token.cs). The old exact-string compare
# (gsub "\\"→"/" only, no canonicalization) MISSED the absolute and ./-prefixed forms → UNACKED=0 →
# silent ALLOW on every coupled block (the live path). Fix: LEXICALLY canonicalize the incoming path
# to repo-relative (no realpath/on-disk dependency — an Edit may target a not-yet-created file), then
# match by exact-equality OR /-anchored-suffix against each (likewise-canonicalized) stored path.
# LEXICAL only (no realpath/on-disk dependency): \→/, collapse ALL runs of repeated / into a single /
# (multi-pass — so 'X///Token.cs' and 'X//Token.cs' fold to 'X/Token.cs'), strip a leading repo-root
# prefix, strip leading ./, strip a leading /, and strip TRAILING /(s) from a file target (so
# 'X/Token.cs/' folds to 'X/Token.cs'). RESULT: every representation that denotes the same governed
# file — forward/back slash, doubled/tripled separators, trailing separator, ./-prefixed, repo-absolute,
# drive- or UNC-qualified absolute — canonicalizes to the SAME repo-relative form and therefore reaches
# the SAME policy decision (the enforcement invariant). The authoritative suffix-match below compares
# this against each (likewise-canonicalized) stored member.
REPO_TOP="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
_canon_path() {  # $1 = a path; echoes its lexical repo-relative canonical form. Always returns 0.
  local p="$1"
  p="${p//\\//}"                       # backslash -> forward slash
  while case "$p" in *//*) true ;; *) false ;; esac; do p="${p//\/\///}"; done   # collapse ALL // runs -> / (multi-pass: '///'->'/' too)
  # Strip the repo-root prefix if the path is absolute and under the repo (so /repo/Services/X -> Services/X).
  if [ -n "$REPO_TOP" ]; then
    local top="${REPO_TOP//\\//}"
    case "$p" in
      "$top"/*) p="${p#"$top"/}" ;;   # exact repo-root prefix + /
    esac
  fi
  while case "$p" in */./*) true ;; *) false ;; esac; do p="${p//\/.\///}"; done   # collapse embedded '/./' -> '/' (multi-pass; a current-dir no-op segment)
  case "$p" in */.) p="${p%/.}" ;; esac   # strip a trailing '/.' (current-dir no-op)
  while [ "${p#./}" != "$p" ]; do p="${p#./}"; done   # strip leading ./ (repeatable)
  p="${p#/}"                           # strip a single leading / (path outside repo-root, best-effort)
  while [ -n "$p" ] && [ "$p" != "${p%/}" ]; do p="${p%/}"; done   # strip TRAILING /(s): a file target, never a dir form
  # NOTE: '.' (current-dir) segments are folded above — purely lexical, always safe. A '..' (parent)
  # segment is NOT folded: lexical '..' collapse is unsound when the preceding segment is a symlink, so
  # 'X/foo/../Token.cs' is left as-is (treated as a non-member) rather than improvise an unsafe path
  # model. This is a documented residual, not a regression (see docs/parity-gate-limitations.md scope).
  printf '%s' "$p"
  return 0
}
CANON_FP="$(_canon_path "$FILE_PATH")"

# FAIL CLOSED on unreadable state (L1): the groups file EXISTS (coupling
# enforcement is active) but may be corrupt or wrong-shape. The old
# `jq ... || echo "0"` turned any parse failure into count-zero-and-ALLOW —
# a malformed groups file silently disabled coupling enforcement. The file's
# schema is a BARE ARRAY of group objects (written by hooks/write-active-groups);
# anything else is unreadable state and must block, never pass. Validated HERE,
# before the basename fast-path below — a corrupt file that happens not to
# contain the edited file's basename must not slip through the fast-path.
_groups_unreadable_block() {
  cat >&2 <<EOF
BLOCKED: coupling enforcement is active but the groups file is unreadable.

$GROUPS_FILE exists but is not the expected bare JSON array of group objects
(written by hooks/write-active-groups). A corrupt or wrong-shape groups file
must not silently disable coupling enforcement — failing closed.

To proceed: regenerate the file (bash hooks/write-active-groups '<json-array>')
or clear enforcement explicitly (bash hooks/write-active-groups '[]').
EOF
  exit 2
}
if command -v jq &>/dev/null; then
  jq -e 'type == "array"' "$GROUPS_FILE" >/dev/null 2>&1 || _groups_unreadable_block
elif python3 -c "pass" &>/dev/null || python -c "pass" &>/dev/null; then
  _PY=$(python3 -c "pass" 2>/dev/null && echo "python3" || echo "python")
  $_PY -c "
import json,sys
g=json.load(open('$GROUPS_FILE'))
sys.exit(0 if isinstance(g,list) else 1)
" 2>/dev/null || _groups_unreadable_block
else
  # No JSON parser available — cannot validate shape. The groups file EXISTS
  # (coupling enforcement is active) but we cannot verify it is the expected
  # bare-array shape. A garbage file that happens to mention a filename would
  # bypass enforcement via the grep fallback below. Fail CLOSED.
  _groups_unreadable_block
fi

# If the file isn't tracked at all, allow (it's outside any coupling group). This is ONLY a
# fast-path skip BEFORE the authoritative canonical-suffix membership check below — it must never
# be more permissive than that check. Two cross-platform-correctness requirements:
#   (1) Key off the CANONICAL basename, not raw $FILE_PATH. The old `basename "$FILE_PATH"` relied on
#       the external basename SPLITTING on the path separator — but GNU/coreutils basename does NOT
#       treat backslash as a separator while MSYS basename does. So a backslash member path
#       (Services\Token.cs) yielded the whole string on Linux, the grep missed the '/'-stored entry,
#       and the gate exited 0 BEFORE the authoritative check → a Linux-only fail-OPEN. CANON_FP has
#       already normalized backslashes→slashes (line 103, pure bash, identical on every platform), so
#       `${CANON_FP##*/}` is the separator-correct basename with no external/platform dependency.
#   (2) Match with `grep -qF -- ` (fixed-string, end-of-options): the basename may contain regex
#       metacharacters (Service[1].cs, Service+.cs) or a leading '-'; a fixed-string anchored needle
#       avoids a regex accident or option-injection that could make the skip wrongly fire (fail open).
_canonical_basename="${CANON_FP##*/}"
if ! grep -qF -- "$_canonical_basename" "$GROUPS_FILE" 2>/dev/null; then
  exit 0
fi

# Find which group this file belongs to and check acknowledgment.
# H3 (path-form robustness): a group MEMBERSHIP match is now exact-canonical OR a /-anchored suffix —
#   the incoming path is canonicalized to repo-relative (CANON_FP, above) and each stored path is
#   canonicalized the same way (backslash->slash, strip leading ./ and /); a stored repo-relative path
#   matches when it EQUALS the incoming canonical path OR is a /-anchored suffix of it (covers the
#   absolute and ./-prefixed forms the real Edit tool sends). The /-anchor (the leading "/" in the
#   endswith) prevents a shared-basename false positive: "Services/Token.cs" is a suffix of
#   "/repo/Services/Token.cs" but NOT of "/repo/OtherDir/Token.cs" (no "/Services/Token.cs" tail) nor of
#   ".../XServices/Token.cs" (the char before "Services" is "X", not "/").
# H4 (acknowledgement robustness): a group counts as UNACKNOWLEDGED unless acknowledged is the explicit
#   boolean true — `!= true` (jq) / `is not True` (python) / a count-based all-true check (grep). So
#   false / missing / null / "false"-string / 0 ALL block; only an affirmative true clears. This closes
#   the missing-acknowledged fail-open (jq `== false` treated a missing field as null != false -> allow).
# All three backends use the SAME canonical-suffix + non-true semantics (parity requirement).
if command -v jq &>/dev/null; then
  UNACKED=$(jq -r --arg fp "$CANON_FP" '
    def canon: gsub("\\\\"; "/") | gsub("/+"; "/") | gsub("(/\\.)+/"; "/") | sub("/\\.$"; "") | sub("^(\\./)+"; "") | sub("^/+"; "") | sub("/+$"; "");
    [ .[]
      | select(.acknowledged != true)
      | select(.files[]? | canon as $sf | ($sf != "") and (($fp == $sf) or ($fp | endswith("/" + $sf))))
    ] | length
  ' "$GROUPS_FILE" 2>/dev/null) || _groups_unreadable_block
elif python3 -c "pass" &>/dev/null || python -c "pass" &>/dev/null; then
  PY=$(python3 -c "pass" 2>/dev/null && echo "python3" || echo "python")
  UNACKED=$(CANON_FP="$CANON_FP" GROUPS_FILE="$GROUPS_FILE" $PY -c "
import json,os,re
fp=os.environ['CANON_FP']
def canon(s):
    s=s.replace('\\\\','/')
    s=re.sub(r'/+','/',s)
    s=re.sub(r'(?:/\\.)+/','/',s)
    s=re.sub(r'/\\.$','',s)
    s=re.sub(r'^(\\./)+','',s)
    s=re.sub(r'^/+','',s)
    s=re.sub(r'/+$','',s)
    return s
groups=json.load(open(os.environ['GROUPS_FILE']))
def member(g):
    for f in g.get('files',[]):
        sf=canon(f)
        if sf and (fp==sf or fp.endswith('/'+sf)):
            return True
    return False
# acknowledged clears ONLY on the explicit boolean True (mirrors jq != true): missing/false/null/'false'/0 block.
count=sum(1 for g in groups if (g.get('acknowledged',False) is not True) and member(g))
print(count)
" 2>/dev/null) || _groups_unreadable_block
else
  # Last resort: no jq AND no python. Imprecise but FAIL-CLOSED (extra blocks OK; never a missed block).
  # We are past the basename fast-path, so the file IS mentioned. Allow ONLY if EVERY group is explicitly
  # acknowledged:true (acknowledged-true count >= group count) — a missing/false/null acknowledged on ANY
  # group (which grep cannot correlate to a specific file) blocks all coupled edits, the safe direction.
  GROUP_CT=$(grep -oE '"files"' "$GROUPS_FILE" | grep -c . 2>/dev/null || echo 0)
  ACKTRUE_CT=$(grep -oE '"acknowledged"[[:space:]]*:[[:space:]]*true' "$GROUPS_FILE" | grep -c . 2>/dev/null || echo 0)
  if [ "$GROUP_CT" -gt 0 ] && [ "$ACKTRUE_CT" -ge "$GROUP_CT" ]; then
    UNACKED="0"
  else
    UNACKED="1"
  fi
fi

if [ "$UNACKED" != "0" ] && [ "$UNACKED" != "" ]; then
  cat >&2 <<EOF
BLOCKED: This file belongs to a coupling group with unresolved findings.

You MUST read ALL findings in this group before editing ANY file in it.
Fixing coupled findings independently is the #1 cause of cascading regressions
(48% of review round cost in cascading regression scenarios).

To proceed:
1. Read all findings for this coupling group
2. Design ONE coherent change that addresses all findings simultaneously
3. Write acknowledgment: bash "${FRAMEWORK_ROOT}/hooks/write-group-ack" "<group-index>"
4. Then edit the files

File: $FILE_PATH
EOF
  exit 2
fi

exit 0
