#!/usr/bin/env bash
# PreToolUse hook for Bash commands. Only activates the gate when
# the command is a git push. All other bash commands pass through.
#
# INPUT CONTRACT (corrected):
#   Claude Code pipes a JSON object to stdin: {"tool_name":"Bash",
#   "tool_input":{"command":"..."}, ...}. We read stdin and extract
#   tool_input.command via jq. As a fallback (if jq fails or JSON is
#   malformed), we grep the raw stdin blob for 'git push' so a push is
#   never silently allowed.
#
# Exit 0 = allow the tool call
# Exit 2 = block the tool call (stderr fed back to Claude; Claude Code blocks on exit 2)

# ── SELF-WATCHDOG — fail CLOSED on a wedged/slow gate (gap: wedge fail-open) ───
# This hook is registered with a 10s platform timeout (hooks.json). If a subprocess
# wedges (git blocked on a credential/SSH prompt, jq on a stalled NFS read, a herestring
# scan on a pathological blob), the PLATFORM SIGKILLs the hook at 10s. That kill surfaces
# as exit 124/137 — and per the PreToolUse protocol ONLY exit 2 blocks; any other code
# (124, 137, 1, 127, …) is a NON-blocking error, so the push then proceeds UNGATED. A
# safety gate that wedges must NEVER wave a push through.
#
# Fix: re-exec the real hook body as a CHILD under a SHORTER internal deadline (default 8s SIGTERM,
# +1s grace → 9s SIGKILL — under the 10s platform kill, leaving ~1s margin for the parent to emit its
# decision). If the child reaches a real decision it exits 0 (allow) or 2 (block) and the parent relays
# that EXACT code + the child's already-written stdout (the AUTO/CONFIRM JSON, inherited straight
# through) / stderr. If the child does NOT finish in time — timeout's 124, a signal-kill >128, or ANY
# code that is neither 0 nor 2 — the parent maps it to exit 2 (BLOCK): a wedged or crashed gate fails
# CLOSED. This is the user-facing guarantee: a gate too slow to RENDER a push-safety verdict in time
# BLOCKS the push, it never waves it through ungated.
#
# DEADLINE is env-tunable via PREFLIGHT_PUSH_GATE_DEADLINE (seconds), clamped to [2,9] so it can never
# exceed the platform kill. Why tunable: on a pathologically slow subprocess-spawn host (e.g. this
# Windows/Git-Bash box — the hook makes dozens of grep/jq/git spawns, measured ~13s for a trivial body
# and ~37s for a full push body, so even a NORMAL unwedged run there far exceeds 10s — meaning the
# UNFIXED hook ALREADY fails open on that host, killed by the platform at 10s). The behavioral tests do
# NOT raise this knob; they instead drive the body directly (_PFG_WATCHDOG_CHILD=1) to isolate the
# DECISION logic from the watchdog, the same posture as their per-probe `timeout 60`. The knob exists for
# operators on slow hosts who want headroom up to the 9s clamp. Production hosts (sub-second spawns) use
# the 8s default, safely under the 10s kill.
#
# `_PFG_WATCHDOG_CHILD` breaks the re-exec recursion (the child skips this block and runs the body).
# `timeout` absent (non-coreutils host) → degrade to running the body inline, no worse than the pre-fix
# behavior. This block runs BEFORE `set -euo pipefail` so the timeout's non-zero return cannot itself
# abort the parent.
if [ -z "${_PFG_WATCHDOG_CHILD:-}" ] && command -v timeout >/dev/null 2>&1; then
  _pfg_deadline="${PREFLIGHT_PUSH_GATE_DEADLINE:-8}"
  case "$_pfg_deadline" in (*[!0-9]*|'') _pfg_deadline=8 ;; esac   # non-numeric → default
  [ "$_pfg_deadline" -lt 2 ] && _pfg_deadline=2                    # floor
  [ "$_pfg_deadline" -gt 9 ] && _pfg_deadline=9                    # ceiling: never exceed the 10s kill
  # CAPTURE the child's stdout/stderr to FILES rather than letting it inherit the parent's (= the
  # platform's) stdout pipe. CRITICAL: a wedged git can leave an orphaned grandchild (a credential
  # helper, ssh-askpass, the test's `sleep`) that INHERITS whatever stdout fd the child had. If that
  # fd were the platform's stdout pipe, the orphan would hold it open AFTER this hook exits, and a
  # platform that reads hook stdout to EOF before applying the verdict would BLOCK on that read until
  # its OWN 10s kill — re-introducing the very fail-open (137) this watchdog exists to remove. Writing
  # to files means the orphan only ever holds a file fd (harmless); the parent's real stdout is never
  # inherited downward, so the platform sees EOF the instant the parent exits with its decision.
  # stdin (the piped hook JSON) is still inherited so the child's `STDIN_JSON="$(cat)"` reads it.
  _pfg_co="$(mktemp 2>/dev/null)" || _pfg_co="${TMPDIR:-/tmp}/.pfg-co.$$"
  _pfg_ce="$(mktemp 2>/dev/null)" || _pfg_ce="${TMPDIR:-/tmp}/.pfg-ce.$$"
  _PFG_WATCHDOG_CHILD=1 timeout -k 1 "$_pfg_deadline" bash "$0" "$@" >"$_pfg_co" 2>"$_pfg_ce"
  _wd_rc=$?
  if [ "$_wd_rc" -eq 0 ] || [ "$_wd_rc" -eq 2 ]; then
    # Real decision — relay the child's captured stdout (AUTO/CONFIRM JSON) + stderr, then its exit code.
    cat "$_pfg_co" 2>/dev/null; cat "$_pfg_ce" >&2 2>/dev/null
    rm -f "$_pfg_co" "$_pfg_ce" 2>/dev/null
    exit "$_wd_rc"
  fi
  # 124 (timeout SIGTERM), 137 (SIGKILL after -k grace), 143, or any other abnormal code: the body did
  # not reach a decision in time → FAIL CLOSED (block), never fall through to allow. Relay any partial
  # child stderr for diagnosis, then emit the watchdog's own block reason.
  cat "$_pfg_ce" >&2 2>/dev/null
  rm -f "$_pfg_co" "$_pfg_ce" 2>/dev/null
  echo "BLOCKED: pre-push-gate-check did not reach a decision within its ${_pfg_deadline}s safety deadline (rc=${_wd_rc})." >&2
  echo "  A push-safety subprocess (git/jq) wedged or the gate stalled. Failing CLOSED: the push is" >&2
  echo "  BLOCKED rather than allowed ungated. Retry; if it persists, run the push from a human shell" >&2
  echo "  after confirming the target. (Watchdog fail-closed; see docs/parity-gate-limitations.md.)" >&2
  exit 2
fi

set -euo pipefail


# --- Heartbeat (passive liveness self-evidencing) ---
_hb_self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_hb_plugin_root="$(cd "$_hb_self_dir/.." && pwd)"
[ -f "$_hb_plugin_root/lib/heartbeat.sh" ] && source "$_hb_plugin_root/lib/heartbeat.sh"
# Fail-SAFE: if heartbeat.sh was unreachable, the function is undefined; under
# `set -e` the call would exit 127 BEFORE the gate logic runs — a blocking gate
# would then fail OPEN (127 != 2). Define a no-op so the heartbeat can never
# crash the host gate. The diagnostic just goes silent when the lib is absent.
type _write_heartbeat &>/dev/null || _write_heartbeat() { :; }
_write_heartbeat "pre-push-gate-check"
# NOTE on wedge coverage: the heartbeat above (and the config-overlay lib sourced below) make a
# few git/jq calls INSIDE sourced functions, which the Layer-2 `_pfg_git`/`_pfg_jq` wrappers do
# NOT intercept. These are local-repo reads (`git rev-parse HEAD`, a config-file `jq`), the LEAST
# wedge-prone calls (no network/credential round-trip). The Layer-1 self-watchdog above is the
# COMPREHENSIVE backstop: it wraps the entire body, so a wedge ANYWHERE — including these — still
# fails CLOSED (exit 2) at the watchdog deadline. Layer 2 is the FAST-PATH for the network-facing
# push-target resolution (`git remote get-url`), the call that actually wedges in practice.

# Per-clone topology overlay (issue #6): source the shared resolver so branch.base /
# branch.remote honor a gitignored .preflight/config.local.json. Best-effort — if the
# lib is missing (older install), _pfg_branch_field falls back to committed config.
_PFG_SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
for _pfg_overlay_lib in "$_PFG_SELF_DIR/../lib/config-overlay.sh" "$_PFG_SELF_DIR/../.claude/lib/config-overlay.sh"; do
  if [ -f "$_pfg_overlay_lib" ]; then
    # shellcheck source=/dev/null
    source "$_pfg_overlay_lib" 2>/dev/null || true
    break
  fi
done

# ── Subprocess wedge-bounding (Layer 2 of the fail-closed conversion) ─────────
# Each wedge-prone external call (git remote get-url, git rev-parse, jq config read) is run
# under a SHORT per-call timeout, so a SINGLE stalled subprocess fails closed in ~3s with a
# precise diagnostic instead of riding the 7s self-watchdog backstop. Fail direction CLOSED:
# a TIMED-OUT call (124) or signal-kill (137) sets a FILESYSTEM wedge flag — a shell variable
# would not survive the `$(...)` subshells these calls run inside, but a file write does — and
# the main shell checks the flag at each allow/ask decision point and BLOCKS (exit 2). A NORMAL
# non-zero (e.g. `git remote get-url` exit 2 for an absent remote) is NOT a wedge: it is a
# legitimate empty result, left to the existing `|| true` fail-open-by-design resolution paths.
_PFG_SUBPROC_TIMEOUT=3
_PFG_WEDGE_FLAG="${TMPDIR:-/tmp}/.pfg-wedge.$$"
rm -f "$_PFG_WEDGE_FLAG" 2>/dev/null || true
trap 'rm -f "$_PFG_WEDGE_FLAG" 2>/dev/null || true' EXIT
_pfg_have_timeout() { command -v timeout >/dev/null 2>&1; }
# Bounded subprocess runner. CRITICAL: the timed call writes to a TEMP FILE, never a
# command-substitution pipe. A wedged subprocess can spawn a child (credential helper, the
# git-stub's `sleep`) that INHERITS the capture fd; with `$(timeout 3 cmd)` the outer pipe
# then stays open until that orphaned grandchild dies, so the substitution HANGS for the full
# wedge despite `timeout` having already reaped the direct child. Writing to a file and reading
# it AFTER timeout returns waits only on the direct child timeout manages — the orphan lingers
# harmlessly. `-k 1`: a subprocess that ignores SIGTERM is SIGKILLed 1s later. stdin from
# /dev/null so a read-blocked subprocess can't stall either.
_pfg_bounded() {  # $1 = binary (git|jq) ; $@ = its args. Echoes stdout; ALWAYS returns 0.
  # SHORT-CIRCUIT: once anything has wedged, the decision is already going to BLOCK at the next
  # checkpoint — don't pay another timeout per remaining call (6+ git/jq lookups would otherwise
  # stack to >18s and blow the watchdog/platform budget). Return empty instantly.
  [ -f "$_PFG_WEDGE_FLAG" ] && return 0
  local bin="$1"; shift
  local tmp rc; tmp="$(mktemp 2>/dev/null)" || tmp="${TMPDIR:-/tmp}/.pfg-out.$$.$RANDOM"
  if _pfg_have_timeout; then timeout -k 1 "$_PFG_SUBPROC_TIMEOUT" "$bin" "$@" >"$tmp" 2>/dev/null </dev/null; rc=$?
  else                       "$bin" "$@" >"$tmp" 2>/dev/null </dev/null; rc=$?; fi
  if [ "$rc" -eq 124 ] || [ "$rc" -eq 137 ] || [ "$rc" -eq 125 ]; then
    : > "$_PFG_WEDGE_FLAG" 2>/dev/null || true   # 124=timed out, 137=SIGKILLed, 125=timeout internal error
  fi
  cat "$tmp" 2>/dev/null || true
  rm -f "$tmp" 2>/dev/null || true
  return 0
}
_pfg_git() { _pfg_bounded git "$@"; }   # bounded git (remote get-url / rev-parse) — wedge-prone
_pfg_jq()  { _pfg_bounded jq  "$@"; }   # bounded jq (config-file reads) — wedge-prone on stalled FS
# Checkpoint: call immediately before ANY allow/ask emission. If a bounded subprocess wedged,
# the push target could not be fully verified → fail CLOSED (block), never allow/ask on it.
_pfg_wedge_block_if_flagged() {
  if [ -f "$_PFG_WEDGE_FLAG" ]; then
    echo "BLOCKED: a push-safety subprocess (git/jq) timed out (~${_PFG_SUBPROC_TIMEOUT}s) while resolving the" >&2
    echo "  push target — the destination could not be fully verified. Failing CLOSED: the push is BLOCKED" >&2
    echo "  rather than allowed on an unresolved target. Retry; if it persists, push from a human shell after" >&2
    echo "  confirming the remote. (Subprocess wedge-bound; see docs/parity-gate-limitations.md.)" >&2
    exit 2
  fi
}

STDIN_JSON="$(cat)"

# Primary: extract the command field via jq (bounded — a wedge here falls to the raw-blob
# fallback below, which fail-safely greps for 'git push'; no flag needed on this path).
if _pfg_have_timeout; then
  COMMAND="$(printf '%s' "$STDIN_JSON" | timeout "$_PFG_SUBPROC_TIMEOUT" jq -r '.tool_input.command // empty' 2>/dev/null || true)"
else
  COMMAND="$(printf '%s' "$STDIN_JSON" | jq -r '.tool_input.command // empty' 2>/dev/null || true)"
fi

# Fallback: if extraction yielded nothing, use the raw blob so a push
# is still detected (fail-safe for the push case; non-pushes still pass).
if [ -z "$COMMAND" ]; then
  COMMAND="$STDIN_JSON"
fi

# ── SENTINEL-MINT TRIPWIRE (gap #5) ───────────────────────────────────────────
# Blocks, for the AGENT's Bash tool, shell commands that MINT the two protected
# gate-clearance sentinels:
#   .preflight/gate/bootstrap-write-approved  (human lead approval to overwrite
#                                              CLAUDE.md/.preflight/config.json)
#   .preflight/gate/parity-clean              (human-only parity clearance —
#                                              by convention, see
#                                              docs/parity-gate-limitations.md)
# Write-shaped references trip it: redirection into the sentinel path; a write
# verb (tee/touch/cp/mv/install/dd/truncate) taking the path as an argument;
# sed -i on the path; and ANY `write-gate-evidence parity-clean` invocation
# (parity-clean is the one evidence name an agent must never write — tests-pass/
# stage1-clean/map-validated remain legitimate agent evidence and pass).
# Read-shaped references (cat/ls/grep on the paths) pass.
#
# HONESTY LABEL: this is a HEURISTIC pattern tripwire on the agent Bash tool
# only — bypassable via obfuscation (variables, base64, python -c, etc.); it
# raises effort, not impossibility. The mechanical ceiling remains server-side
# (required reviewers / branch protection) — see docs/parity-gate-limitations.md.
# ADDITIVE + EARLY by design: runs before all push/pr-create routing and never
# touches the config-overlay/guard logic below.
_TRIP_SENT='\.preflight[/\\]+gate[/\\]+(bootstrap-write-approved|parity-clean)'
_TRIP_PRE='(^|[;&|([:space:]`])'
_trip_block() {
  echo "BLOCKED: agent must not mint gate-clearance evidence ($1)." >&2
  echo "  Bootstrap approval and parity-clean are HUMAN-ONLY — do not create, copy, or edit these" >&2
  echo "  sentinel files from the agent. Surface to a human, who runs the approval/clearance step" >&2
  echo "  from their own shell. See docs/parity-gate-limitations.md." >&2
  echo "  (HEURISTIC agent Bash-tool tripwire only — not server-side protection.)" >&2
  exit 2
}
if printf '%s' "$COMMAND" | grep -qE "$_TRIP_SENT"; then
  # (a) redirection (> or >>) targeting a protected sentinel path
  if printf '%s' "$COMMAND" | grep -qE ">>?[[:space:]]*[\"']?[^[:space:]\"';|&]*${_TRIP_SENT}"; then
    _trip_block "shell redirection into a protected sentinel path"
  fi
  # (b) write verb taking the sentinel path as an argument
  if printf '%s' "$COMMAND" | grep -qE "${_TRIP_PRE}(tee|touch|cp|mv|install|dd|truncate)[[:space:]][^;|&]*${_TRIP_SENT}"; then
    _trip_block "write command targeting a protected sentinel path"
  fi
  # (c) in-place sed on the sentinel path
  if printf '%s' "$COMMAND" | grep -qE "${_TRIP_PRE}sed[[:space:]][^;|&]*${_TRIP_SENT}" \
     && printf '%s' "$COMMAND" | grep -qE "sed[[:space:]][^;|&]*(-[a-zA-Z]*i|--in-place)"; then
    _trip_block "in-place sed on a protected sentinel path"
  fi
fi
# (d) write-gate-evidence invoked with the human-only gate name, any path form
if printf '%s' "$COMMAND" | grep -qE "write-gate-evidence[\\\\\\\"]?[[:space:]]+[\\\\\\\"]?parity-clean"; then
  _trip_block "'write-gate-evidence parity-clean' — parity-clean is human-only"
fi
# (e) OBVIOUS OBFUSCATION PATTERNS targeting sentinel paths (raise-the-bar layer).
# An agent that already knows the sentinel format can still mint it via shell
# obfuscation; this catches the plain-shaped obfuscations without raising
# false positives on legitimate commands. HEURISTIC — bypassable by determined
# obfuscation; the mechanical ceiling remains server-side.
if printf '%s' "$COMMAND" | grep -qE "$_TRIP_SENT"; then
  # base64 decode into sentinel
  if printf '%s' "$COMMAND" | grep -qE "(base64[[:space:]]+(-d|--decode)|python[[:space:]]+-c[[:space:]]*[\\\\\\\"]*base64).*${_TRIP_SENT}"; then
    _trip_block "obfuscated base64 decode into protected sentinel path"
  fi
  # variable/parameter expansion writing sentinel
  if printf '%s' "$COMMAND" | grep -qE "(\\$[A-Za-z_][A-Za-z0-9_]*|\\$\\{[A-Za-z_][A-Za-z0-9_]*\\})[[:space:]]*>[[:space:]]*[\\\\\\\"]?[^[:space:]\\\\\\\"]*${_TRIP_SENT}"; then
    _trip_block "variable-expanded write into protected sentinel path"
  fi
  # python -c / eval with explicit sentinel path string
  if printf '%s' "$COMMAND" | grep -qE "(python[[:space:]]+-c|perl[[:space:]]+-e|node[[:space:]]+-e)[[:space:]]*[\\\\\\\"][^\\\\\\\"]*${_TRIP_SENT}"; then
    _trip_block "script-eval write into protected sentinel path"
  fi
  # command substitution writing sentinel
  if printf '%s' "$COMMAND" | grep -qE "(\\$\\([^)]*\\)|\\\`[^\\\`]*\\\`)[[:space:]]*>[[:space:]]*[\\\\\\\"]?[^[:space:]\\\\\\\"]*${_TRIP_SENT}"; then
    _trip_block "command-substitution write into protected sentinel path"
  fi
fi
# ── end sentinel-mint tripwire ────────────────────────────────────────────────

# ── REPO-AWARENESS (NEW-2 fix) ────────────────────────────────────────────────
# This guard must resolve config + canonical remote from the repo the push
# ACTUALLY targets, NOT the session root. A session rooted in repo A (e.g. a
# consumer with config.branch.remote=poc) that pushes repo B (e.g. the framework
# source repo, whose canonical origin differs) must read B's config — otherwise A's
# config false-blocks B's legitimate push (the observed NEW-2 over-block: it blocked
# a verified-safe `cd <framework-repo> && git push origin <branch>`).
#
# Signal: honor a leading `cd <dir>` in the command (the compound `cd X && git push`
# pattern the agent commonly emits — and exactly the shape that was false-blocked),
# else fall back to the hook's own cwd (= session root, which is correct for an
# in-repo push: a consumer pushing its own `origin`=legacy-prod SHOULD still block).
# A repo with no .preflight/config.json → fail-open (unchanged additive posture).
_pfg_target_cwd() {  # $1 = command string; echo the cwd the git command runs in. Always returns 0.
  local cmd="$1" cwd cd_dir
  cwd="$(pwd)"
  if printf '%s' "$cmd" | grep -qE '(^|;|&&|\|)[[:space:]]*cd[[:space:]]'; then
    cd_dir="$(printf '%s' "$cmd" | grep -oE '(^|;|&&|\|)[[:space:]]*cd[[:space:]]+[^&|;]+' | head -1 | sed -E 's/.*cd[[:space:]]+//; s/[[:space:]]+$//')"
    # strip one layer of surrounding quotes
    cd_dir="${cd_dir%[\"\']}"; cd_dir="${cd_dir#[\"\']}"
    if [ -n "$cd_dir" ] && [ -d "$cd_dir" ]; then cwd="$cd_dir"; fi
  fi
  printf '%s' "$cwd"
  return 0
}
# The cwd the push/pr-create command will execute in (repo-aware anchor for ALL
# config + git resolution below). Computed ONCE from the command string.
PFG_TARGET_CWD="$(_pfg_target_cwd "$COMMAND")"

# ── Resolve canonical repo (owner/repo) from config.branch.remote. Fail-open. ─
# Shared by the #3a pr-create guard below and reused by the #6b push guard.
# REPO-AWARE: reads config from the PUSH-TARGET repo (PFG_TARGET_CWD), not the session root.
_pfg_config() {  # echo the resolved .preflight/config.json path, or nothing. Always returns 0.
  local top
  top="$(_pfg_git -C "$PFG_TARGET_CWD" rev-parse --show-toplevel 2>/dev/null || echo "")"
  [ -z "$top" ] && top="$PFG_TARGET_CWD"
  local c="$top/.preflight/config.json"
  if [ -f "$c" ]; then echo "$c"; fi
  return 0
}
_pfg_branch_field() {  # $1 = base|remote ; echo value or empty (overlay → jq → node → grep)
  local cfg="$1" field="$2"
  [ -z "$cfg" ] && return 0
  # Per-clone topology overlay (issue #6): branch.remote/base may be corrected by a
  # gitignored .preflight/config.local.json (the inverted-clone fix). The overlay lib
  # enforces the allowlist — gate thresholds and forbidden-lists are NOT overlayable
  # (and _pfg_branch_array below deliberately never consults the overlay at all).
  # Fail-open: lib missing or no jq/node → committed-config path below, unchanged.
  if declare -F overlay_resolve >/dev/null 2>&1 && { command -v jq &>/dev/null || command -v node &>/dev/null; }; then
    overlay_resolve "branch.$field" "$cfg" 2>/dev/null || true
    return 0
  fi
  if command -v jq &>/dev/null; then
    _pfg_jq -r ".branch.$field // empty" "$cfg" 2>/dev/null || true
  elif command -v node &>/dev/null; then
    node -e "try{const c=require('$cfg');process.stdout.write((c.branch&&c.branch.$field)||'')}catch(e){}" 2>/dev/null || true
  else
    grep -oE "\"$field\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" "$cfg" | head -1 | sed 's/.*"\([^"]*\)"$/\1/' || true
  fi
}
# Normalize a git remote URL (https or ssh) to "owner/repo" (strip .git).
_pfg_url_to_slug() {
  printf '%s' "$1" | sed -E 's#^git@[^:]+:#https://x/#; s#^https?://[^/]+/##; s#\.git$##' | sed -E 's#^/+##'
}

# Emit stdin as a JSON string LITERAL (surrounding quotes + escaped) for the permissionDecisionReason
# value. jq is UTF-8-safe; node is the fallback; a last-ditch sed escapes the JSON-critical chars so the
# stdout JSON never breaks (a malformed permissionDecision payload would be ignored by the platform →
# fail-open to normal permission flow, which for a CONFIRM case is acceptable, but we escape properly).
_pfg_json_string() {
  if command -v jq &>/dev/null; then
    jq -Rs . 2>/dev/null && return 0
  fi
  if command -v node &>/dev/null; then
    node -e "let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>process.stdout.write(JSON.stringify(d.replace(/\n+$/,''))))" 2>/dev/null && return 0
  fi
  # Fallback: escape backslash, double-quote, CR, tab, and newline; wrap in quotes.
  printf '"%s"' "$(sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/\r//g' -e 's/\t/ /g' | tr '\n' ' ')"
}

# ── Forbidden-destination denylist (A1 fix) ───────────────────────────────────
# The two guards below historically derived their SINGLE notion of "safe target"
# from config.branch.remote ("anything != the configured remote is bad"). That is
# exactly backwards on an INVERTED clone where the configured remote IS the
# dangerous one (observed live: branch.remote=origin, but origin=legacy prod that
# must never be touched; the real target is a DIFFERENT remote). The guard then
# blocked the correct push AND recommended pushing to the legacy repo.
#
# Fix: an EXPLICIT denylist the guard checks the RESOLVED target against, REGARDLESS
# of branch.remote. branch.forbiddenRemotes = remote NAMES that must never be pushed
# to; branch.forbiddenRepos = owner/repo slugs (or URLs) that must never be targeted
# by push or `gh pr create`. Fail-open exactly like the rest of this guard: absent or
# unparseable config → empty lists → inert (never newly blocks an opted-out repo).
_pfg_branch_array() {  # $1 = cfg path ; $2 = field ; echo array values, one per line.
  local cfg="$1" field="$2"
  [ -z "$cfg" ] || [ ! -f "$cfg" ] && return 0
  if command -v jq &>/dev/null; then
    _pfg_jq -r ".branch.${field}[]? // empty" "$cfg" 2>/dev/null || true
  elif command -v node &>/dev/null; then
    node -e "try{const c=require('$cfg');const a=(c.branch&&c.branch.$field)||[];a.forEach(x=>console.log(x))}catch(e){}" 2>/dev/null || true
  else
    # Best-effort grep fallback (labeled): pull quoted strings from the field's array,
    # dropping the first match (the field name itself). jq is the primary path.
    grep -oE "\"$field\"[[:space:]]*:[[:space:]]*\[[^]]*\]" "$cfg" 2>/dev/null \
      | grep -oE '"[^"]*"' | sed -n '2,$p' | sed 's/^"//; s/"$//' || true
  fi
}
# Is $1 (a remote NAME) on the forbidden-remotes list $2 (newline-separated names)?
_pfg_remote_forbidden() {
  local name="$1" hay="$2" line
  [ -z "$name" ] && return 1
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    [ "$line" = "$name" ] && return 0
  done <<< "$hay"
  return 1
}
# Is $1 (an owner/repo slug) on the forbidden-repos list $2 (entries may be slugs OR URLs)?
_pfg_repo_forbidden() {
  local slug="$1" hay="$2" line
  [ -z "$slug" ] && return 1
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    [ "$(_pfg_url_to_slug "$line")" = "$slug" ] && return 0
  done <<< "$hay"
  return 1
}

# ── GAP-A hardening: conservative prod-PATTERN heuristic (no explicit denylist needed) ─────────
# GAP-A was: a configured remote that IS prod but is NOT on forbiddenRepos, on an unprotected
# branch, classified AUTO → the agent silently auto-pushed to prod. The denylist closed it only
# when the operator opted in. This adds an ALWAYS-ON conservative net: if the remote's URL/slug
# carries a HIGH-CONFIDENCE prod signal, flip AUTO → CONFIRM (never BLOCK — a human may still push
# to prod deliberately, just never SILENTLY). Conservative by design (false-positive here only
# adds ONE confirmation, never blocks; but a false-positive on a safe remote is still friction, so
# the patterns are deliberately narrow): a token must appear as a WHOLE path/name SEGMENT — bounded
# by start/end, '/', '.', '-', '_', or ':' — so 'reproduce'/'product-catalog'/'proddy' do NOT match
# 'prod', and 'reliable' does NOT match 'live'. Matches: prod, production, prd, release, live,
# legacy + the known legacy-prod repo basename 'cpsl'. Case-insensitive on the slug only (the
# owner/repo + host path), not on arbitrary URL noise.
# Override/extend via branch.prodPatterns (committed config only; NOT overlayable — same posture as
# the forbidden lists). HONESTY: this is a NAME heuristic — a prod remote named blandly (e.g.
# 'app-final') will NOT match; the explicit forbiddenRepos denylist remains the operator's
# precise tool. Raises the bar on the OBVIOUS case; does not claim completeness.
# NOTE on the pattern set: only TRULY GENERIC prod tokens are built in. A project-specific legacy-prod
# repo name (e.g. the migration program's 'CPSL') is DELIBERATELY NOT a built-in — it would false-positive
# on a safe sibling that merely shares the fragment (observed: 'cyf.cpsl_core', the real migration TARGET,
# vs 'CPSL', the legacy prod). Project-specific prod repos belong on the operator's explicit
# branch.forbiddenRepos denylist (precise, no collateral), or in branch.prodPatterns if wanted.
_PFG_PROD_PATTERNS_BUILTIN='prod production prd release live legacy'
_pfg_remote_looks_prod() {  # $1 = slug-or-url ; $2 = extra newline-separated patterns (optional). 0 = looks prod.
  local hay="$1" extra="${2:-}" tok
  [ -z "$hay" ] && return 1
  # Lowercase for case-insensitive segment matching.
  hay="$(printf '%s' "$hay" | tr '[:upper:]' '[:lower:]')"
  # A segment boundary is: start-of-string, end-of-string, or one of / . - _ :
  for tok in $_PFG_PROD_PATTERNS_BUILTIN; do
    printf '%s' "$hay" | grep -qE "(^|[/._:-])${tok}([/._:-]|\$)" && return 0
  done
  # Operator-supplied extra patterns (committed branch.prodPatterns), same segment-boundary rule.
  if [ -n "$extra" ]; then
    while IFS= read -r tok; do
      [ -z "$tok" ] && continue
      tok="$(printf '%s' "$tok" | tr '[:upper:]' '[:lower:]')"
      printf '%s' "$hay" | grep -qE "(^|[/._:-])${tok}([/._:-]|\$)" && return 0
    done <<< "$extra"
  fi
  return 1
}

# ── GAP-A hardening (opt-in strict mode): a SAFE-REMOTES allowlist ─────────────────────────────
# When the operator sets branch.safeRemotes (committed config; NOT overlayable), AUTO is restricted
# to remotes whose NAME or resolved SLUG is on that list — everything else (including the configured
# remote, if it isn't listed) → CONFIRM. This inverts the default to fail-SAFE for operators who want
# it: AUTO only for explicitly-blessed remotes. ABSENT (the default) → this is INERT (returns "on the
# list" for everything) so the AUTO tier is preserved unchanged for consumers who never opt in — no
# friction regression. The one cost when ENABLED: the first push to a new safe remote needs one
# confirmation until it is added to the list (the documented trade for fail-safe AUTO).
_pfg_remote_on_safelist() {  # $1 = remote name ; $2 = resolved slug ; $3 = safeRemotes (newline list). 0 = allowed/AUTO-ok.
  local name="$1" slug="$2" list="$3" line
  [ -z "$list" ] && return 0   # no allowlist configured → INERT (everything is AUTO-eligible)
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    [ "$line" = "$name" ] && return 0
    [ -n "$slug" ] && [ "$(_pfg_url_to_slug "$line")" = "$slug" ] && return 0
  done <<< "$list"
  return 1
}

# ── #3a: guard `gh pr create` against a FORBIDDEN or NON-CANONICAL repo ───────
# `gh pr create` with no --repo resolves the repo from the cwd's default remote,
# which on migration clones is often origin = the legacy production repo. Two
# layered checks, FORBIDDEN FIRST:
#   (0) FORBIDDEN-REPO denylist (A1): if the RESOLVED target slug is on
#       config.branch.forbiddenRepos, block — REGARDLESS of branch.remote. This is
#       the check that holds even when branch.remote itself points at the dangerous
#       repo (the inverted-clone case where the canonical comparison is backwards).
#   (1) NON-CANONICAL: target != slug(branch.remote) → block (the original guard).
# Block (exit 2), for the AGENT's Bash tool only. Buildable-LOCAL with a server-side
# CEILING (agent's Bash tool only). FAIL-OPEN: inert if config is absent/unparseable
# — see docs/parity-gate-limitations.md. Block messages DELIBERATELY do NOT recommend
# a specific remote/repo: on an inverted clone the "canonical" value is itself the
# dangerous one, so steering toward it is the original A1 defect. Surface to a human.
if printf '%s' "$COMMAND" | grep -qE '(^|&&|\|\||;|")\s*gh[[:space:]]+pr[[:space:]]+create'; then
  PR_CMD="$(printf '%s' "$COMMAND" | grep -oE 'gh[[:space:]]+pr[[:space:]]+create[^&|;]*' | head -1 || true)"
  CFG="$(_pfg_config)"
  CANON_REMOTE="$(_pfg_branch_field "$CFG" remote)"
  FORBIDDEN_REPOS="$(_pfg_branch_array "$CFG" forbiddenRepos)"
  # Resolve canonical slug from the configured remote's URL (fail-open if unresolvable).
  CANON_SLUG=""
  if [ -n "$CANON_REMOTE" ]; then
    CANON_URL="$(_pfg_git -C "$PFG_TARGET_CWD" remote get-url "$CANON_REMOTE" 2>/dev/null || true)"
    [ -n "$CANON_URL" ] && CANON_SLUG="$(_pfg_url_to_slug "$CANON_URL")"
  fi
  # Resolve the slug this pr-create would ACTUALLY target: explicit --repo if present,
  # else the cwd default remote (origin) — exactly what gh resolves with no --repo.
  REPO_ARG="$(printf '%s' "$PR_CMD" | grep -oE -- '--repo[=[:space:]]+[^[:space:]]+' | head -1 | sed -E 's/--repo[=[:space:]]+//' || true)"
  TARGET_SLUG=""
  if [ -n "$REPO_ARG" ]; then
    TARGET_SLUG="$(_pfg_url_to_slug "$REPO_ARG")"
  else
    DEFAULT_URL="$(_pfg_git -C "$PFG_TARGET_CWD" remote get-url origin 2>/dev/null || true)"
    [ -n "$DEFAULT_URL" ] && TARGET_SLUG="$(_pfg_url_to_slug "$DEFAULT_URL")"
  fi

  # (0) FORBIDDEN-REPO pre-check — fires regardless of branch.remote.
  if [ -n "$TARGET_SLUG" ] && _pfg_repo_forbidden "$TARGET_SLUG" "$FORBIDDEN_REPOS"; then
    echo "BLOCKED: 'gh pr create' targets a FORBIDDEN repo '$TARGET_SLUG' (config.branch.forbiddenRepos)." >&2
    echo "  This destination is explicitly off-limits (e.g. a legacy production repo). Do NOT retarget automatically —" >&2
    echo "  surface to a human; see docs/parity-gate-limitations.md." >&2
    echo "  (Agent Bash-tool guard only; not server-side protection.)" >&2
    exit 2
  fi

  # (1) NON-CANONICAL check (original behavior; messages de-steered).
  if [ -n "$CANON_SLUG" ]; then
    if [ -n "$REPO_ARG" ]; then
      # (a) explicit --repo present → must equal canonical.
      if [ "$TARGET_SLUG" != "$CANON_SLUG" ]; then
        echo "BLOCKED: 'gh pr create --repo $REPO_ARG' targets a non-canonical repo (expected the configured target from config.branch.remote)." >&2
        echo "  On migration clones the wrong repo is often the legacy production repo. Do NOT assume the configured remote is safe —" >&2
        echo "  if the configured remote is itself wrong, surface to a human; see docs/parity-gate-limitations.md." >&2
        echo "  (Agent Bash-tool guard only; not server-side protection — see docs/parity-gate-limitations.md.)" >&2
        exit 2
      fi
    else
      # (b) no --repo → gh would resolve from the cwd default remote. Compare that to canonical.
      if [ -n "$TARGET_SLUG" ] && [ "$TARGET_SLUG" != "$CANON_SLUG" ]; then
        echo "BLOCKED: 'gh pr create' has no --repo; it would resolve to '$TARGET_SLUG' (cwd default remote), not the configured target." >&2
        echo "  On migration clones the default 'origin' is often the legacy production repo. Confirm the intended repo with a human" >&2
        echo "  before retrying; see docs/parity-gate-limitations.md." >&2
        echo "  (Agent Bash-tool guard only; not server-side protection — see docs/parity-gate-limitations.md.)" >&2
        exit 2
      fi
    fi
  fi
  # Canonical / not-forbidden / fail-open → allow the pr-create. Not a push; nothing more to gate here.
  # FAIL-CLOSED checkpoint: if remote-slug resolution above wedged, the forbidden/non-canonical checks
  # ran on UNRESOLVED slugs (could not prove the target is safe) — block rather than allow a pr-create.
  _pfg_wedge_block_if_flagged
  exit 0
fi

# Only gate on git push commands
if ! printf '%s' "$COMMAND" | grep -qE '(^|&&|\|\||;|")\s*git\s+push'; then
  exit 0
fi

# ── #6b: force-push + wrong-remote guard (BEFORE the evidence gate) ───────────
# Block, for the AGENT's Bash tool, two irreversible mistakes prose alone forbids:
#   (A) force-push (--force / -f / --force-with-lease) to a PROTECTED branch
#       (config.branch.base, plus main/master always), and
#   (B) push to a NON-CANONICAL remote (anything other than config.branch.remote —
#       notably `origin`, which on these clones is the legacy CPSL prod repo).
#
# Scope/ceiling (see docs/parity-gate-limitations.md): this guards the agent's Bash
# tool ONLY — not a human shell, a CI token, or another machine. True protection is
# server-side branch protection. It is also FAIL-OPEN: if config is absent/unparseable
# it does NOT block (additive guard; never newly blocks a repo that didn't opt in).

# Isolate the single `git push …` invocation from any compound command for parsing.
PUSH_CMD="$(printf '%s' "$COMMAND" | grep -oE 'git[[:space:]]+push[^&|;]*' | head -1 || true)"

# Resolve config (fail-open on any miss). jq → node → grep fallback, same idiom as other hooks.
# REPO-AWARE (NEW-2): config comes from the PUSH-TARGET repo, not the session root — so a
# session rooted in repo A that pushes repo B reads B's config (B's canonical remote), which is
# what makes the wrong-remote comparison correct cross-repo. _pfg_config already anchors on
# PFG_TARGET_CWD; reuse it here so the #6b block and the #3a block resolve identically.
CONFIG="$(_pfg_config)"
BASE=""; REMOTE=""
if [ -f "$CONFIG" ]; then
  # Route through _pfg_branch_field (single source): committed config, with the
  # issue-#6 config.local.json topology overlay applied when the lib is present.
  BASE="$(_pfg_branch_field "$CONFIG" base)"
  REMOTE="$(_pfg_branch_field "$CONFIG" remote)"
fi

# Forbidden destinations (A1): remote NAMES and repo SLUGS that must never be pushed
# to, REGARDLESS of branch.remote. Read via the shared helpers (jq → node → grep, fail-open).
FORBIDDEN_REMOTES="$(_pfg_branch_array "$CONFIG" forbiddenRemotes)"
FORBIDDEN_REPOS="$(_pfg_branch_array "$CONFIG" forbiddenRepos)"
# GAP-A hardening (committed config only; NOT overlayable — same posture as the forbidden lists):
#   prodPatterns  — extra segment-tokens that flag a remote as prod (extends the built-in net).
#   safeRemotes   — opt-in allowlist; when set, AUTO is restricted to listed remotes (fail-safe).
PROD_PATTERNS="$(_pfg_branch_array "$CONFIG" prodPatterns)"
SAFE_REMOTES="$(_pfg_branch_array "$CONFIG" safeRemotes)"

# Protected branch names: config base (if any) + main/master always.
PROTECTED_BRANCHES="main master"
[ -n "$BASE" ] && PROTECTED_BRANCHES="$PROTECTED_BRANCHES $BASE"

# Does the push carry a force flag of any kind?
HAS_FORCE=false
if printf '%s' "$PUSH_CMD" | grep -qE '(^|[[:space:]])(--force-with-lease([=[:space:]]|$)|--force([[:space:]]|$)|-f([[:space:]]|$))'; then
  HAS_FORCE=true
fi

# Token-scan the push args (drop `git push` and any flags) → [remote] [refspec...].
PUSH_ARGS="$(printf '%s' "$PUSH_CMD" | sed -E 's/^git[[:space:]]+push//')"
POSITIONAL=""
for tok in $PUSH_ARGS; do
  case "$tok" in
    -*) ;;                       # skip flags (--force, -u, --force-with-lease=…, etc.)
    *)  POSITIONAL="$POSITIONAL $tok" ;;
  esac
done
set -- $POSITIONAL
ARG_REMOTE="${1:-}"             # first positional = remote (if named)
ARG_REFSPEC="${2:-}"           # second positional = refspec (if named)

# (B0) FORBIDDEN-DESTINATION pre-check (A1) — fires REGARDLESS of branch.remote.
# This is the check that holds on an INVERTED clone where branch.remote itself names
# the dangerous remote. Match the named push remote against forbiddenRemotes, AND its
# resolved URL slug against forbiddenRepos (covers `git push <url> …` and a forbidden
# remote reached under a different name). De-steered: never recommends a remote.
if [ -n "$ARG_REMOTE" ]; then
  ARG_REMOTE_SLUG=""
  ARG_REMOTE_URL="$(_pfg_git -C "$PFG_TARGET_CWD" remote get-url "$ARG_REMOTE" 2>/dev/null || true)"
  if [ -n "$ARG_REMOTE_URL" ]; then
    ARG_REMOTE_SLUG="$(_pfg_url_to_slug "$ARG_REMOTE_URL")"
  else
    # Not a known remote name — it may be an inline URL positional. Normalize it directly.
    case "$ARG_REMOTE" in *://*|*@*:*|*/*) ARG_REMOTE_SLUG="$(_pfg_url_to_slug "$ARG_REMOTE")" ;; esac
  fi
  if _pfg_remote_forbidden "$ARG_REMOTE" "$FORBIDDEN_REMOTES" \
     || { [ -n "$ARG_REMOTE_SLUG" ] && _pfg_repo_forbidden "$ARG_REMOTE_SLUG" "$FORBIDDEN_REPOS"; }; then
    echo "BLOCKED: push targets a FORBIDDEN destination '$ARG_REMOTE' (config.branch.forbiddenRemotes/forbiddenRepos)." >&2
    echo "  This remote is explicitly off-limits (e.g. a legacy production repo). Do NOT retarget automatically —" >&2
    echo "  surface to a human; see docs/parity-gate-limitations.md." >&2
    echo "  (Agent Bash-tool guard only; not server-side protection.)" >&2
    exit 2
  fi
fi

# (B-bare) UNVALIDATABLE BARE PUSH: a `git push` with NO named remote (e.g. bare `git push`,
# `git push -u`, `git push --force`) resolves to git's DEFAULT remote (the branch's upstream, or
# `origin`) — a target this guard NEVER SEES, so the forbidden-destination (B0) and wrong-remote (B)
# checks above are SILENTLY SKIPPED and the push sails through unvalidated. On an inverted clone where
# the default/upstream remote is legacy PROD, that is an ungated push-to-prod. You cannot confirm a
# remote you did not name. So: when this repo has OPTED IN to preflight push-gating (a config with
# branch.remote is present), REQUIRE the remote be named explicitly so it becomes validatable — then
# the B0/B checks run on it. FAIL-OPEN otherwise: no config / no configured remote → not opted in →
# do NOT newly block (same additive-guard posture as the rest of this file).
#
# ── THREE-TIER REVERSIBILITY POLICY (AUTO / CONFIRM / BLOCK) ──────────────────────────────────────
# The push-safety tiers below are computed MECHANICALLY from the signals already resolved above
# (PROTECTED_BRANCHES, REMOTE, FORBIDDEN_*, HAS_FORCE, ARG_REMOTE) — never the agent's judgement.
#   BLOCK   (exit 2)                : irreversible-and-never-OK → force-push to a protected branch, and
#                                     the explicit forbidden-destination block (B0, above).
#   CONFIRM (exit 0 + permissionDecision:ask) : consequential/high-blast-radius but a human MAY choose
#                                     to proceed → push to a PROTECTED branch, to a PROD/non-canonical
#                                     remote (closes GAP A — a configured-remote push to a prod-looking
#                                     target is now ASK, not silent allow), or a BARE push (unvalidatable
#                                     target). The platform prompts the user; the agent cannot self-approve.
#   AUTO    (exit 0, fall through to the evidence gate) : reversible/low-blast-radius → named SAFE remote,
#                                     UNPROTECTED branch, non-force. The friction being removed: the agent
#                                     just pushes (after the evidence gate), no human copy-paste handoff.
# PROTOCOL NOTE (Claude Code PreToolUse): exit 0 + JSON on stdout XOR exit 2 — they cannot be combined
# (JSON is ignored on exit 2). So the HARD BLOCK (force-to-protected) exits 2 here; the CONFIRM tier is
# deferred until AFTER the evidence gate (a missing/stale-evidence exit 2 is itself a hard block that must
# win over a CONFIRM). We set CONFIRM_REASON now, run the evidence gate, then emit the tier decision.
CONFIRM_REASON=""

# Resolve the would-be target branch (refspec dest after ':', else named ref, else current branch).
TARGET_BRANCH="${ARG_REFSPEC##*:}"
if [ -z "$TARGET_BRANCH" ]; then
  TARGET_BRANCH="$(_pfg_git -C "$PFG_TARGET_CWD" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
fi

# (A) HARD BLOCK — force-push to a protected branch (irreversible history rewrite; never auto, never
# merely-confirm). Preserved exactly as before: exit 2.
if [ "$HAS_FORCE" = true ]; then
  for pb in $PROTECTED_BRANCHES; do
    if [ "$TARGET_BRANCH" = "$pb" ]; then
      echo "BLOCKED: force-push (--force/-f/--force-with-lease) to protected branch '$pb'." >&2
      echo "  Shared branches must never be force-pushed — even --force-with-lease rewrites shared history." >&2
      echo "  (Agent Bash-tool guard only; not server-side protection — see docs/parity-gate-limitations.md.)" >&2
      exit 2
    fi
  done
fi

# (B-bare) CONFIRM — bare 'git push' (no named remote): the target is unvalidatable (default/upstream
# remote this guard cannot see → could be prod). Was a hard BLOCK; now CONFIRM so a human can proceed
# deliberately, never silently. Only when push-gating is opted in (REMOTE set); fail-open otherwise.
if [ -z "$CONFIRM_REASON" ] && [ -n "$PUSH_CMD" ] && [ -z "$ARG_REMOTE" ] && [ -n "$REMOTE" ]; then
  CONFIRM_REASON="Bare 'git push' with no named remote — the target is UNVALIDATABLE (git's default/upstream remote, which the guard cannot see, may be the legacy production repo). Name the remote explicitly so it is checked, or confirm this push is intended. (Agent Bash-tool guard only; not server-side protection.)"
fi

# (B) CONFIRM — push to a PROD/non-canonical remote. A NAMED remote that isn't the configured one, OR
# (GAP A close) the configured remote itself resolving to a FORBIDDEN/prod slug. Was: wrong-remote → BLOCK,
# configured-prod → silent ALLOW. Now both → CONFIRM (the human may push to prod deliberately, not silently).
if [ -z "$CONFIRM_REASON" ] && [ -n "$ARG_REMOTE" ]; then
  if [ -n "$REMOTE" ] && [ "$ARG_REMOTE" != "$REMOTE" ]; then
    CONFIRM_REASON="Push targets remote '$ARG_REMOTE', not the configured remote '$REMOTE' (config.branch.remote). On an inverted clone the named remote may be a legacy production repo. Confirm this is the intended target. (Agent Bash-tool guard only; not server-side protection.)"
  else
    # GAP A: the configured remote could itself be prod. Resolve its slug ONCE and run three checks,
    # each of which flips the otherwise-AUTO configured-remote push to CONFIRM (never silent prod push):
    #   (1) EXPLICIT denylist — the slug is on config.branch.forbiddenRepos (operator's precise tool).
    #   (2) PROD-PATTERN heuristic (GAP-A hardening) — the slug/URL carries a high-confidence prod
    #       signal (prod/production/prd/release/live/legacy/cpsl as a whole segment, + branch.prodPatterns).
    #       This is the ALWAYS-ON net that closes the silent-auto-push-to-prod hole with NO opt-in.
    #   (3) SAFE-REMOTES allowlist (GAP-A opt-in strict mode) — if branch.safeRemotes is set and this
    #       remote/slug is NOT on it → CONFIRM. Inert (no flip) when safeRemotes is absent, so the AUTO
    #       tier is preserved by default for consumers who never opt in.
    _AR_URL="$(_pfg_git -C "$PFG_TARGET_CWD" remote get-url "$ARG_REMOTE" 2>/dev/null || true)"
    _AR_SLUG=""
    if [ -n "$_AR_URL" ]; then _AR_SLUG="$(_pfg_url_to_slug "$_AR_URL")"
    else case "$ARG_REMOTE" in *://*|*@*:*|*/*) _AR_SLUG="$(_pfg_url_to_slug "$ARG_REMOTE")" ;; esac; fi
    # The signal the heuristic inspects: the resolved slug if we have one, else the raw remote URL,
    # else the remote name itself (covers a remote named e.g. 'prod' with no resolvable URL).
    _AR_PROBE="${_AR_SLUG:-${_AR_URL:-$ARG_REMOTE}}"
    if [ -n "$_AR_SLUG" ] && _pfg_repo_forbidden "$_AR_SLUG" "$FORBIDDEN_REPOS"; then
      CONFIRM_REASON="Push targets '$ARG_REMOTE' (→ $_AR_SLUG), which is on the forbidden/prod denylist (config.branch.forbiddenRepos) — even though it is the configured remote. A push to prod must be a deliberate human confirmation, never silent. (Agent Bash-tool guard only; not server-side protection.)"
    elif _pfg_remote_looks_prod "$_AR_PROBE" "$PROD_PATTERNS"; then
      CONFIRM_REASON="Push targets '$ARG_REMOTE' (→ ${_AR_PROBE}), which matches a PRODUCTION-name pattern (prod/production/release/live/legacy/…). Even though it is the configured remote, a push to a prod-looking target must be a deliberate human confirmation, never silent. If this remote is actually safe, add it to config.branch.safeRemotes (or confirm to proceed). (Heuristic name match — agent Bash-tool guard only; not server-side protection.)"
    elif ! _pfg_remote_on_safelist "$ARG_REMOTE" "$_AR_SLUG" "$SAFE_REMOTES"; then
      CONFIRM_REASON="Push targets '$ARG_REMOTE' (→ ${_AR_PROBE}), which is NOT on config.branch.safeRemotes (strict-mode allowlist is enabled). AUTO is restricted to explicitly-blessed remotes; confirm this push, or add the remote to safeRemotes. (Agent Bash-tool guard only; not server-side protection.)"
    fi
  fi
fi

# (C) CONFIRM — push to a PROTECTED branch (main/master/config.base), even on the safe remote, non-force.
# Landing on a protected/shared branch is consequential; the human confirms. (Force-to-protected already
# hard-blocked above.)
if [ -z "$CONFIRM_REASON" ] && [ -n "$TARGET_BRANCH" ]; then
  for pb in $PROTECTED_BRANCHES; do
    if [ "$TARGET_BRANCH" = "$pb" ]; then
      CONFIRM_REASON="Push lands on PROTECTED branch '$pb' (a shared/integration branch). Confirm this is intended — safe topic-branch pushes proceed automatically, but a push to a protected branch is consequential. (Agent Bash-tool guard only; not server-side protection.)"
      break
    fi
  done
fi

# Not a hard-blocked operation — run the evidence gate FIRST (a missing/stale-evidence exit 2 is a hard
# block that must win over CONFIRM). pre-push-gate exits 2 to block, or returns 0 when evidence is fresh.
# A wedge during the tier-signal resolution above (remote slugs / target branch) means the CONFIRM/AUTO
# classification was computed on an unresolved target — block before even running the evidence gate.
_pfg_wedge_block_if_flagged

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
set +e
# Redirect stdin from /dev/null: the parent already consumed its stdin (STDIN_JSON="$(cat)" at the top),
# so the inherited fd is an exhausted pipe. Detaching the child's stdin avoids any downstream git/jq op
# blocking on it, and matches the original `exec` form's effective behavior without replacing the process.
# NO separate timeout here: this whole body already runs INSIDE the Layer-1 self-watchdog child, whose
# deadline bounds the evidence gate's git rev-parse/diff along with everything else (a wedged evidence
# gate is caught by the watchdog → fail-closed exit 2). A redundant tight sub-timeout was tried and
# REMOVED — on a slow-spawn host it false-blocked a LEGITIMATE fresh-evidence run (the gate's own
# spawn tax, not a wedge, exceeded the cap), which is a fail-CLOSED-the-wrong-way regression. The
# 124/137 remap below stays as defence-in-depth in case a future caller runs this body unwrapped.
bash "$SCRIPT_DIR/pre-push-gate" </dev/null
EVIDENCE_RC=$?
set -e
if [ "$EVIDENCE_RC" -eq 124 ] || [ "$EVIDENCE_RC" -eq 137 ] || [ "$EVIDENCE_RC" -gt 128 ]; then
  echo "BLOCKED: the pre-push evidence gate wedged (rc=$EVIDENCE_RC) resolving HEAD/diff — failing CLOSED." >&2
  echo "  Could not verify gate evidence is fresh for the pushed code; the push is BLOCKED, not allowed." >&2
  exit 2
fi
if [ "$EVIDENCE_RC" -ne 0 ]; then
  exit "$EVIDENCE_RC"   # evidence gate blocked (exit 2) — hard block, JSON would be ignored anyway.
fi

# Evidence is fresh. Now emit the tier decision (exit 0 + JSON, per the PreToolUse protocol).
# FINAL fail-closed checkpoint: a CONFIRM (ask) or AUTO (allow) must only be emitted on a FULLY
# resolved target. If any bounded git/jq call wedged while computing the remote slug / target branch,
# the tier could be wrong (e.g. a forbidden-prod remote whose slug never resolved) → BLOCK instead.
_pfg_wedge_block_if_flagged
if [ -n "$CONFIRM_REASON" ]; then
  # CONFIRM tier: ask the user. permissionDecision:ask escalates to a human confirmation prompt; the
  # agent CANNOT self-approve (the accountability property — the consequential push is gated to a human).
  printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"ask","permissionDecisionReason":%s}}\n' \
    "$(printf '%s' "CONSEQUENTIAL PUSH — confirm to proceed. $CONFIRM_REASON" | _pfg_json_string)"
  exit 0
fi
# AUTO tier: reversible/low-blast-radius (named safe remote, unprotected branch, non-force, evidence
# fresh). Fall through with exit 0 + explicit allow so the safe push proceeds with NO human handoff —
# the friction being removed.
printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"allow","permissionDecisionReason":"Reversible push: unprotected branch to the configured safe remote, non-force, gate evidence fresh."}}\n'
exit 0
