#!/usr/bin/env bash
# pre-push-gate-check — COMPATIBILITY SHIM (preflight P0 router/engine split).
#
# This name USED to be the monolithic Bash gate registered for every Bash call. The P0 fix split it into:
#   hooks/pre-bash-risk-router  — the fast, builtins-only, zero-spawn router (now the registered Bash hook)
#   hooks/pre-push-gate-engine  — the heavy enforcement engine (invoked by the router for candidates only)
#
# This shim is RETAINED so that (a) a stale registration that still points at `pre-push-gate-check`, and
# (b) the existing selfcheck/behavioral probes that invoke this name, all keep working with the CORRECT
# new behavior: it simply delegates to the router. It performs NO enforcement itself; it adds no spawn on
# the ordinary path beyond what the router does. Prefer registering `pre-bash-risk-router` directly
# (hooks/hooks.json already does); this shim is the safety net for older installs.
#
# CONTRACT: identical to the router — stdin = tool JSON; exit 0 = allow, exit 2 = block, stdout relayed.
_SHIM_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROUTER="$_SHIM_DIR/pre-bash-risk-router"
if [ -f "$ROUTER" ]; then
  exec bash "$ROUTER" "$@"
fi
# Router missing (a broken/partial install): fail SAFE for the ordinary path. We cannot classify without
# the router, but we also must not block all Bash. Read stdin and only block if it CONTAINS a push/PR/
# sentinel risk token (cheap builtin check) — otherwise allow. This mirrors the router's fail-containment
# when its engine is missing, applied one level up.
IFS= read -r -d '' _BLOB || true
case "$_BLOB" in
  *push*|*gh*pr*create*|*parity-clean*|*bootstrap-write-approved*|*write-gate-evidence*|*.preflight/gate/*)
    echo "BLOCKED: pre-bash-risk-router missing — cannot adjudicate a candidate push/PR/sentinel command;" >&2
    echo "  failing CLOSED for this candidate only. Reinstall preflight to restore the router/engine." >&2
    exit 2 ;;
  *) exit 0 ;;   # ordinary command — allow (router absent must never disable ordinary Bash)
esac
