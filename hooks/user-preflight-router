#!/usr/bin/env bash
# user-preflight-router — the USER-LEVEL PreToolUse Bash router (v0.10.0 user-install).
#
# Registered ONCE in ~/.claude/settings.json (matcher "Bash") via the stable dispatcher. It runs for
# EVERY Bash tool call in EVERY repository the user opens — so its FIRST job is to get out of the way
# instantly for any repository that has not opted into Preflight.
#
# CONTRACT (PreToolUse): stdin = tool JSON {"tool_name":"Bash","tool_input":{"command":"..."},"cwd":"..."}.
#   exit 0 = allow · exit 2 = block (in-scope consequential candidate the engine blocked / could not
#   adjudicate) · exit 0 + permissionDecision JSON = CONFIRM/ask relayed from the engine.
#
# DESIGN INVARIANTS (mission Phase 2):
#   1. Exit immediately (exit 0) when the current repo has NOT opted into Preflight.
#   2. Activate only when the repo has a valid .preflight/config.json (or .cpsl/.forge equivalent).
#   3. Preserve the zero/near-zero ordinary-command fast path (delegates to the same builtins-only router).
#   4. Fail closed ONLY for in-scope consequential actions (never for ordinary commands / inactive repos).
#   5. Avoid running BOTH user-level and project-level Preflight twice: if the repo carries a PROJECT-level
#      Bash registration, this user-level router yields (exit 0) and lets the project hook own the decision.
#   6. Support normal repositories AND git worktrees (repo root via git, common-dir aware).
#   7. NEVER write to an application repository during passive routing (read-only discovery only).
#   8. NEVER treat local evidence as remote final authority (local gate is advisory/agent-resistant; the
#      remote required-check is the final authority — documented, not enforced here).
#
# This file performs read-only repo DISCOVERY (a bounded set of filesystem stats + at most one `git`
# rev-parse), then delegates the actual risk classification to the co-located pre-bash-risk-router, which
# is builtins-only on the ordinary fast path. It writes NOTHING to the application repo.

_URT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ── Read stdin ONCE, byte-preserve for the delegate (the tool JSON must reach the router intact) ──────────
IFS= read -r -d '' BLOB || true

# ── Extract cwd from the tool JSON (pure parameter expansion, zero spawn). Fall back to $PWD. ────────────
_URT_CWD=""
case "$BLOB" in
  *'"cwd":"'*)  _URT_CWD="${BLOB#*'"cwd":"'}";  _URT_CWD="${_URT_CWD%%\"*}" ;;
  *'"cwd": "'*) _URT_CWD="${BLOB#*'"cwd": "'}"; _URT_CWD="${_URT_CWD%%\"*}" ;;
esac
[ -n "$_URT_CWD" ] || _URT_CWD="$PWD"
# Un-escape JSON backslashes in the cwd (Windows paths arrive as C:\\Users\\...). Builtins only.
_URT_CWD="${_URT_CWD//\\\\/\\}"

# ── Extract tool_input.command (pure parameter expansion, zero spawn) for target-dir analysis. Last-quote
#    truncation can only drop trailing bytes, never an early governed token (fail-OPEN direction). ───────
_URT_CMD=""
case "$BLOB" in
  *'"command":"'*)  _URT_CMD="${BLOB#*'"command":"'}";  _URT_CMD="${_URT_CMD%\"*}" ;;
  *'"command": "'*) _URT_CMD="${BLOB#*'"command": "'}"; _URT_CMD="${_URT_CMD%\"*}" ;;
esac

# ── Locate the repository root from cwd WITHOUT spawning git on the fast path. Walk up looking for a repo
#    marker (.git dir/file) OR an opt-in config. Bounded to 40 levels. This is the ONLY discovery cost an
#    inactive repo pays: a handful of `[ -e ]` stats, no process spawn. ──────────────────────────────────
_urt_find_root() {  # sets _URT_ROOT (dir containing .git or an opt-in config), or empty
  local d="$1" i=0
  while [ -n "$d" ] && [ "$i" -lt 40 ]; do
    if [ -e "$d/.git" ]; then _URT_ROOT="$d"; return 0; fi
    # An opt-in config can also anchor the root even outside a git repo (rare, but supported).
    if [ -f "$d/.preflight/config.json" ] || [ -f "$d/.cpsl/config.json" ] || [ -f "$d/.forge.json" ]; then
      _URT_ROOT="$d"; return 0
    fi
    local parent; parent="$(dirname "$d")"
    [ "$parent" = "$d" ] && break
    d="$parent"; i=$((i+1))
  done
  _URT_ROOT=""; return 1
}
_URT_ROOT=""
_urt_find_root "$_URT_CWD"

# Helper: is a directory opted in? echoes the config path (empty if not).
_urt_config_at() {  # $1 = repo root
  local r="$1" c
  [ -n "$r" ] || return 1
  for c in "$r/.preflight/config.json" "$r/.cpsl/config.json" "$r/.forge.json"; do
    [ -f "$c" ] && { printf '%s' "$c"; return 0; }
  done
  return 1
}

# ── INVARIANT 1+2: opt-in gate. No config at the cwd's repo root → check whether the COMMAND ITSELF
#    explicitly targets an opted-in repo (fix for the review's F1/F2: `cd X && git push`, `git -C X push`,
#    `--git-dir=X`). If neither the cwd NOR an explicit command-target dir is opted in → allow instantly. ─
_URT_CONFIG=""; _URT_CONFIG="$(_urt_config_at "$_URT_ROOT" || true)"

if [ -z "$_URT_CONFIG" ]; then
  # The cwd is not opted in. Only bother inspecting the command if it looks like a governed candidate
  # (push / gh pr create|merge) — ordinary commands stay on the instant fast path regardless. Builtins only.
  case "$_URT_CMD" in
    *push*|*"pr create"*|*"pr merge"*|*"pr "*merge*|*"pr "*create*)
      # Extract an explicit target directory the command would operate in, spawn-free:
      #   `cd <dir> [&&|;] ...`   `git -C <dir> ...`   `--git-dir=<dir>`   `--git-dir <dir>`
      _URT_TGT=""
      case "$_URT_CMD" in
        *"-C "*)        _URT_TGT="${_URT_CMD#*-C }";        _URT_TGT="${_URT_TGT%%[ ;&|]*}" ;;
        *"--git-dir="*) _URT_TGT="${_URT_CMD#*--git-dir=}"; _URT_TGT="${_URT_TGT%%[ ;&|]*}"; _URT_TGT="${_URT_TGT%/.git}" ;;
        "cd "*)         _URT_TGT="${_URT_CMD#cd }";         _URT_TGT="${_URT_TGT%%[ ;&|]*}" ;;
        *"; cd "*)      _URT_TGT="${_URT_CMD#*; cd }";      _URT_TGT="${_URT_TGT%%[ ;&|]*}" ;;
        *"&& cd "*)     _URT_TGT="${_URT_CMD#*&& cd }";     _URT_TGT="${_URT_TGT%%[ ;&|]*}" ;;
      esac
      # strip surrounding quotes the shell would remove
      _URT_TGT="${_URT_TGT%\"}"; _URT_TGT="${_URT_TGT#\"}"; _URT_TGT="${_URT_TGT%\'}"; _URT_TGT="${_URT_TGT#\'}"
      if [ -n "$_URT_TGT" ]; then
        # resolve the target relative to cwd if it is not absolute
        case "$_URT_TGT" in /*|[A-Za-z]:*) : ;; *) _URT_TGT="$_URT_CWD/$_URT_TGT" ;; esac
        _URT_TROOT=""; _urt_find_root "$_URT_TGT"; _URT_TROOT="$_URT_ROOT"
        _URT_CONFIG="$(_urt_config_at "$_URT_TROOT" || true)"
        [ -n "$_URT_CONFIG" ] && _URT_ROOT="$_URT_TROOT"   # gate against the command's real target repo
      fi
      ;;
  esac
fi
if [ -z "$_URT_CONFIG" ]; then
  exit 0   # neither cwd nor an explicit command target is opted in → zero-friction fast path
fi

# ── INVARIANT 5: no double-exec. If the repo carries a PROJECT-level Preflight Bash registration, the
#    project hook will run for this same tool call (Claude Code hooks are additive/union across scopes).
#    Yield to it (exit 0) so the decision is made exactly once, by the project-pinned runtime. ──────────
#    FIX for the review's F3: require a REAL registration — a non-empty project router file AND a settings
#    file that actually registers a PreToolUse Bash hook whose command references the router (parsed with
#    jq when available; a hardened non-jq fallback still requires the command-shaped substring, not any
#    incidental occurrence). A bare stub + an incidental substring in a note field no longer yields. ────
_urt_project_owns() {  # returns 0 iff a project-level Bash Preflight hook is really registered
  local root="$1" hookf="" s
  for hookf in "$root/.claude/hooks/pre-bash-risk-router" "$root/.claude/hooks/run-hook.cmd"; do
    [ -s "$hookf" ] && break || hookf=""      # -s: exists AND non-empty (a bare stub does not count)
  done
  [ -n "$hookf" ] || return 1
  for s in "$root/.claude/settings.json" "$root/.claude/settings.local.json"; do
    [ -f "$s" ] || continue
    if command -v jq >/dev/null 2>&1 && jq empty "$s" 2>/dev/null; then
      # parsed: a PreToolUse Bash hook whose command references the project router
      local n
      n="$(jq -r '[(.hooks.PreToolUse // [])[] | select(.matcher=="Bash") | (.hooks // [])[] | select((.command // "") | test("pre-bash-risk-router|pre-push-gate-check|run-hook"))] | length' "$s" 2>/dev/null || echo 0)"
      [ "${n:-0}" -ge 1 ] && return 0
    else
      # no jq: require the registration SHAPE (command + router token), not any incidental substring
      case "$(cat "$s" 2>/dev/null)" in
        *'"command"'*pre-bash-risk-router*|*'"command"'*pre-push-gate-check*|*'"command"'*run-hook*) return 0 ;;
      esac
    fi
  done
  return 1
}
if _urt_project_owns "$_URT_ROOT"; then
  exit 0   # project-level Preflight really owns this repo → do not double-gate
fi

# ── INVARIANT 3+4: opted-in, user-level-owned → delegate to the builtins-only risk router, which keeps the
#    ordinary fast path zero-spawn and invokes the heavy engine ONLY for governed candidates (scoped
#    fail-closed). Re-feed the byte-preserved BLOB on stdin. The delegate never writes to the app repo. ──
DELEGATE="$_URT_DIR/pre-bash-risk-router"
if [ ! -f "$DELEGATE" ]; then
  # Missing delegate is an INSTALL fault, not a governed op → allow (invariant 4: fail closed only for
  # in-scope consequential candidates, which we cannot even classify without the delegate). The user-level
  # verify/doctor commands detect a missing delegate; passive routing must not block ordinary work.
  exit 0
fi
printf '%s' "$BLOB" | PF_USER_LEVEL=1 PF_REPO_ROOT="$_URT_ROOT" bash "$DELEGATE"
exit $?
