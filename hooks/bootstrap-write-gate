#!/usr/bin/env bash
# PreToolUse hook for Write and Edit. Blocks overwrites of an existing
# CLAUDE.md or .preflight/config.json unless an approval sentinel is
# present and fresh (HEAD-stamped).
#
# New-file creation always passes. Unrelated files always pass.
#
# FAIL BEHAVIOR:
#   On well-formed JSON (the only input Claude Code produces), the gate
#   fails CLOSED for the two protected files: a write to an existing
#   CLAUDE.md or .preflight/config.json without a fresh approval sentinel
#   is BLOCKED. On malformed JSON (which Claude Code does not produce),
#   the gate passes through. A substring fallback was deliberately rejected
#   because "CLAUDE.md" appears in legitimate file contents constantly and
#   would cause false blocks of normal edits. The existing fail-closed
#   branches for well-formed-but-problematic cases (unparseable sentinel,
#   not-in-git-repo) remain unchanged.
#
# INPUT CONTRACT:
#   Claude Code pipes a JSON object to stdin: {"tool_name":"Write",
#   "tool_input":{"file_path":"...", "content":"..."}, ...}. We read
#   stdin and extract tool_input.file_path via jq (or node/grep fallback).
#
# Exit 0 = allow
# Exit 2 = block (reason on stderr; Claude Code blocks on exit 2)
#
# DE-STEER (gap #5, Option A): the no-sentinel block message used to PRINT the
# exact mkdir+echo command that mints the approval sentinel — handing the blocked
# actor its own bypass (observed live: an agent ran the printed recipe and the
# next write passed). Same defect class as the A1 steering fix: a block message
# must never recommend the action that defeats the block. The message now tells
# the agent to surface to a HUMAN, who runs the approval step from their own
# shell. NOTE this is a de-steer, not a mechanical close — an agent that already
# knows the sentinel format can still mint it via shell (see the heuristic
# tripwire in pre-push-gate-check and docs/parity-gate-limitations.md).

set -uo pipefail

STDIN_JSON="$(cat)"
SENTINEL=".preflight/gate/bootstrap-write-approved"

PROTECTED_FILES="CLAUDE.md .preflight/config.json"

# ─── Extract file_path from stdin JSON ───────────────────────

FILE_PATH=""
if command -v jq &>/dev/null; then
  FILE_PATH=$(printf '%s' "$STDIN_JSON" | jq -r '.tool_input.file_path // empty' 2>/dev/null || echo "")
elif command -v node &>/dev/null; then
  FILE_PATH=$(printf '%s' "$STDIN_JSON" | node -e "let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{try{const j=JSON.parse(d);process.stdout.write((j.tool_input&&j.tool_input.file_path)||'')}catch(e){}})" 2>/dev/null || echo "")
else
  FILE_PATH=$(printf '%s' "$STDIN_JSON" | grep -o '"file_path"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 | sed 's/.*"file_path"[[:space:]]*:[[:space:]]*"//;s/"$//' || echo "")
fi

# If extraction yielded nothing (malformed JSON), FILE_PATH stays empty,
# is_protected returns nothing, and the gate passes through. See FAIL
# BEHAVIOR in the header comment for rationale.

# ─── Determine if target is protected ────────────────────────

# Normalize: extract just the basename or relative path for comparison
# Tool input uses absolute paths; we check if it ends with a protected name
is_protected() {
  local target="$1"
  for pf in $PROTECTED_FILES; do
    # Match: exact filename at end of path (with / or \ separator)
    if [ "$(basename "$target")" = "$(basename "$pf")" ]; then
      # For config.json, also verify it's under .preflight/
      if [ "$pf" = ".preflight/config.json" ]; then
        if echo "$target" | grep -qE '(^|[/\\])\.preflight[/\\]config\.json$'; then
          echo "$pf"
          return 0
        fi
      else
        echo "$pf"
        return 0
      fi
    fi
  done
  return 1
}

PROTECTED_NAME=""
PROTECTED_NAME=$(is_protected "$FILE_PATH") || true

# Not a protected file → allow immediately
if [ -z "$PROTECTED_NAME" ]; then
  exit 0
fi

# ─── Protected file — check if it already exists ─────────────

# Resolve the path relative to cwd for the existence check
# The file_path from tool input is absolute; check it directly
if [ ! -f "$FILE_PATH" ]; then
  # Also check relative form in case absolute path doesn't match
  RELATIVE_PATH="$PROTECTED_NAME"
  if [ ! -f "$RELATIVE_PATH" ]; then
    # File doesn't exist — this is creation, not clobber. Allow.
    exit 0
  fi
fi

# ─── File exists — require approval sentinel ─────────────────

if [ ! -f "$SENTINEL" ]; then
  cat >&2 <<EOF
BLOCKED: Refusing to overwrite existing $PROTECTED_NAME.
Overwriting this file requires explicit HUMAN lead approval.
(No approval sentinel present at $SENTINEL.)

Do NOT create the approval sentinel yourself — that would be self-approval.
Surface this block to a human lead; the human runs the approval step from
their own shell. See docs/parity-gate-limitations.md.
EOF
  exit 2
fi

# ─── Sentinel exists — validate freshness ────────────────────

CURRENT_HEAD=$(git rev-parse HEAD 2>/dev/null || echo "")
if [ -z "$CURRENT_HEAD" ]; then
  cat >&2 <<EOF
BLOCKED: Cannot verify approval sentinel — not in a git repository.
EOF
  exit 2
fi

# Parse sentinel
SENTINEL_HEAD=""
SENTINEL_FILES=""
if command -v jq &>/dev/null; then
  SENTINEL_HEAD=$(jq -r '.approvedAtHEAD // empty' "$SENTINEL" 2>/dev/null || echo "")
  SENTINEL_FILES=$(jq -r '.approvedFiles[]? // empty' "$SENTINEL" 2>/dev/null || echo "")
elif command -v node &>/dev/null; then
  SENTINEL_HEAD=$(node -e "const d=JSON.parse(require('fs').readFileSync(process.argv[1],'utf8'));process.stdout.write(d.approvedAtHEAD||'')" "$SENTINEL" 2>/dev/null || echo "")
  SENTINEL_FILES=$(node -e "const d=JSON.parse(require('fs').readFileSync(process.argv[1],'utf8'));(d.approvedFiles||[]).forEach(f=>console.log(f))" "$SENTINEL" 2>/dev/null || echo "")
else
  # Cannot parse sentinel — fail closed for protected files
  cat >&2 <<EOF
BLOCKED: Cannot parse approval sentinel (no jq or node available).
Failing closed for protected file $PROTECTED_NAME.
EOF
  exit 2
fi

# Validate HEAD freshness
if [ -z "$SENTINEL_HEAD" ]; then
  cat >&2 <<EOF
BLOCKED: Approval sentinel is malformed (no approvedAtHEAD field).
EOF
  exit 2
fi

if [ "$SENTINEL_HEAD" != "$CURRENT_HEAD" ]; then
  cat >&2 <<EOF
BLOCKED: Approval sentinel is stale (HEAD moved since approval).
Sentinel HEAD: $SENTINEL_HEAD
Current HEAD:  $CURRENT_HEAD
Re-confirm with the lead before overwriting $PROTECTED_NAME.
EOF
  exit 2
fi

# Validate file coverage
if [ -n "$SENTINEL_FILES" ]; then
  if ! echo "$SENTINEL_FILES" | grep -qF "$PROTECTED_NAME"; then
    cat >&2 <<EOF
BLOCKED: Approval sentinel does not cover $PROTECTED_NAME.
Approved files: $(echo "$SENTINEL_FILES" | tr '\n' ' ')
EOF
    exit 2
  fi
fi

# All checks pass — allow the write
exit 0
