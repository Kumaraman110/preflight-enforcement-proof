#!/usr/bin/env bash
# PreToolUse hook for Write and Edit. Blocks overwrites of an existing
# CLAUDE.md or .preflight/config.json unless an approval sentinel is
# present and fresh (HEAD-stamped).
#
# New-file creation always passes. Unrelated files always pass.
# Fails closed (blocks) ONLY for the two protected files on hook error.
#
# Inputs:
#   $1 — serialized tool parameters JSON (file_path field)
#
# Exit 0 = allow
# Exit 1 = block (reason on stderr)

set -uo pipefail

TOOL_INPUT="${1:-}"
SENTINEL=".preflight/gate/bootstrap-write-approved"

PROTECTED_FILES="CLAUDE.md .preflight/config.json"

# ─── Extract file_path from tool input ───────────────────────

FILE_PATH=""
if command -v jq &>/dev/null; then
  FILE_PATH=$(echo "$TOOL_INPUT" | jq -r '.file_path // empty' 2>/dev/null || echo "")
elif command -v node &>/dev/null; then
  FILE_PATH=$(echo "$TOOL_INPUT" | node -e "let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{try{process.stdout.write(JSON.parse(d).file_path||'')}catch(e){}})" 2>/dev/null || echo "")
else
  FILE_PATH=$(echo "$TOOL_INPUT" | grep -o '"file_path"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 | sed 's/.*"file_path"[[:space:]]*:[[:space:]]*"//;s/"$//' || echo "")
fi

# If we couldn't parse input at all, use raw input as fallback
if [ -z "$FILE_PATH" ]; then
  FILE_PATH="$TOOL_INPUT"
fi

# ─── Determine if target is protected ────────────────────────

# Normalize: extract just the basename or relative path for comparison
# Tool input uses absolute paths; we check if it ends with a protected name
is_protected() {
  local target="$1"
  for pf in $PROTECTED_FILES; do
    # Match: exact filename at end of path (with / or \ separator)
    if [ "$(basename "$target")" = "$(basename "$pf")" ]; then
      # For config.json, also verify it's under .preflight/
      if [ "$pf" = ".preflight/config.json" ]; then
        if echo "$target" | grep -qE '(^|[/\\])\.preflight[/\\]config\.json$'; then
          echo "$pf"
          return 0
        fi
      else
        echo "$pf"
        return 0
      fi
    fi
  done
  return 1
}

PROTECTED_NAME=""
PROTECTED_NAME=$(is_protected "$FILE_PATH") || true

# Not a protected file → allow immediately
if [ -z "$PROTECTED_NAME" ]; then
  exit 0
fi

# ─── Protected file — check if it already exists ─────────────

# Resolve the path relative to cwd for the existence check
# The file_path from tool input is absolute; check it directly
if [ ! -f "$FILE_PATH" ]; then
  # Also check relative form in case absolute path doesn't match
  RELATIVE_PATH="$PROTECTED_NAME"
  if [ ! -f "$RELATIVE_PATH" ]; then
    # File doesn't exist — this is creation, not clobber. Allow.
    exit 0
  fi
fi

# ─── File exists — require approval sentinel ─────────────────

if [ ! -f "$SENTINEL" ]; then
  cat >&2 <<EOF
BLOCKED: Refusing to overwrite existing $PROTECTED_NAME.
Bootstrap must obtain explicit lead approval first.
(No approval sentinel present at $SENTINEL.)

To proceed: obtain lead approval, then write the sentinel:
  mkdir -p .preflight/gate
  echo '{"approvedAtHEAD":"$(git rev-parse HEAD 2>/dev/null || echo UNKNOWN)","approvedFiles":["CLAUDE.md",".preflight/config.json"],"approvedAt":"'"\$(date -u +%Y-%m-%dT%H:%M:%SZ)"'"}' > $SENTINEL
EOF
  exit 1
fi

# ─── Sentinel exists — validate freshness ────────────────────

CURRENT_HEAD=$(git rev-parse HEAD 2>/dev/null || echo "")
if [ -z "$CURRENT_HEAD" ]; then
  cat >&2 <<EOF
BLOCKED: Cannot verify approval sentinel — not in a git repository.
EOF
  exit 1
fi

# Parse sentinel
SENTINEL_HEAD=""
SENTINEL_FILES=""
if command -v jq &>/dev/null; then
  SENTINEL_HEAD=$(jq -r '.approvedAtHEAD // empty' "$SENTINEL" 2>/dev/null || echo "")
  SENTINEL_FILES=$(jq -r '.approvedFiles[]? // empty' "$SENTINEL" 2>/dev/null || echo "")
elif command -v node &>/dev/null; then
  SENTINEL_HEAD=$(node -e "const d=JSON.parse(require('fs').readFileSync(process.argv[1],'utf8'));process.stdout.write(d.approvedAtHEAD||'')" "$SENTINEL" 2>/dev/null || echo "")
  SENTINEL_FILES=$(node -e "const d=JSON.parse(require('fs').readFileSync(process.argv[1],'utf8'));(d.approvedFiles||[]).forEach(f=>console.log(f))" "$SENTINEL" 2>/dev/null || echo "")
else
  # Cannot parse sentinel — fail closed for protected files
  cat >&2 <<EOF
BLOCKED: Cannot parse approval sentinel (no jq or node available).
Failing closed for protected file $PROTECTED_NAME.
EOF
  exit 1
fi

# Validate HEAD freshness
if [ -z "$SENTINEL_HEAD" ]; then
  cat >&2 <<EOF
BLOCKED: Approval sentinel is malformed (no approvedAtHEAD field).
EOF
  exit 1
fi

if [ "$SENTINEL_HEAD" != "$CURRENT_HEAD" ]; then
  cat >&2 <<EOF
BLOCKED: Approval sentinel is stale (HEAD moved since approval).
Sentinel HEAD: $SENTINEL_HEAD
Current HEAD:  $CURRENT_HEAD
Re-confirm with the lead before overwriting $PROTECTED_NAME.
EOF
  exit 1
fi

# Validate file coverage
if [ -n "$SENTINEL_FILES" ]; then
  if ! echo "$SENTINEL_FILES" | grep -qF "$PROTECTED_NAME"; then
    cat >&2 <<EOF
BLOCKED: Approval sentinel does not cover $PROTECTED_NAME.
Approved files: $(echo "$SENTINEL_FILES" | tr '\n' ' ')
EOF
    exit 1
  fi
fi

# All checks pass — allow the write
exit 0
