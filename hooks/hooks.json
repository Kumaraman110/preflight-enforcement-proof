{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-hook.cmd\" session-start",
            "timeout": 5000,
            "async": false
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-hook.cmd\" drift-detector",
            "timeout": 10000,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-hook.cmd\" pre-push-gate-check \"$TOOL_INPUT\"",
            "timeout": 10000,
            "async": false
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-hook.cmd\" bootstrap-write-gate \"$TOOL_INPUT\"",
            "timeout": 5000,
            "async": false
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-hook.cmd\" adjudication-output-gate \"$TOOL_INPUT\"",
            "timeout": 5000,
            "async": false
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-hook.cmd\" coupled-edit-gate \"$TOOL_INPUT\"",
            "timeout": 5000,
            "async": false
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-hook.cmd\" bootstrap-write-gate \"$TOOL_INPUT\"",
            "timeout": 5000,
            "async": false
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-hook.cmd\" adjudication-output-gate \"$TOOL_INPUT\"",
            "timeout": 5000,
            "async": false
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-hook.cmd\" rubric-validity-gate \"$TOOL_INPUT\"",
            "timeout": 5000,
            "async": false
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-hook.cmd\" behavioral-contract-gate \"$TOOL_INPUT\"",
            "timeout": 5000,
            "async": false
          }
        ]
      }
    ]
  }
}
