#!/usr/bin/env bash
# Hybrid HEAD-stamp validation for dependency-map.json freshness.
#
# Reads .preflight/gate/dependency-map-validated sidecar and determines
# whether the map is still fresh relative to current HEAD.
#
# Exit 0 = map is fresh (or was re-stamped because no map-files changed)
# Exit 1 = map is stale, refresh needed
#
# Three-step logic:
#   1. If validAtHEAD matches current HEAD → fresh, exit 0
#   2. If HEAD moved, check git diff for overlap with map files
#      - Overlap found → stale, exit 1
#      - Git diff fails → stale (be safe), exit 1
#   3. No overlap → re-stamp sidecar with current HEAD, exit 0
#
# Dependencies: bash, git, node (for JSON parsing — available in all
# environments where Claude Code runs)

set -euo pipefail

SIDECAR="${1:-.preflight/gate/dependency-map-validated}"

# Guard: sidecar must exist
if [ ! -f "$SIDECAR" ]; then
  echo "STALE: sidecar file not found at $SIDECAR. Refresh needed."
  exit 1
fi

# Parse sidecar using node (portable across all Claude Code environments)
SIDECAR_HEAD=$(node -e "const d=JSON.parse(require('fs').readFileSync(process.argv[1],'utf8')); process.stdout.write(d.validAtHEAD||'')" "$SIDECAR" 2>/dev/null) || {
  echo "STALE: could not parse sidecar. Refresh needed."
  exit 1
}

if [ -z "$SIDECAR_HEAD" ]; then
  echo "STALE: validAtHEAD field empty or missing. Refresh needed."
  exit 1
fi

CURRENT_HEAD=$(git rev-parse HEAD 2>/dev/null) || {
  echo "STALE: not in a git repository. Refresh needed."
  exit 1
}

# Step 1: Quick check — has HEAD moved?
if [ "$SIDECAR_HEAD" = "$CURRENT_HEAD" ]; then
  echo "FRESH: HEAD matches sidecar. Map is current."
  exit 0
fi

# Step 2: Targeted check — did intervening commits touch any map files?
MAP_FILES=$(node -e "const d=JSON.parse(require('fs').readFileSync(process.argv[1],'utf8')); (d.mapFiles||[]).forEach(f=>console.log(f))" "$SIDECAR" 2>/dev/null) || {
  echo "STALE: could not parse mapFiles from sidecar. Refresh needed."
  exit 1
}

# (M3) NON-VALIDATABLE empty/missing mapFiles → STALE, do NOT re-stamp. A sidecar that declares NO mapFiles
# gives the comm -12 overlap check nothing to test, so it always found "no overlap" and fell through to
# Step 3 — declaring FRESH (exit 0) AND re-stamping validAtHEAD to the current HEAD. That re-stamp made the
# staleness PERMANENT: every subsequent HEAD move on an empty-mapFiles sidecar re-stamped to fresh, silently
# neutering the gate. An empty/missing mapFiles list cannot establish freshness — so it is STALE (refresh
# needed), the fail-closed direction, and we exit BEFORE the re-stamp so the bad sidecar is not laundered.
if ! printf '%s' "$MAP_FILES" | grep -q '[^[:space:]]'; then
  echo "STALE: sidecar declares no mapFiles — cannot validate freshness against an empty file set. Refresh needed."
  echo "  (A dependency-map sidecar with no mapFiles cannot prove the map is current; failing closed rather"
  echo "  than re-stamping it FRESH. Regenerate the dependency map + sidecar.)"
  exit 1
fi

# Non-fatal cross-check: compare sidecar mapFiles count against actual map file
MAP_PATH=$(node -e "const d=JSON.parse(require('fs').readFileSync(process.argv[1],'utf8')); process.stdout.write(d.mapPath||'')" "$SIDECAR" 2>/dev/null || true)
if [ -n "$MAP_PATH" ] && [ -f "$MAP_PATH" ]; then
  MAP_FILE_COUNT=$(node -e "const d=JSON.parse(require('fs').readFileSync(process.argv[1],'utf8')); process.stdout.write(String((d.files||[]).length))" "$MAP_PATH" 2>/dev/null || echo "")
  SIDECAR_FILE_COUNT=$(echo "$MAP_FILES" | grep -c . 2>/dev/null || echo "0")
  if [ -n "$MAP_FILE_COUNT" ] && [ "$MAP_FILE_COUNT" != "$SIDECAR_FILE_COUNT" ]; then
    echo "WARNING: sidecar mapFiles count ($SIDECAR_FILE_COUNT) differs from dependency-map files count ($MAP_FILE_COUNT) — sidecar may be stale" >&2
  fi
fi

CHANGED_FILES=$(git diff --name-only "$SIDECAR_HEAD..HEAD" 2>/dev/null) || {
  echo "STALE: git diff failed between $SIDECAR_HEAD and $CURRENT_HEAD. Refresh needed."
  exit 1
}

# Check for overlap between changed files and map files
OVERLAP=$(comm -12 <(echo "$CHANGED_FILES" | sort) <(echo "$MAP_FILES" | sort) 2>/dev/null || echo "")

if [ -n "$OVERLAP" ]; then
  echo "STALE: intervening commits touched map files: $OVERLAP. Refresh needed."
  exit 1
fi

# Step 3: No overlap — map files were untouched. Re-stamp sidecar with current HEAD.
node -e "
const fs = require('fs');
const p = process.argv[1];
const h = process.argv[2];
const d = JSON.parse(fs.readFileSync(p, 'utf8'));
d.validAtHEAD = h;
d.generatedAt = new Date().toISOString();
fs.writeFileSync(p, JSON.stringify(d, null, 2) + '\n');
" "$SIDECAR" "$CURRENT_HEAD"

echo "FRESH: HEAD moved but map files untouched. Sidecar re-stamped."
exit 0
