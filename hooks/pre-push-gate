#!/usr/bin/env bash
# Mechanical pre-push gate. Checks that Stage 1 and tests have passed
# before allowing a push. This cannot be bypassed by prompt manipulation.
#
# Exit 0 = allow push
# Exit 2 = block push (outputs reason to stderr; Claude Code blocks on exit 2)
#
# Evidence files written by the review loop:
#   .preflight/gate/stage1-clean   — written when Stage 1 returns CLEAN
#   .preflight/gate/tests-pass     — written when dotnet test returns 0
#   .preflight/gate/map-validated  — written when dependency-map validation passes
#
# Each evidence file contains a timestamp and the git HEAD at time of check.
# If HEAD has moved since the evidence was written, the evidence is STALE.
#
# Accept evidence referencing HEAD OR HEAD^ (immediate parent).
# The intended workflow is:
#   1. Stage 1 returns CLEAN
#   2. write-gate-evidence stage1-clean (HEAD at this moment)
#   3. git commit (HEAD moves to new SHA; old HEAD becomes parent)
#   4. git push
# At step 4, evidence references step-2 HEAD, which is now HEAD^.
# Accepting parent covers this case without weakening the gate's
# core invariant: evidence must be tied to the code being pushed.

set -euo pipefail

GATE_DIR=".preflight/gate"
CURRENT_HEAD=$(git rev-parse HEAD 2>/dev/null || echo "unknown")
PARENT_HEAD=$(git rev-parse HEAD^ 2>/dev/null || echo "")

check_evidence() {
  local file="$1"
  local label="$2"

  if [ ! -f "$GATE_DIR/$file" ]; then
    echo "BLOCKED: $label has not run. Run /preflight:fix-and-close or /preflight:self-review first." >&2
    exit 2
  fi

  local evidence_head
  # Read the HEAD the evidence was stamped at. GUARD the substitution: a present-but-corrupt
  # evidence file (it exists, so it passed the -f check above, but carries no "HEAD=" line —
  # truncated, externally edited, or an older/foreign format) makes `grep` exit non-zero, which
  # under `set -euo pipefail` would ABORT the hook with exit 1 — and exit 1 is NON-blocking to
  # Claude Code, a fail-OPEN that lets the push through on unverifiable evidence. Capture WITHOUT
  # aborting (|| true), then fail CLOSED on an empty result: if we cannot read which commit the
  # evidence covers, we cannot prove it covers the pushed code, so we must BLOCK. (Same
  # fail-direction discipline as the git-diff guard below and the sibling dependency-map-validator.
  # write-gate-evidence always writes HEAD=<sha-or-"unknown">, so a legitimate file is never empty
  # here — this only fires on a corrupt/foreign file, never on a valid stamp.)
  evidence_head=$(grep "^HEAD=" "$GATE_DIR/$file" 2>/dev/null | cut -d= -f2 || true)
  if [ -z "$evidence_head" ]; then
    echo "BLOCKED: $label evidence file exists but carries no HEAD= line (corrupt/truncated/foreign format)." >&2
    echo "  Cannot verify the evidence is tied to the pushed code — failing closed. Re-run the gate at HEAD." >&2
    exit 2
  fi

  if [ "$evidence_head" = "$CURRENT_HEAD" ]; then
    return 0   # evidence is for exactly the code being pushed — valid.
  fi

  if [ "$evidence_head" != "$PARENT_HEAD" ]; then
    echo "BLOCKED: $label evidence is stale (was at $evidence_head, now at $CURRENT_HEAD). Code changed since last check — re-run Stage 1." >&2
    exit 2
  fi

  # ── evidence == HEAD^ : the legitimate stamp→commit→push window. But content-aware
  # (RED-3 / the #6a content-aware staleness): the one-commit tolerance is ONLY safe if that
  # commit introduced no UNREVIEWED code. Stage 1 reviews the ENTIRE diff, so "reviewed" = the
  # whole changed set; the only files that legitimately churn between stamp and push are the
  # gate-evidence files themselves (write-gate-evidence writes ONLY under .preflight/gate/).
  # If the HEAD^→HEAD commit touched ANYTHING outside .preflight/gate/, that change was never
  # Stage-1-reviewed/tested at the pushed tree → the evidence does not cover it → BLOCK.
  # FAIL CLOSED on any git-diff error: if we cannot compute what changed (unreachable
  # evidence_head in a shallow clone, corrupt/missing ref, etc.), we cannot prove the commit
  # introduced no unreviewed code — so we must BLOCK, not let the push through. (Without this,
  # `set -e` would abort the hook with exit 128 on the failing substitution, and exit 128 is
  # NON-blocking to Claude Code — a fail-OPEN that defeats this gate's invariant. The sibling
  # dependency-map-validator fails closed on the same error class; match that posture.)
  local changed non_evidence
  if ! changed=$(git diff --name-only "$evidence_head" HEAD 2>/dev/null); then
    echo "BLOCKED: $label evidence is at HEAD^ ($evidence_head) but the diff to HEAD could not be computed" >&2
    echo "  (unreachable ref / shallow clone / corrupt object). Cannot verify the commit introduced no" >&2
    echo "  unreviewed code — failing closed. Re-run the gate at HEAD." >&2
    exit 2
  fi
  non_evidence=$(printf '%s\n' "$changed" | grep -vE '^\.preflight/gate/' | grep -v '^$' || true)
  if [ -n "$non_evidence" ]; then
    echo "BLOCKED: $label evidence is at HEAD^ ($evidence_head) but the commit since then changed unreviewed files:" >&2
    printf '  %s\n' $non_evidence >&2
    echo "  That code was never Stage-1-reviewed/tested at the pushed tree. Re-run the gate at HEAD." >&2
    exit 2
  fi
}

# Gate 1: Tests must pass
check_evidence "tests-pass" "Test suite"

# Gate 2: Stage 1 must be clean
check_evidence "stage1-clean" "Stage 1 review"

# Gate 3: Dependency map validation (if a map exists)
# Depth note: -maxdepth 3 matches the layout .preflight/<Service>/dependency-map.json (depth 3).
# A map nested deeper would be silently skipped — keep this depth in sync with that layout.
if [ -f "dependency-map.json" ] || find . -maxdepth 3 -name "dependency-map.json" 2>/dev/null | grep -q .; then
  check_evidence "map-validated" "Dependency map validation"
fi

# Gate 4: Parity check (if a behavior-spec baseline exists for the service)
BASELINE_FOUND=""
if find . -maxdepth 3 -path "*/.preflight/*/behavior-spec.json" 2>/dev/null | grep -q .; then
  BASELINE_FOUND="true"
fi
if [ -n "$BASELINE_FOUND" ]; then
  check_evidence "parity-clean" "Behavior parity check"
fi

# All gates pass
exit 0
