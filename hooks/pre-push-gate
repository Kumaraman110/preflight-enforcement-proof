#!/usr/bin/env bash
# Mechanical pre-push gate. Checks that Stage 1 and tests have passed
# before allowing a push. This cannot be bypassed by prompt manipulation.
#
# Exit 0 = allow push
# Exit 1 = block push (outputs reason to stderr)
#
# Evidence files written by the review loop:
#   .preflight/gate/stage1-clean   — written when Stage 1 returns CLEAN
#   .preflight/gate/tests-pass     — written when dotnet test returns 0
#   .preflight/gate/map-validated  — written when dependency-map validation passes
#
# Each evidence file contains a timestamp and the git HEAD at time of check.
# If HEAD has moved since the evidence was written, the evidence is STALE.
#
# Accept evidence referencing HEAD OR HEAD^ (immediate parent).
# The intended workflow is:
#   1. Stage 1 returns CLEAN
#   2. write-gate-evidence stage1-clean (HEAD at this moment)
#   3. git commit (HEAD moves to new SHA; old HEAD becomes parent)
#   4. git push
# At step 4, evidence references step-2 HEAD, which is now HEAD^.
# Accepting parent covers this case without weakening the gate's
# core invariant: evidence must be tied to the code being pushed.

set -euo pipefail

GATE_DIR=".preflight/gate"
CURRENT_HEAD=$(git rev-parse HEAD 2>/dev/null || echo "unknown")
PARENT_HEAD=$(git rev-parse HEAD^ 2>/dev/null || echo "")

check_evidence() {
  local file="$1"
  local label="$2"

  if [ ! -f "$GATE_DIR/$file" ]; then
    echo "BLOCKED: $label has not run. Run /preflight:fix-and-close or /preflight:self-review first." >&2
    exit 1
  fi

  local evidence_head
  evidence_head=$(grep "^HEAD=" "$GATE_DIR/$file" 2>/dev/null | cut -d= -f2)

  if [ "$evidence_head" != "$CURRENT_HEAD" ] && [ "$evidence_head" != "$PARENT_HEAD" ]; then
    echo "BLOCKED: $label evidence is stale (was at $evidence_head, now at $CURRENT_HEAD). Code changed since last check — re-run Stage 1." >&2
    exit 1
  fi
}

# Gate 1: Tests must pass
check_evidence "tests-pass" "Test suite"

# Gate 2: Stage 1 must be clean
check_evidence "stage1-clean" "Stage 1 review"

# Gate 3: Dependency map validation (if a map exists)
if [ -f "dependency-map.json" ] || find . -name "dependency-map.json" -maxdepth 2 2>/dev/null | grep -q .; then
  check_evidence "map-validated" "Dependency map validation"
fi

# All gates pass
exit 0
