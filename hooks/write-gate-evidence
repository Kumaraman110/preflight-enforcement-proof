#!/usr/bin/env bash
# Write evidence that a gate has passed. Called by the review loop
# after tests pass, Stage 1 returns CLEAN, or map validation passes.
#
# Usage: write-gate-evidence <gate-name>
#   gate-name: tests-pass | stage1-clean | map-validated | parity-clean
#
# NOTE: parity-clean is HUMAN-ONLY by convention (see skills/migrate/SKILL.md /
# docs/parity-gate-limitations.md). This script enforces NO actor check — the
# restriction is prompt-level, not mechanical.
#
# Writes a file to .preflight/gate/<gate-name> with:
#   - Current timestamp
#   - Current HEAD commit
#   - The gate that passed
#

# --- Heartbeat (passive liveness self-evidencing) ---
_hb_self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_hb_plugin_root="$(cd "$_hb_self_dir/.." && pwd)"
[ -f "$_hb_plugin_root/lib/heartbeat.sh" ] && source "$_hb_plugin_root/lib/heartbeat.sh"
# Fail-SAFE: undefined function under `set -e` would exit 127 before gate logic
# (a blocking gate would fail OPEN). No-op fallback so heartbeat can't crash the gate.
type _write_heartbeat &>/dev/null || _write_heartbeat() { :; }
_write_heartbeat "write-gate-evidence"

# The pre-push-gate hook reads these files to verify freshness.

set -euo pipefail

GATE_NAME="${1:-}"
# Session-root scoping (NEW-3 / gap #28): anchor the evidence dir at the REPO
# ROOT, never the caller's cwd. A cwd-relative path stranded evidence under
# <subdir>/.preflight/gate/ when invoked from a subdirectory — where the
# pre-push gate (also now root-anchored) never looks → false block. Outside a
# git repo, fall back to pwd (previous behavior, unchanged).
REPO_TOP="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
GATE_DIR="$REPO_TOP/.preflight/gate"

if [ -z "$GATE_NAME" ]; then
  echo "Usage: write-gate-evidence <gate-name>" >&2
  exit 1
fi

case "$GATE_NAME" in
  tests-pass|stage1-clean|map-validated|parity-clean)
    ;;
  *)
    echo "Unknown gate: $GATE_NAME. Expected: tests-pass|stage1-clean|map-validated|parity-clean" >&2
    exit 1
    ;;
esac

mkdir -p "$GATE_DIR"

CURRENT_HEAD=$(git rev-parse HEAD 2>/dev/null || echo "unknown")
TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || date +"%Y-%m-%dT%H:%M:%S")

cat > "$GATE_DIR/$GATE_NAME" <<EOF
GATE=$GATE_NAME
HEAD=$CURRENT_HEAD
TIMESTAMP=$TIMESTAMP
EOF
